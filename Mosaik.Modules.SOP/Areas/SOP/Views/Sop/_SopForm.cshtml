@model SopFormViewModel
@{
    var categories = ViewData["Categories"] as List<Mosaik.Modules.SOP.Areas.SOP.Controllers.SelectListItemDto> ?? new();
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert error" role="alert">
        <ul style="margin:0; padding-left:18px;">
        @foreach (var err in ViewData.ModelState.SelectMany(m => m.Value!.Errors).Select(e => e.ErrorMessage))
        {
            <li>@err</li>
        }
        </ul>
    </div>
}

<div class="form-section-card wide">
    <div class="form-section-head">
        <h2 class="form-section-head__title">Prosedür Bilgileri</h2>
    </div>
    <div class="form-section-body">
        <input type="hidden" name="FirmaId" value="@Model.FirmaId" />

        <div class="field">
            <label class="lab" for="Title">Başlık <span class="req">*</span></label>
            <input type="text" id="Title" name="Title" value="@Model.Title" class="inp" maxlength="200" required />
        </div>

        <div class="field">
            <label class="lab" for="Description">Açıklama</label>
            <textarea id="Description" name="Description" class="inp" rows="3">@Model.Description</textarea>
        </div>

        <div class="form-row-2col">
            <div class="field">
                <label class="lab" for="Category">Kategori</label>
                <select id="Category" name="Category" class="inp">
                    <option value="">— Seçin —</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Code" selected="@(Model.Category == c.Code)">@c.Label</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="lab" for="OwnerUserId">Sahip Kullanıcı (ID) <span class="req">*</span></label>
                <input type="number" id="OwnerUserId" name="OwnerUserId" value="@Model.OwnerUserId" class="inp" min="1" required />
            </div>
        </div>

        <div class="field">
            <div class="tamim-urgent-toggle">
                <input type="checkbox" id="IsCompanyWide" name="IsCompanyWide" value="true"
                       @(Model.IsCompanyWide ? "checked" : "") class="checkbox" />
                <label for="IsCompanyWide" class="lab">Şirket Geneli (tüm departmanlar)</label>
            </div>
        </div>

        <div class="field">
            <label class="lab" for="DepartmentIds">Departman ID'leri (CSV)</label>
            <input type="text" id="DepartmentIds" name="DepartmentIds" value="@Model.DepartmentIds" class="inp" maxlength="500" placeholder="örn: 1,4,12" />
            <p class="help-text">Şirket Geneli işaretliyse bu alan yok sayılır. Plan 18B HR sync sonrası multi-select gelir.</p>
        </div>

        <div class="form-row-2col">
            <div class="field">
                <label class="lab" for="ReadDeadlineDays">Okuma Süresi (gün)</label>
                <input type="number" id="ReadDeadlineDays" name="ReadDeadlineDays" value="@Model.ReadDeadlineDays" class="inp" min="1" max="365" />
            </div>
            <div class="field">
                <div class="tamim-urgent-toggle" style="margin-top:24px;">
                    <input type="checkbox" id="RequiresIKApproval" name="RequiresIKApproval" value="true"
                           @(Model.RequiresIKApproval ? "checked" : "") class="checkbox" />
                    <label for="RequiresIKApproval" class="lab">İK onayı zorunlu (3-adımlı onay)</label>
                </div>
            </div>
        </div>

        <div class="field mb-0">
            <div class="tamim-urgent-toggle">
                <input type="checkbox" id="AiAdvisorEnabled" name="AiAdvisorEnabled" value="true"
                       @(Model.AiAdvisorEnabled ? "checked" : "") class="checkbox" />
                <label for="AiAdvisorEnabled" class="lab">AI Danışman drawer'ı aktif (Plan 34 Faz F)</label>
            </div>
        </div>
    </div>
</div>

<!-- Plan 34.1: PRD kurumsal başlık alanları -->
<div class="form-section-card wide">
    <div class="form-section-head">
        <h2 class="form-section-head__title">Doküman Künyesi (Kurumsal Başlık)</h2>
        <p class="form-section-head__sub">PRD template uyumlu — print + detay sayfasında üst tabloda görünür.</p>
    </div>
    <div class="form-section-body">
        <div class="form-row-2col">
            <div class="field">
                <label class="lab" for="DocumentNumber">Doküman No</label>
                <input type="text" id="DocumentNumber" name="DocumentNumber" value="@Model.DocumentNumber" class="inp" maxlength="50" placeholder="örn. PRD-CRM-001" />
            </div>
            <div class="field">
                <label class="lab" for="RevisionNumber">Versiyon / Revizyon</label>
                <input type="text" id="RevisionNumber" name="RevisionNumber" value="@Model.RevisionNumber" class="inp" maxlength="50" placeholder="örn. v1.0 veya Rev.0" />
            </div>
        </div>

        <div class="form-row-2col">
            <div class="field">
                <label class="lab" for="PublishDate">Yayın Tarihi</label>
                <input type="date" id="PublishDate" name="PublishDate"
                       value="@(Model.PublishDate?.ToString("yyyy-MM-dd"))" class="inp" />
            </div>
            <div class="field">
                <label class="lab" for="EffectiveDate">Yürürlük Tarihi</label>
                <input type="date" id="EffectiveDate" name="EffectiveDate"
                       value="@(Model.EffectiveDate?.ToString("yyyy-MM-dd"))" class="inp" />
            </div>
        </div>

        <div class="field">
            <label class="lab" for="RevisionDate">Son Revizyon Tarihi</label>
            <input type="date" id="RevisionDate" name="RevisionDate"
                   value="@(Model.RevisionDate?.ToString("yyyy-MM-dd"))" class="inp" />
        </div>

        <div class="form-row-2col">
            <div class="field">
                <label class="lab" for="PreparedBy">Hazırlayan</label>
                <input type="text" id="PreparedBy" name="PreparedBy" value="@Model.PreparedBy" class="inp" maxlength="200" placeholder="örn. KVKK Uyum Sorumlusu (DPO)" />
            </div>
            <div class="field">
                <label class="lab" for="ApprovedBy">Onaylayan</label>
                <input type="text" id="ApprovedBy" name="ApprovedBy" value="@Model.ApprovedBy" class="inp" maxlength="200" placeholder="örn. Genel Müdür" />
            </div>
        </div>

        <div class="form-row-2col">
            <div class="field">
                <label class="lab" for="ReviewFrequency">Gözden Geçirme Sıklığı</label>
                <input type="text" id="ReviewFrequency" name="ReviewFrequency" value="@Model.ReviewFrequency" class="inp" maxlength="100" placeholder="örn. Yıllık (Mart)" />
            </div>
            <div class="field">
                <label class="lab" for="Classification">Sınıflandırma</label>
                <input type="text" id="Classification" name="Classification" value="@Model.Classification" class="inp" maxlength="100" placeholder="örn. Şirket İçi - Kontrollü Dağıtım" />
            </div>
        </div>
    </div>
</div>
