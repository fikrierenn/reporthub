@*
    Auth layout — sidebar'sız, ortalanmış paper card.
    Login + AccessDenied (anonymous) için. _AppLayout sidebar/topbar shell'inden ayrı tutuldu (M-13 Plan 03 Faz E).
*@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&family=JetBrains+Mono:wght@@400;500&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/assets/css/tokens.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/components.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/utilities.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/app-shell.css" rel="stylesheet" asp-append-version="true">

    @* M-13 Plan 04 Faz 1: Alpine.js CDN (parola show/hide gibi minimal client state icin) *@
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@@3.x.x/dist/cdn.min.js"></script>

    @RenderSection("Head", required: false)
</head>
<body class="auth-shell">

    <div class="auth-shell__container">

        @* Brand logo + project name. M-13 UI fix (28 Nisan): Logo daha kompakt (36px), margin'ler
           tighter, h1 + subtitle daha sıkı dikey ritm. *@
        <div class="auth-shell__brand">
            <img src="~/assets/img/logo.png" alt="BKM Kitap" class="auth-shell__logo" />
            <h1 class="auth-shell__title">Rapor Paneli</h1>
            <div class="auth-shell__subtitle">Güvenli rapor erişimi</div>
        </div>

        @* Content paper card *@
        <div class="auth-shell__card">
            @RenderBody()
        </div>

        @* Footer *@
        <div class="auth-shell__footer">
            BKM Kitap · Rapor Paneli · Güvenli giriş
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
