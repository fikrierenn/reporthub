@model ErrorViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Hata - BKM Rapor Paneli";
}

<div class="state-card">
    <div class="state-card__icon danger">
        <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
    </div>
    <h1>Bir hata oluştu</h1>
    <p>İsteğiniz işlenirken beklenmedik bir sorun yaşandı.</p>

    @if (Model.ShowRequestId)
    {
        <div class="state-meta">
            <strong>İstek ID:</strong>
            <code class="mono">@Model.RequestId</code>
        </div>
    }

    <a href="/Dashboard" class="btn primary">
        <i class="fas fa-house text-[10px]" aria-hidden="true"></i>
        Genel Bakış
    </a>
</div>
