@using System.Security.Claims
@inject Mosaik.Services.IBrandService BrandService
@inject Mosaik.Services.IModuleService ModuleService
@inject Mosaik.Modules.Circular.Services.CircularService CircularService
@{
    var brand = await BrandService.GetAsync();
    var enabledModules = await ModuleService.GetEnabledAsync();
    Mosaik.Modules.Circular.Models.Circular? todaysCircular = null;
    try { todaysCircular = await CircularService.GetTodaysAsync(); } catch { /* modül kapalı */ }
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var userName = isAuthenticated ? User?.Identity?.Name ?? "" : "";
    var fullName = isAuthenticated
        ? User?.Claims?.FirstOrDefault(claim => claim.Type == "full_name")?.Value ?? ""
        : "";
    var userRoles = isAuthenticated
        ? User?.Claims?
            .Where(claim => claim.Type == ClaimTypes.Role)
            .Select(claim => claim.Value)
            .Distinct()
            .ToArray() ?? Array.Empty<string>()
        : Array.Empty<string>();
    var isAdminUser = userRoles.Any(role => role.Equals("admin", StringComparison.OrdinalIgnoreCase));
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool IsActive(params string[] controllers) => controllers.Any(c => controller.Equals(c, StringComparison.OrdinalIgnoreCase));
    string AvatarInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(new[] { ' ', '.', '_' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpperInvariant();
    }
    var avatar = AvatarInitials(string.IsNullOrWhiteSpace(fullName) ? userName : fullName);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>@ViewData["Title"] — @brand.SiteTitle</title>

    @* M-13 Plan 03 Faz A: Inter+JetBrains Mono proje-wide font + Tailwind CDN + Font Awesome + style.css + app-shell.css *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&family=JetBrains+Mono:wght@@400;500&display=swap" rel="stylesheet">
    @* Tailwind Play CDN local serve (4 Mayıs 2026, P1 production performance + offline). Font Awesome CDN bırakıldı (webfonts ayrı iş). *@
    <script src="~/lib/tailwindcss/tailwindcss.js" asp-append-version="true"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    @* M-13 R2 (28 Nisan): style.css 744 sat, 4 modüler dosyaya bölündü.
       Yükleme sırası ZORUNLU: tokens (variables) → components (cascade ihtiyacı yok ama tutarlılık) →
       legacy (sadece kullanılan 4 sınıf) → utilities (media query override'ları). *@
    <link href="~/assets/css/tokens.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/components.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/legacy.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/utilities.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/app-shell.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/components-tamim.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/org-chart.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/notifications.css" rel="stylesheet" asp-append-version="true">

    @* M-13 Plan 04 (28 Nisan 2026): Alpine.js + htmx CDN-only entegrasyon. Build step yok.
       Alpine = client state (toggle/modal/form), htmx = server-driven swap (SP preview, list refresh).
       Skill: .claude/skills/alpine-js/ + .claude/skills/htmx-expert/. *@
    <script defer src="~/lib/alpinejs/alpine.min.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@@2.0.4/dist/htmx.min.js"></script>

    @RenderSection("Head", required: false)
</head>
<body class="@(ViewData["BodyClass"] as string ?? "")">

@* A11y: klavye kullanıcıları için sidebar'ı atla, doğrudan içeriğe geç. *@
<a href="#mainContent" class="skip-link">İçeriğe atla</a>

<div class="app-shell" id="appShell">

    @* ============ SIDEBAR ============ *@
    <aside class="sidebar" aria-label="Ana gezinme">

        <div class="side-head">
            @* M-13 UI fix (28 Nisan 2026): Sidebar logo PNG. Expanded'de tam logo,
               collapsed'de küçük kitap SVG (60px wide içinde tam logo sığmaz). *@
            <a href="/Dashboard" class="brand-link" title="@brand.SiteTitle">
                @if (!string.IsNullOrEmpty(brand.LogoPath))
                {
                    <img src="@brand.LogoPath" alt="@brand.SiteTitle" class="brand-logo-full" />
                }
                else
                {
                    <span class="brand-logo-full brand-logo-full--text">@brand.SiteTitle</span>
                }
                <svg class="brand-logo-mini" width="22" height="20" viewBox="0 0 32 22" fill="none">
                    <rect x="0" y="0" width="14" height="20" fill="#dc2626" rx="1"/>
                    <rect x="2" y="2" width="10" height="16" fill="#fff" rx="0.5"/>
                    <rect x="14" y="2" width="14" height="18" fill="#dc2626" rx="1"/>
                    <rect x="16" y="4" width="10" height="14" fill="#fff" rx="0.5"/>
                    <line x1="18" y1="7" x2="24" y2="7" stroke="#dc2626" stroke-width="0.6"/>
                    <line x1="18" y1="9" x2="24" y2="9" stroke="#dc2626" stroke-width="0.6"/>
                    <line x1="18" y1="11" x2="22" y2="11" stroke="#dc2626" stroke-width="0.6"/>
                </svg>
            </a>
            <button class="side-collapse" id="btnSidebarCollapse" type="button" title="Daralt/Aç (Ctrl+B)">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                    <path d="M10 4l-4 4 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>

        <div class="side-body">

            @if (isAuthenticated)
            {
                // Plan 23 — Sidebar 5 grup: main / workspace / contracts / structure / system.
                // AppModule.GroupKey DB'den, Alpine x-show + transition ile aç/kapat + localStorage.
                var moduleIcons = new Dictionary<string, string>
                    {
                        ["reports"]     = "fas fa-chart-column",
                        ["dashboards"]  = "fas fa-table-columns",
                        ["calendar"]    = "fas fa-calendar-days",
                        ["documents"]   = "fas fa-folder-open",
                        ["tamim"]       = "fas fa-bullhorn",
                        ["circular"]    = "fas fa-bullhorn",
                        ["contracts"]   = "fas fa-file-contract",
                        ["obligations"] = "fas fa-list-check",
                        ["compliance"]  = "fas fa-shield-halved",
                        ["orgchart"]    = "fas fa-sitemap",
                        ["ai"]          = "fas fa-robot",
                        ["hr"]          = "fas fa-users",
                        ["approval"]    = "fas fa-check-double",
                        ["forms"]       = "fas fa-clipboard-list"
                    };

                    // ModuleKey → URL kök mapping. Modül route'ları MapAreaControllerRoute
                    // pattern: "{Area}/{controller=Home}/{action=Index}". HomeController'a düşer.
                    string ModuleUrl(string key) => key switch
                    {
                        "reports"     => "/Reports",
                        "dashboards"  => "/Dashboard",
                        "contracts"   => "/Contracts",
                        "obligations" => "/Obligations",
                        "documents"   => "/Documents",
                        "orgchart"    => "/OrgChart",
                        "calendar"    => "/Calendar",
                        "compliance"  => "/Compliance",
                        "ai"          => "/Ai",
                        "circular"    => "/Circular",   // Area root → HomeController.Index
                        "forms"       => "/Forms",      // Area root → HomeController.Index
                        "sop"         => "/SOP",        // Area root (all-caps) → HomeController.Index
                        _             => "/" + char.ToUpper(key[0]) + key.Substring(1)
                    };

                    // Group sıralaması + display name.
                    var groupOrder = new[]
                    {
                        ("main",      "Ana"),
                        ("workspace", "Çalışma Alanı"),
                        ("contracts", "Sözleşmeler & Uyum"),
                        ("structure", "Yapı & Yapay Zeka")
                    };

                var modulesByGroup = enabledModules
                    .GroupBy(m => string.IsNullOrEmpty(m.GroupKey) ? "workspace" : m.GroupKey!)
                    .ToDictionary(g => g.Key, g => g.OrderBy(m => m.SortOrder).ToList());

                @* Sabit "Ana" grubu — Dashboard core link. *@
                <div class="side-group" x-data="sidebarGroup('main')">
                    <button type="button" class="side-section side-group-head" @@click="toggle()" :aria-expanded="open.toString()">
                        <span>Ana</span>
                        <i class="fas fa-chevron-down side-group-chevron" :class="{ 'is-collapsed': !open }" aria-hidden="true"></i>
                    </button>
                    <ul class="nav-list" x-show="open" x-transition.duration.150ms>
                        <li>
                            <a href="/Dashboard" class="@(IsActive("Dashboard") ? "active" : "")" aria-current="@(IsActive("Dashboard") ? "page" : null)">
                                <span class="icon" aria-hidden="true"><i class="fas fa-house" aria-hidden="true"></i></span>
                                <span class="label">Genel Bakış</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Inbox" class="@(IsActive("Inbox") ? "active" : "")" aria-current="@(IsActive("Inbox") ? "page" : null)">
                                <span class="icon" aria-hidden="true"><i class="fas fa-inbox" aria-hidden="true"></i></span>
                                <span class="label">Gelen Kutusu</span>
                            </a>
                        </li>
                        <li>
                            <a href="/Workflow/Inbox" class="@(IsActive("Workflow") ? "active" : "")" aria-current="@(IsActive("Workflow") ? "page" : null)">
                                <span class="icon" aria-hidden="true"><i class="fas fa-check-double" aria-hidden="true"></i></span>
                                <span class="label">Bekleyen Onaylar</span>
                            </a>
                        </li>
                    </ul>
                </div>

                @* DB-driven gruplar (workspace, contracts, structure). *@
                @foreach (var (groupKey, groupLabel) in groupOrder.Skip(1))
                {
                    if (!modulesByGroup.TryGetValue(groupKey, out var groupMods) || groupMods.Count == 0)
                    {
                        continue;
                    }

                    <div class="side-group" x-data="sidebarGroup('@groupKey')">
                        <button type="button" class="side-section side-group-head" @@click="toggle()" :aria-expanded="open.toString()">
                            <span>@groupLabel</span>
                            <i class="fas fa-chevron-down side-group-chevron" :class="{ 'is-collapsed': !open }" aria-hidden="true"></i>
                        </button>
                        <ul class="nav-list" x-show="open" x-transition.duration.150ms>
                            @foreach (var module in groupMods)
                            {
                                // "dashboards" modülü "Genel Bakış" ile duplicate — Ana'da var, burada atla.
                                if (module.ModuleKey == "dashboards") { continue; }

                                var icon = moduleIcons.TryGetValue(module.ModuleKey, out var ic) ? ic : "fas fa-cube";
                                var moduleUrl = ModuleUrl(module.ModuleKey);
                                var routeKey = moduleUrl.TrimStart('/').Split('/')[0];
                                var isCircular = module.ModuleKey == "circular";
                                var showTamimBadge = isCircular && todaysCircular != null;
                                <li>
                                    <a href="@moduleUrl" class="@(IsActive(routeKey) ? "active" : "")" aria-current="@(IsActive(routeKey) ? "page" : null)">
                                        <span class="icon" aria-hidden="true"><i class="@icon"></i></span>
                                        <span class="label">@module.DisplayName</span>
                                        @if (showTamimBadge)
                                        {
                                            <span class="nav-badge" aria-label="Bugünün tamimi yayınlandı">Yeni</span>
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @* "Sistem" grubu — sadece admin. Logs + tüm admin alt-sayfaları. *@
                @if (isAdminUser)
                {
                    // Plan 23 — admin alt-sayfaları sidebar'da doğrudan erişilebilir.
                    // /Admin/Index (subnav) duplicate kalıyor ama sidebar hızlı erişim verir.
                    var adminAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
                    var adminTab = (Context.Request.Query["tab"].FirstOrDefault() ?? "").ToLowerInvariant();
                    bool TabActive(string tab) =>
                        IsActive("Admin") &&
                        ((adminAction == "index" && adminTab == tab) ||
                         (string.IsNullOrEmpty(adminTab) && adminAction == "index" && tab == "datasources"));
                    bool ActionActive(string actionName) =>
                        IsActive("Admin") && adminAction == actionName.ToLowerInvariant();

                    <div class="side-group" x-data="sidebarGroup('system')">
                        <button type="button" class="side-section side-group-head" @@click="toggle()" :aria-expanded="open.toString()">
                            <span>Sistem</span>
                            <i class="fas fa-chevron-down side-group-chevron" :class="{ 'is-collapsed': !open }" aria-hidden="true"></i>
                        </button>
                        <ul class="nav-list nav-list-grouped" x-show="open" x-transition.duration.150ms>
                            <li>
                                <a href="/Admin" class="@(adminAction == "index" && string.IsNullOrEmpty(adminTab) ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-gauge-high" aria-hidden="true"></i></span>
                                    <span class="label">Yönetim Paneli</span>
                                </a>
                            </li>

                            <li class="nav-subsection">İçerik & Veri</li>
                            <li>
                                <a href="/Admin?tab=datasources" class="@(TabActive("datasources") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-database" aria-hidden="true"></i></span>
                                    <span class="label">Veri Kaynakları</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin?tab=reports" class="@(TabActive("reports") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-file-lines" aria-hidden="true"></i></span>
                                    <span class="label">Rapor Kataloğu</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin?tab=filters" class="@(TabActive("filters") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-filter" aria-hidden="true"></i></span>
                                    <span class="label">Filtreler</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin/Lookup" class="@(ActionActive("lookup") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-list" aria-hidden="true"></i></span>
                                    <span class="label">Lookup</span>
                                </a>
                            </li>

                            <li class="nav-subsection">Erişim & Yetki</li>
                            <li>
                                <a href="/Admin?tab=users" class="@(TabActive("users") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-users" aria-hidden="true"></i></span>
                                    <span class="label">Kullanıcılar</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin?tab=roles" class="@(TabActive("roles") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-shield-halved" aria-hidden="true"></i></span>
                                    <span class="label">Roller</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin?tab=groups" class="@(TabActive("groups") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-folder-tree" aria-hidden="true"></i></span>
                                    <span class="label">Rapor Grupları</span>
                                </a>
                            </li>

                            <li class="nav-subsection">Yapı</li>
                            <li>
                                <a href="/Admin/OrgChart" class="@(ActionActive("orgchart") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-sitemap" aria-hidden="true"></i></span>
                                    <span class="label">Organizasyon</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Workflow/Admin" class="@(IsActive("Workflow") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-diagram-project" aria-hidden="true"></i></span>
                                    <span class="label">Workflow Şablonları</span>
                                </a>
                            </li>

                            <li class="nav-subsection">Görünüm & Ayar</li>
                            <li>
                                <a href="/Admin/BrandSettings" class="@(ActionActive("brandsettings") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-palette" aria-hidden="true"></i></span>
                                    <span class="label">Marka Ayarları</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin/Modules" class="@(ActionActive("modules") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-puzzle-piece" aria-hidden="true"></i></span>
                                    <span class="label">Modüller</span>
                                </a>
                            </li>
                            <li>
                                <a href="/Admin/AiSettings" class="@(ActionActive("aisettings") ? "active" : "")">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i></span>
                                    <span class="label">AI Ayarları</span>
                                </a>
                            </li>

                            <li class="nav-subsection">İzleme</li>
                            <li>
                                <a href="/Logs" class="@(IsActive("Logs") ? "active" : "")" aria-current="@(IsActive("Logs") ? "page" : null)">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-clock-rotate-left" aria-hidden="true"></i></span>
                                    <span class="label">Geçmiş / Loglar</span>
                                </a>
                            </li>
                            <li>
                                <a href="/hangfire" target="_blank" rel="noopener">
                                    <span class="icon" aria-hidden="true"><i class="fas fa-server" aria-hidden="true"></i></span>
                                    <span class="label">Hangfire</span>
                                    <i class="fas fa-arrow-up-right-from-square nav-ext-icon" aria-hidden="true"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            }
        </div>

        @if (isAuthenticated)
        {
            <div class="side-foot">
                <div class="avatar">@avatar</div>
                <div class="user-info">
                    <div class="n">@(string.IsNullOrWhiteSpace(fullName) ? userName : fullName)</div>
                    <div class="r">@(userRoles.Length > 0 ? string.Join(", ", userRoles) : "user")</div>
                </div>
                <div class="user-actions">
                    <a href="/Notifications" id="notificationsLink" title="Bildirimler" class="notif-link">
                        <i class="fas fa-bell" aria-hidden="true"></i>
                        <span id="notificationsBadge" class="notif-badge hidden">0</span>
                    </a>
                    <a href="/Profile" title="Profil"><i class="fas fa-user-gear" aria-hidden="true"></i></a>
                    <a href="/Login?logout=1" class="danger" title="Çıkış"><i class="fas fa-right-from-bracket" aria-hidden="true"></i></a>
                </div>
            </div>
        }
    </aside>

    @* ============ MAIN ============ *@
    <main class="main" id="mainContent">

        <div class="topbar">
            <button class="mobile-menu" id="btnMobileMenu" type="button" title="Menü">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>

            @* Breadcrumb slot — view'lar override edebilir *@
            @if (IsSectionDefined("Breadcrumb"))
            {
                @RenderSection("Breadcrumb", required: false)
            }
            else
            {
                <nav class="crumbs" aria-label="Sayfa konumu">
                    <a href="/Dashboard">BKM Kitap</a>
                    <span class="sep" aria-hidden="true">/</span>
                    <span class="current" aria-current="page">@(ViewData["PageTitle"] as string ?? ViewData["Title"]?.ToString()?.Split(" - ")[0] ?? "")</span>
                </nav>
            }

            @* Search slot — view'lar disable edebilir *@
            @if (!(ViewData["HideSearch"] is bool hideSearch && hideSearch))
            {
                @* M3 Cross-module Search — GET form (antiforgery gerekmez). *@
                <form class="search" method="get" action="/Search" role="search">
                    <span class="ico" aria-hidden="true"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></span>
                    <label for="topSearch" class="sr-only">Arama</label>
                    <input type="text" id="topSearch" name="q" value="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Search" ? ViewContext.HttpContext.Request.Query["q"].ToString() : "")" placeholder="Rapor, sözleşme, tamim ara..." aria-label="Rapor, sözleşme, yükümlülük, tamim arama" />
                </form>
            }

            <div class="top-actions">
                @* TopActions slot — builder gibi sayfalar mode/dirty/Kaydet butonlarını buraya enjekte eder *@
                @if (IsSectionDefined("TopActions"))
                {
                    @RenderSection("TopActions", required: false)
                }
                else if (isAuthenticated)
                {
                    <button type="button" class="icon-btn" title="Bildirimler" aria-label="Bildirimler">
                        <i class="fas fa-bell" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="icon-btn" title="Yardım" aria-label="Yardım">
                        <i class="fas fa-circle-question" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </main>

</div>

@* AntiForgery global token — sayfa içinde form olmasa bile `window.getAntiForgeryToken()`
   helper'ı (app-shell.js) için DOM'da daima erişilebilir tek source. Plan 25.2. *@
@Html.AntiForgeryToken()

<script src="~/assets/js/app-shell.js" asp-append-version="true"></script>
<script src="~/assets/js/focus-trap.js" asp-append-version="true"></script>
@if (User?.Identity is { IsAuthenticated: true })
{
    <script>
    (function () {
        const badge = document.getElementById('notificationsBadge');
        if (!badge) return;
        let intervalId = null;
        async function refresh() {
            try {
                const res = await fetch('/Notifications/UnreadCount', { credentials: 'same-origin' });
                if (res.status === 401) {
                    // Session expired — polling'i durdur, kullanıcı navigate ettiğinde global handler login'e yönlendirir.
                    if (intervalId) { clearInterval(intervalId); intervalId = null; }
                    badge.classList.add('hidden');
                    return;
                }
                if (!res.ok) {
                    console.warn('notificationsBadge refresh: HTTP', res.status);
                    badge.dataset.state = 'error';
                    return;
                }
                const data = await res.json();
                const count = data.count || 0;
                badge.dataset.state = 'ok';
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            } catch (e) {
                console.warn('notificationsBadge refresh failed', e);
                badge.dataset.state = 'error';
            }
        }
        refresh();
        intervalId = setInterval(refresh, 60000); // 60sn polling
    })();
    </script>
}
@RenderSection("Scripts", required: false)
</body>
</html>
