@*
    UI Standart partial — _EmptyState
    Kullanım:
      @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel {
          Icon = "fa-folder-open",
          Title = "Henüz rapor yok",
          Message = "İlk raporu oluşturmak için",
          ActionUrl = "/Admin/CreateReportV2",
          ActionText = "yeni rapor ekle"
      })
    Detay: .claude/rules/ui-patterns.md §5
*@
@using Mosaik.ViewModels.Ui
@model EmptyStateViewModel

<div class="empty-state">
    <i class="fas @Model.Icon empty-state__icon" aria-hidden="true"></i>
    <h3>@Model.Title</h3>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p>
            @Model.Message
            @if (!string.IsNullOrEmpty(Model.ActionUrl) && !string.IsNullOrEmpty(Model.ActionText))
            {
                <a href="@Model.ActionUrl" class="empty-state__action">@Model.ActionText</a><text>.</text>
            }
        </p>
    }
</div>
