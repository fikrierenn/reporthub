@*
    UI Standart partial — _AlertMessage
    Kullanım:
      @await Html.PartialAsync("_AlertMessage", ("success", "Kaydedildi"))
      @await Html.PartialAsync("_AlertMessage", ("error", "Bir hata oluştu"))
      @await Html.PartialAsync("_AlertMessage", ("warn", "Dikkat"))
    Detay: .claude/rules/ui-patterns.md §9
*@
@model (string type, string message)
@{
    if (string.IsNullOrEmpty(Model.message)) { return; }
    var t = Model.type ?? "error";
    var cls = t == "success" ? "success" : t == "warn" ? "warn" : "error";
    var icon = t == "success" ? "fa-check-circle"
             : t == "warn"    ? "fa-triangle-exclamation"
                              : "fa-exclamation-circle";
}
<div role="alert" class="alert @cls">
    <i class="fas @icon alert-icon" aria-hidden="true"></i>
    @Model.message
</div>
