@model Mosaik.Models.ContractAiExtraction
@using Mosaik.Models
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "AI İnceleme";
    ViewData["PageTitle"] = "AI İnceleme";
    var suggestions = ViewBag.Suggestions as List<AiSuggestion> ?? new List<AiSuggestion>();
    var fields      = ViewBag.Fields as Mosaik.Controllers.AiController.ExtractedFields ?? new Mosaik.Controllers.AiController.ExtractedFields();
    var summary     = fields.Summary;
    var counterparty= fields.Counterparty;
    var category    = fields.Category;
    string FmtDate(string? iso) => string.IsNullOrWhiteSpace(iso) ? "—" : (DateTime.TryParse(iso, out var dt) ? dt.ToString("dd.MM.yyyy") : iso);

    var obligations = suggestions.Where(s => s.SuggestionType == SuggestionType.Obligation).ToList();
    var events      = suggestions.Where(s => s.SuggestionType == SuggestionType.ContractEvent).ToList();
    var risks       = suggestions.Where(s => s.SuggestionType == SuggestionType.RiskWarning).ToList();

    string ConfClass(Confidence c) => c switch
    {
        Confidence.High   => "ok",
        Confidence.Medium => "warn",
        Confidence.Low    => "err",
        _                 => ""
    };
    string ConfLabel(Confidence c) => c switch
    {
        Confidence.High   => "Yüksek",
        Confidence.Medium => "Orta",
        Confidence.Low    => "Düşük",
        _                 => c.ToString()
    };
    string StatusLabel(SuggestionStatus s) => s switch
    {
        SuggestionStatus.Pending  => "Bekliyor",
        SuggestionStatus.Approved => "Onaylandı",
        SuggestionStatus.Rejected => "Reddedildi",
        _                         => s.ToString()
    };
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Ana Sayfa</a>
        <span aria-hidden="true">›</span>
        <a href="/Ai">AI Analiz</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">İnceleme</span>
    </nav>
}

@section TopActions {
    @if (suggestions.Any(s => s.Status == SuggestionStatus.Pending))
    {
        <form method="post" action="/Ai/ApproveAll/@Model.Id" style="margin:0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn ghost">
                <i class="fas fa-check-double text-[10px]"></i>
                Tümünü Onayla
            </button>
        </form>
    }
    @if (Model.ContractId == null)
    {
        <form method="post" action="/Ai/CreateContract/@Model.Id" style="margin:0;" onsubmit="return confirm('AI çıkarımından sözleşme taslağı oluşturulacak. Onayladığınız yükümlülükler eklenecek. Devam?')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn primary">
                <i class="fas fa-file-circle-plus text-[10px]"></i>
                Sözleşme Olarak Kaydet
            </button>
        </form>
    }
    else
    {
        <a href="/Contracts/Edit/@Model.ContractId" class="btn primary">
            <i class="fas fa-pen text-[10px]"></i>
            Sözleşmeyi Düzenle
        </a>
    }
    <a href="/Ai" class="btn ghost">Geri</a>
}

@await Html.PartialAsync("_AlertMessage", TempData["Success"] != null ? ("success", TempData["Success"]!.ToString()!) : ("", ""))

@* Token istatistikleri *@
<div class="form-section-card" style="margin-bottom:16px; max-width:100%;">
    <div style="padding:12px 18px; display:flex; gap:20px; flex-wrap:wrap; align-items:center;">
        <span style="font-size:12.5px; color:var(--ink-2);">
            <strong>Dosya:</strong> @(Model.ContractFile?.FileName ?? "—")
        </span>
        @if (Model.Contract != null)
        {
            <span style="font-size:12.5px; color:var(--ink-2);">
                <strong>Sözleşme:</strong>
                <a href="/Contracts/Details/@Model.Contract.Id" style="color:var(--accent);">@Model.Contract.Title</a>
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ModelUsed))
        {
            <span class="pill mono">@Model.ModelUsed</span>
        }
        @if (Model.InputTokens > 0)
        {
            <span style="font-size:12px; color:var(--ink-4);">
                <i class="fas fa-coins" style="font-size:10px;"></i>
                @Model.InputTokens giriş · @Model.OutputTokens çıkış token
            </span>
        }
        @if (Model.ProcessedAt.HasValue)
        {
            <span class="ago">@Model.ProcessedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
        }
    </div>
</div>

<div style="display:grid; grid-template-columns:5fr 7fr; gap:20px; align-items:start;">

    @* Sol: PDF önizleme *@
    <div style="position:sticky; top:80px;">
        @if (Model.ContractFile != null)
        {
            <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; overflow:hidden;">
                <div style="padding:10px 14px; border-bottom:1px solid var(--line); font-size:12.5px; font-weight:600; color:var(--ink-1);">
                    <i class="fas fa-file-pdf" style="color:var(--err); margin-right:6px;"></i>
                    Belge Önizleme
                </div>
                <iframe src="/@Model.ContractFile.FilePath" style="width:100%; height:600px; border:none;" title="PDF önizleme">
                    PDF görüntülenemiyor.
                </iframe>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-file-slash" style="font-size:36px; opacity:.3;"></i>
                <p>Dosya bulunamadı.</p>
            </div>
        }
    </div>

    @* Sağ: AI sonuçları *@
    <div style="display:flex; flex-direction:column; gap:16px;">

        @* AI Özeti *@
        @if (!string.IsNullOrWhiteSpace(summary))
        {
            <div style="background:linear-gradient(135deg,var(--accent) 0%,#7c3aed 100%); border-radius:10px; padding:18px 20px; color:#fff;">
                <div style="display:flex; gap:8px; align-items:center; margin-bottom:10px;">
                    <i class="fas fa-robot" style="font-size:14px;"></i>
                    <span style="font-size:12.5px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; opacity:.9;">AI Özeti</span>
                    @if (!string.IsNullOrWhiteSpace(counterparty))
                    {
                        <span style="margin-left:auto; background:rgba(255,255,255,.2); border-radius:20px; padding:2px 10px; font-size:11.5px;">@counterparty</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(category))
                    {
                        <span style="background:rgba(255,255,255,.15); border-radius:20px; padding:2px 10px; font-size:11.5px;">@category</span>
                    }
                </div>
                <p style="margin:0; font-size:13px; line-height:1.6; opacity:.95;">@summary</p>
            </div>
        }

        @* Sözleşme Bilgileri (yapısal alanlar) *@
        <div class="form-section-card wide">
            <div class="form-section-head">
                <h2><i class="fas fa-file-contract text-muted"></i> Sözleşme Bilgileri</h2>
            </div>
            <div class="kv-grid">
                @if (!string.IsNullOrWhiteSpace(fields.Subject))
                {
                    <div class="full">
                        <div class="kv-label">Konu</div>
                        <div class="kv-value">@fields.Subject</div>
                    </div>
                }
                <div>
                    <div class="kv-label">Sözleşme No</div>
                    <div class="kv-value mono">@(fields.ContractNumber ?? "—")</div>
                </div>
                <div>
                    <div class="kv-label">Kategori</div>
                    <div class="kv-value">@(fields.Category ?? "—")</div>
                </div>
                <div>
                    <div class="kv-label">İmza Tarihi</div>
                    <div class="kv-value">@FmtDate(fields.SignedDate)</div>
                </div>
                <div>
                    <div class="kv-label">Yürürlük</div>
                    <div class="kv-value">@FmtDate(fields.StartDate) → @FmtDate(fields.EndDate)</div>
                </div>
                @if (fields.TotalAmount.HasValue || !string.IsNullOrWhiteSpace(fields.PaymentTerms))
                {
                    <div>
                        <div class="kv-label">Bedel</div>
                        <div class="kv-value">
                            @(fields.TotalAmount.HasValue ? $"{fields.TotalAmount:N2} {fields.Currency ?? ""}" : "—")
                        </div>
                    </div>
                    <div>
                        <div class="kv-label">Ödeme Koşulları</div>
                        <div class="kv-value">@(fields.PaymentTerms ?? "—")</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(fields.Jurisdiction))
                {
                    <div class="full">
                        <div class="kv-label">Yetkili Mahkeme</div>
                        <div class="kv-value">@fields.Jurisdiction</div>
                    </div>
                }
            </div>
        </div>

        @* Taraflar *@
        @if (fields.Parties.Any())
        {
            <div class="form-section-card wide">
                <div class="form-section-head">
                    <h2><i class="fas fa-handshake text-muted"></i> Taraflar <span class="pill">@fields.Parties.Count</span></h2>
                </div>
                <div class="form-section-body stack-12">
                    @foreach (var p in fields.Parties)
                    {
                        <div class="party-card">
                            <div class="party-card-head">
                                <span class="party-card-title">@p.Name</span>
                                @if (!string.IsNullOrWhiteSpace(p.Role))
                                {
                                    <span class="pill">@p.Role</span>
                                }
                            </div>
                            <div class="party-card-meta">
                                @if (!string.IsNullOrWhiteSpace(p.TaxId))
                                { <div><strong>Vergi/TCKN:</strong> <span class="mono">@p.TaxId</span></div> }
                                @if (!string.IsNullOrWhiteSpace(p.Signatory))
                                { <div><strong>İmzacı:</strong> @p.Signatory @(p.SignatoryTitle is null ? "" : $"({p.SignatoryTitle})")</div> }
                                @if (!string.IsNullOrWhiteSpace(p.Address))
                                { <div class="full"><strong>Adres:</strong> @p.Address</div> }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* Anahtar şartlar *@
        @if (fields.KeyTerms.Any())
        {
            <div class="form-section-card wide">
                <div class="form-section-head">
                    <h2><i class="fas fa-list-check text-muted"></i> Önemli Şartlar <span class="pill">@fields.KeyTerms.Count</span></h2>
                </div>
                <div class="form-section-body stack-12">
                    @foreach (var t in fields.KeyTerms)
                    {
                        <div class="term-block">
                            <div class="term-block-title">@t.Title</div>
                            @if (!string.IsNullOrWhiteSpace(t.Detail))
                            {
                                <div class="term-block-detail">@t.Detail</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Yükümlülük önerileri *@
        @if (obligations.Any())
        {
            <div class="form-section-card" style="max-width:100%;">
                <div style="padding:12px 16px; border-bottom:1px solid var(--line);">
                    <span style="font-size:13px; font-weight:600;">Yükümlülükler <span class="pill">@obligations.Count</span></span>
                </div>
                <div style="padding:12px 16px; display:flex; flex-direction:column; gap:10px;">
                    @foreach (var s in obligations)
                    {
                        <div style="border-left:3px solid var(--@(ConfClass(s.Confidence) == "ok" ? "ok" : ConfClass(s.Confidence) == "warn" ? "warn" : "err")); padding:10px 14px; background:var(--canvas); border-radius:0 6px 6px 0;">
                            <div style="display:flex; justify-content:space-between; align-items:start; gap:8px;">
                                <span style="font-size:13px; font-weight:500; color:var(--ink-1);">@s.Title</span>
                                <span class="status @ConfClass(s.Confidence)" style="white-space:nowrap;">@ConfLabel(s.Confidence)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.Description))
                            {
                                <p style="margin:6px 0 0; font-size:12px; color:var(--ink-3);">@s.Description</p>
                            }
                            @if (s.Status == SuggestionStatus.Pending)
                            {
                                <div style="display:flex; gap:6px; margin-top:10px;">
                                    <form method="post" action="/Ai/ApproveSuggestion/@s.Id" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn sm primary">Onayla</button>
                                    </form>
                                    <form method="post" action="/Ai/RejectSuggestion/@s.Id" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn sm ghost">Reddet</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="status @(s.Status == SuggestionStatus.Approved ? "ok" : "err")" style="margin-top:8px; display:inline-block;">
                                    @StatusLabel(s.Status)
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Takvim etkinlikleri *@
        @if (events.Any())
        {
            <div class="form-section-card" style="max-width:100%;">
                <div style="padding:12px 16px; border-bottom:1px solid var(--line);">
                    <span style="font-size:13px; font-weight:600;">Takvim Etkinlikleri <span class="pill">@events.Count</span></span>
                </div>
                <div style="padding:12px 16px; display:flex; flex-direction:column; gap:10px;">
                    @foreach (var s in events)
                    {
                        <div style="border-left:3px solid var(--@(ConfClass(s.Confidence) == "ok" ? "ok" : ConfClass(s.Confidence) == "warn" ? "warn" : "err")); padding:10px 14px; background:var(--canvas); border-radius:0 6px 6px 0;">
                            <div style="display:flex; justify-content:space-between; align-items:start;">
                                <span style="font-size:13px; font-weight:500; color:var(--ink-1);">@s.Title</span>
                                <span class="status @ConfClass(s.Confidence)">@ConfLabel(s.Confidence)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.Description))
                            {
                                <p style="margin:6px 0 0; font-size:12px; color:var(--ink-3);">@s.Description</p>
                            }
                            @if (s.Status == SuggestionStatus.Pending)
                            {
                                <div style="display:flex; gap:6px; margin-top:10px;">
                                    <form method="post" action="/Ai/ApproveSuggestion/@s.Id" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn sm primary">Onayla</button>
                                    </form>
                                    <form method="post" action="/Ai/RejectSuggestion/@s.Id" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn sm ghost">Reddet</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="status @(s.Status == SuggestionStatus.Approved ? "ok" : "err")" style="margin-top:8px; display:inline-block;">
                                    @StatusLabel(s.Status)
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Risk uyarıları *@
        @if (risks.Any())
        {
            <div class="form-section-card" style="max-width:100%;">
                <div style="padding:12px 16px; border-bottom:1px solid var(--line);">
                    <span style="font-size:13px; font-weight:600; color:var(--err);">
                        <i class="fas fa-triangle-exclamation" style="margin-right:4px;"></i>
                        Risk Uyarıları <span class="pill">@risks.Count</span>
                    </span>
                </div>
                <div style="padding:12px 16px; display:flex; flex-direction:column; gap:10px;">
                    @foreach (var s in risks)
                    {
                        <div style="border-left:3px solid var(--err); padding:10px 14px; background:var(--canvas); border-radius:0 6px 6px 0;">
                            <div style="display:flex; justify-content:space-between; align-items:start;">
                                <span style="font-size:13px; font-weight:500; color:var(--ink-1);">@s.Title</span>
                                <span class="status err">Risk</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.Description))
                            {
                                <p style="margin:6px 0 0; font-size:12px; color:var(--ink-3);">@s.Description</p>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (!suggestions.Any())
        {
            <div class="empty-state">
                <i class="fas fa-robot" style="font-size:40px; opacity:.3;"></i>
                <h3>Öneri bulunamadı</h3>
                <p>AI bu belgeden henüz öneri çıkarmadı.</p>
            </div>
        }
    </div>
</div>
