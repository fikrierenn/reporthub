@model List<Mosaik.Models.ContractAiExtraction>
@using Mosaik.Models
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "AI Analiz";
    ViewData["PageTitle"] = "AI Analiz";
    var pendingCounts = ViewBag.PendingCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var statusFilter = ViewBag.StatusFilter as ExtractionStatus?;

    string StatusLabel(ExtractionStatus s) => s switch
    {
        ExtractionStatus.Processing     => "İşleniyor",
        ExtractionStatus.AwaitingReview => "İnceleme Bekliyor",
        ExtractionStatus.Approved       => "Onaylandı",
        ExtractionStatus.Rejected       => "Reddedildi",
        ExtractionStatus.Failed         => "Hata",
        _                               => s.ToString()
    };
    string StatusClass(ExtractionStatus s) => s switch
    {
        ExtractionStatus.Processing     => "warn",
        ExtractionStatus.AwaitingReview => "warn",
        ExtractionStatus.Approved       => "ok",
        ExtractionStatus.Rejected       => "err",
        ExtractionStatus.Failed         => "err",
        _                               => ""
    };
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Ana Sayfa</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">AI Analiz</span>
    </nav>
}

@section TopActions {
    <a href="/Documents" class="btn ghost">
        <i class="fas fa-folder-open text-[10px]"></i>
        Belgeler
    </a>
    <a href="#" class="icon-btn" title="Yardım">
        <i class="fas fa-circle-question"></i>
    </a>
}

<div class="hero">
    <h1>AI Analiz</h1>
    <div class="sub">
        <span>PDF belgelerden otomatik sözleşme verisi çıkarma</span>
        <span class="mono">@Model.Count işlem</span>
    </div>
</div>

@await Html.PartialAsync("_AlertMessage", TempData["Success"] != null ? ("success", TempData["Success"]!.ToString()!) : ("", ""))

@* Durum filtresi *@
<div style="display:flex; gap:6px; margin-bottom:18px; flex-wrap:wrap;">
    <a href="/Ai" class="btn @(statusFilter == null ? "primary" : "ghost") sm">Tümü</a>
    @foreach (var s in Enum.GetValues<ExtractionStatus>())
    {
        <a href="/Ai?status=@((int)s)" class="btn @(statusFilter == s ? "primary" : "ghost") sm">@StatusLabel(s)</a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-robot" style="font-size:48px; opacity:.3; margin-bottom:12px;"></i>
        <h3>AI analiz kaydı bulunamadı</h3>
        <p>PDF belgesi yükleyin — analiz otomatik başlar.</p>
        <a href="/Documents" class="btn primary" style="margin-top:12px;">Belge Yükle</a>
    </div>
}
else
{
    <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; overflow:hidden;">
        <table class="dt">
            <thead>
                <tr>
                    <th scope="col">Dosya</th>
                    <th scope="col">Durum</th>
                    <th scope="col">Model</th>
                    <th scope="col">Öneriler</th>
                    <th scope="col">İşlenme</th>
                    <th scope="col" style="text-align:right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    var pending = pendingCounts.TryGetValue(x.Id, out var pc) ? pc : 0;
                    <tr id="row-@x.Id">
                        <td>
                            <span style="font-size:13px; font-weight:500; color:var(--ink-1);">@(x.ContractFile?.FileName ?? "—")</span>
                            @if (x.Contract != null)
                            {
                                <br><a href="/Contracts/Details/@x.Contract.Id" style="font-size:12px; color:var(--accent);">@x.Contract.Title</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.ErrorMessage))
                            {
                                <br><span class="text-xs" style="color:var(--err);">@x.ErrorMessage</span>
                            }
                        </td>
                        <td>
                            <span class="status @StatusClass(x.Status)" id="status-@x.Id">@StatusLabel(x.Status)</span>
                            @if (!string.IsNullOrWhiteSpace(x.ProgressStep))
                            {
                                <br><span class="mono text-xs" style="color:var(--ink-4);">@x.ProgressStep</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(x.ModelUsed))
                            {
                                <span class="mono text-xs">@x.ModelUsed</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (pending > 0)
                            {
                                <span class="pill" style="background:var(--warn-bg); color:var(--warn);">@pending bekliyor</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <span class="ago">@(x.ProcessedAt.HasValue ? x.ProcessedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")</span>
                        </td>
                        <td style="text-align:right;">
                            @if (x.Status == ExtractionStatus.AwaitingReview)
                            {
                                <a href="/Ai/Review/@x.Id" class="btn sm primary">
                                    <i class="fas fa-magnifying-glass text-[9px]"></i>
                                    İncele
                                </a>
                            }
                            @if (x.Status == ExtractionStatus.Failed || x.Status == ExtractionStatus.Rejected)
                            {
                                <form method="post" action="/Ai/Retry/@x.Id" style="display:inline; margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn sm ghost">
                                        <i class="fas fa-rotate-right text-[9px]"></i>
                                        Yeniden Dene
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_FooterHint", (string?)$"{Model.Count} AI analiz kaydı")

@section Scripts {
    <script>
    // Processing durumundaki kayıtlar için polling
    (function () {
        var processingIds = [@Html.Raw(string.Join(",", Model.Where(x => x.Status == ExtractionStatus.Processing).Select(x => x.Id)))];
        if (processingIds.length === 0) return;

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        function poll() {
            processingIds.forEach(function (id) {
                fetch('/Ai/Status/' + id)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        var el = document.getElementById('status-' + id);
                        if (el) el.textContent = data.statusLabel;
                        if (data.status !== 0) {
                            processingIds = processingIds.filter(function (i) { return i !== id; });
                            if (data.status === 2) setTimeout(function () { location.reload(); }, 1000);
                        }
                    })
                    .catch(function () {});
            });
            if (processingIds.length > 0) setTimeout(poll, 3000);
        }

        setTimeout(poll, 3000);
    })();
    </script>
}
