@model List<Mosaik.Models.ContractAiExtraction>
@using Mosaik.Models
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "AI Analiz";
    ViewData["PageTitle"] = "AI Analiz";
    var pendingCounts = ViewBag.PendingCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var statusFilter = ViewBag.StatusFilter as ExtractionStatus?;

    string StatusLabel(ExtractionStatus s) => s switch
    {
        ExtractionStatus.Processing     => "İşleniyor",
        ExtractionStatus.AwaitingReview => "İnceleme Bekliyor",
        ExtractionStatus.Approved       => "Onaylandı",
        ExtractionStatus.Rejected       => "Reddedildi",
        ExtractionStatus.Failed         => "Hata",
        _                               => s.ToString()
    };
    string StatusClass(ExtractionStatus s) => s switch
    {
        ExtractionStatus.Processing     => "warn",
        ExtractionStatus.AwaitingReview => "warn",
        ExtractionStatus.Approved       => "ok",
        ExtractionStatus.Rejected       => "err",
        ExtractionStatus.Failed         => "err",
        _                               => ""
    };

    // Plan 27 — işleniyor adım göstergesi.
    // Worker step kodları: "" → "ocr" → "ai_stage1" → "ai_stage2" → "done"/"failed"
    var stepOrder = new[] { "ocr", "ai_stage1", "ai_stage2", "done" };
    string StepLabel(string code) => code switch
    {
        "ocr"       => "Metin Çıkarma",
        "ai_stage1" => "AI Aşama 1 (Yapısal Çıkarım)",
        "ai_stage2" => "AI Aşama 2 (Derin Analiz)",
        "done"      => "Tamamlandı",
        "failed"    => "Hata",
        ""          => "Sıraya Alındı",
        null        => "Sıraya Alındı",
        _           => code
    };
    string StepIcon(string code) => code switch
    {
        "ocr"       => "fa-file-image",
        "ai_stage1" => "fa-brain",
        "ai_stage2" => "fa-microscope",
        "done"      => "fa-check",
        "failed"    => "fa-triangle-exclamation",
        _           => "fa-hourglass-half"
    };
    int StepIndex(string? code)
    {
        if (string.IsNullOrEmpty(code)) return -1;
        var i = Array.IndexOf(stepOrder, code);
        return i >= 0 ? i : -1;
    }
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Ana Sayfa</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">AI Analiz</span>
    </nav>
}

@section TopActions {
    <a href="/Documents" class="btn ghost">
        <i class="fas fa-folder-open text-[10px]"></i>
        Belgeler
    </a>
    <a href="#" class="icon-btn" title="Yardım">
        <i class="fas fa-circle-question"></i>
    </a>
}

<div class="hero">
    <h1>AI Analiz</h1>
    <div class="sub">
        <span>PDF belgelerden otomatik sözleşme verisi çıkarma</span>
        <span class="mono">@Model.Count işlem</span>
    </div>
</div>

@await Html.PartialAsync("_AlertMessage", TempData["Success"] != null ? ("success", TempData["Success"]!.ToString()!) : ("", ""))

@* Durum filtresi *@
<div style="display:flex; gap:6px; margin-bottom:18px; flex-wrap:wrap;">
    <a href="/Ai" class="btn @(statusFilter == null ? "primary" : "ghost") sm">Tümü</a>
    @foreach (var s in Enum.GetValues<ExtractionStatus>())
    {
        <a href="/Ai?status=@((int)s)" class="btn @(statusFilter == s ? "primary" : "ghost") sm">@StatusLabel(s)</a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-robot" style="font-size:48px; opacity:.3; margin-bottom:12px;"></i>
        <h3>AI analiz kaydı bulunamadı</h3>
        <p>PDF belgesi yükleyin — analiz otomatik başlar.</p>
        <a href="/Documents" class="btn primary" style="margin-top:12px;">Belge Yükle</a>
    </div>
}
else
{
    <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; overflow:hidden;">
        <table class="dt">
            <thead>
                <tr>
                    <th scope="col">Dosya</th>
                    <th scope="col">Durum</th>
                    <th scope="col">Model</th>
                    <th scope="col">Öneriler</th>
                    <th scope="col">İşlenme</th>
                    <th scope="col" style="text-align:right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    var pending = pendingCounts.TryGetValue(x.Id, out var pc) ? pc : 0;
                    <tr id="row-@x.Id">
                        <td>
                            <span style="font-size:13px; font-weight:500; color:var(--ink-1);">@(x.ContractFile?.FileName ?? "—")</span>
                            @if (x.Contract != null)
                            {
                                <br><a href="/Contracts/Details/@x.Contract.Id" style="font-size:12px; color:var(--accent);">@x.Contract.Title</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(x.ErrorMessage))
                            {
                                <br><span class="text-xs" style="color:var(--err);">@x.ErrorMessage</span>
                            }
                        </td>
                        <td style="min-width:320px;">
                            <span class="status @StatusClass(x.Status)" id="status-@x.Id">@StatusLabel(x.Status)</span>
                            @if (x.Status == ExtractionStatus.Processing || x.Status == ExtractionStatus.AwaitingReview || x.Status == ExtractionStatus.Approved)
                            {
                                var currentIdx = StepIndex(x.ProgressStep);
                                var doneAll = x.Status != ExtractionStatus.Processing;
                                <div class="ai-stepper" id="stepper-@x.Id"
                                     data-step="@(x.ProgressStep ?? "")"
                                     data-timestamps="@(x.ProgressTimestampsJson ?? "")">
                                    @for (int si = 0; si < stepOrder.Length; si++)
                                    {
                                        var stepCode = stepOrder[si];
                                        var state = doneAll ? "done"
                                                    : currentIdx < 0 ? "pending"
                                                    : si < currentIdx ? "done"
                                                    : si == currentIdx ? "active"
                                                    : "pending";
                                        <div class="ai-step @state" title="@StepLabel(stepCode)" data-step-code="@stepCode">
                                            <i class="fas @StepIcon(stepCode)"></i>
                                            <span class="ai-step-label">@StepLabel(stepCode)</span>
                                            <span class="ai-step-duration" data-step-duration></span>
                                        </div>
                                    }
                                </div>
                                @if (x.Status == ExtractionStatus.Processing)
                                {
                                    <div class="ai-elapsed text-xs" data-start="@DateTime.SpecifyKind((x.UpdatedAt.HasValue && x.UpdatedAt.Value > x.CreatedAt) ? x.UpdatedAt.Value : x.CreatedAt, DateTimeKind.Utc).ToString("yyyy-MM-ddTHH:mm:ss.fffZ")">Süre hesaplanıyor...</div>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(x.ProgressStep) && x.ProgressStep != "done")
                            {
                                <br>
                                <span class="text-xs" style="color:var(--ink-4);">
                                    <i class="fas @StepIcon(x.ProgressStep)" style="margin-right:4px;"></i>
                                    @StepLabel(x.ProgressStep)
                                </span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(x.ModelUsed))
                            {
                                <span class="mono text-xs">@x.ModelUsed</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (pending > 0)
                            {
                                <span class="pill" style="background:var(--warn-bg); color:var(--warn);">@pending bekliyor</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <span class="ago">@(x.ProcessedAt.HasValue ? x.ProcessedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")</span>
                        </td>
                        <td style="text-align:right;">
                            <a href="/Ai/Detail/@x.Id" class="btn sm ghost" title="Detay (ham metin + AI çıktıları)">
                                <i class="fas fa-file-lines text-[9px]"></i>
                                Detay
                            </a>
                            @if (x.Status == ExtractionStatus.AwaitingReview)
                            {
                                <a href="/Ai/Review/@x.Id" class="btn sm primary">
                                    <i class="fas fa-magnifying-glass text-[9px]"></i>
                                    İncele
                                </a>
                            }
                            @if (x.Status == ExtractionStatus.Processing)
                            {
                                <form method="post" action="/Ai/Cancel/@x.Id" style="display:inline; margin:0;" onsubmit="return confirm('Bu AI işlemi iptal edilsin mi?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn sm danger" title="İptal et">
                                        <i class="fas fa-stop text-[9px]"></i>
                                        İptal
                                    </button>
                                </form>
                            }
                            @if (x.Status == ExtractionStatus.Failed || x.Status == ExtractionStatus.Rejected)
                            {
                                <form method="post" action="/Ai/Retry/@x.Id" style="display:inline; margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn sm ghost">
                                        <i class="fas fa-rotate-right text-[9px]"></i>
                                        Yeniden Dene
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_FooterHint", (string?)$"{Model.Count} AI analiz kaydı")

@section Scripts {
    <script>
    // Processing durumundaki kayıtlar için polling + stepper + elapsed time
    (function () {
        var processingIds = [@Html.Raw(string.Join(",", Model.Where(x => x.Status == ExtractionStatus.Processing).Select(x => x.Id)))];
        var STEP_ORDER = ['ocr', 'ai_stage1', 'ai_stage2', 'done'];
        var STEP_LABELS = {
            '': 'Sıraya Alındı',
            'ocr': 'Metin Çıkarma',
            'ai_stage1': 'AI Aşama 1 (Yapısal Çıkarım)',
            'ai_stage2': 'AI Aşama 2 (Derin Analiz)',
            'done': 'Tamamlandı',
            'failed': 'Hata'
        };

        function fmtElapsed(ms) {
            var s = Math.floor(ms / 1000);
            if (s < 60) return s + ' sn';
            var m = Math.floor(s / 60);
            var rs = s - m * 60;
            return m + ' dk ' + rs + ' sn';
        }

        function updateElapsed() {
            document.querySelectorAll('.ai-elapsed[data-start]').forEach(function (el) {
                var start = new Date(el.getAttribute('data-start')).getTime();
                if (isNaN(start)) return;
                el.textContent = 'Geçen süre: ' + fmtElapsed(Date.now() - start);
            });
        }
        setInterval(updateElapsed, 1000);
        updateElapsed();

        function fmtShort(ms) {
            if (ms < 1000) return ms + 'ms';
            var s = Math.round(ms / 1000);
            if (s < 60) return s + 'sn';
            var m = Math.floor(s / 60);
            var rs = s - m * 60;
            return m + 'dk' + (rs > 0 ? ' ' + rs + 'sn' : '');
        }

        function renderDurations(box, stamps, currentStep) {
            var nodes = box.querySelectorAll('.ai-step');
            nodes.forEach(function (n, i) {
                var code = n.getAttribute('data-step-code');
                var nextCode = STEP_ORDER[i + 1] || null;
                var start = stamps[code] ? new Date(stamps[code]).getTime() : null;
                var end = null;
                if (nextCode && stamps[nextCode]) end = new Date(stamps[nextCode]).getTime();
                else if (code === currentStep) end = Date.now();          // şu an aktif adım
                else if (start && !nextCode) end = start;                  // done adımı

                var dur = n.querySelector('[data-step-duration]');
                if (!dur) return;
                if (start && end) {
                    var d = end - start;
                    dur.textContent = d > 0 ? '(' + fmtShort(d) + ')' : '';
                } else {
                    dur.textContent = '';
                }
            });
        }

        function updateStepper(id, step, timestampsJson) {
            var box = document.getElementById('stepper-' + id);
            if (!box) return;
            box.setAttribute('data-step', step);
            if (timestampsJson) box.setAttribute('data-timestamps', timestampsJson);

            var idx = STEP_ORDER.indexOf(step);
            var nodes = box.querySelectorAll('.ai-step');
            nodes.forEach(function (n, i) {
                n.classList.remove('done', 'active', 'pending');
                if (step === 'done') n.classList.add('done');
                else if (idx < 0) n.classList.add('pending');
                else if (i < idx) n.classList.add('done');
                else if (i === idx) n.classList.add('active');
                else n.classList.add('pending');
            });

            var stamps = {};
            try { stamps = JSON.parse(box.getAttribute('data-timestamps') || '{}'); } catch (e) {}
            renderDurations(box, stamps, step);
        }

        // Sayfa açılışında mevcut stepper'lar için duration render et + aktif olanlar tick'lensin.
        document.querySelectorAll('.ai-stepper').forEach(function (box) {
            var step = box.getAttribute('data-step');
            var stamps = {};
            try { stamps = JSON.parse(box.getAttribute('data-timestamps') || '{}'); } catch (e) {}
            renderDurations(box, stamps, step);
        });
        // Processing satırları için aktif adım süresi her saniye güncellensin.
        setInterval(function () {
            document.querySelectorAll('.ai-stepper').forEach(function (box) {
                var step = box.getAttribute('data-step');
                if (!step || step === 'done') return;
                var stamps = {};
                try { stamps = JSON.parse(box.getAttribute('data-timestamps') || '{}'); } catch (e) {}
                renderDurations(box, stamps, step);
            });
        }, 1000);

        function poll() {
            processingIds.forEach(function (id) {
                fetch('/Ai/Status/' + id)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        var st = document.getElementById('status-' + id);
                        if (st) st.textContent = data.statusLabel;
                        if (data.progressStep) updateStepper(id, data.progressStep, data.progressTimestamps);

                        // status 0 = Processing, devam et. Diğer durumlarda durduralım ve reload.
                        if (data.status !== 0) {
                            processingIds = processingIds.filter(function (i) { return i !== id; });
                            setTimeout(function () { location.reload(); }, 1200);
                        }
                    })
                    .catch(function () {});
            });
            if (processingIds.length > 0) setTimeout(poll, 2500);
        }

        if (processingIds.length > 0) setTimeout(poll, 1500);
    })();
    </script>
}
