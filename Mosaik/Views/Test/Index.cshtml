@model Mosaik.ViewModels.TestViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Veritabanı Test - BKM Rapor Paneli";
    ViewData["PageTitle"] = "Veritabanı Bağlantı Testi";
}

<div class="hero">
    <h1>Veritabanı Bağlantı Testi</h1>
    <div class="sub">
        <span>Bağlantı ve örnek verileri kontrol edin</span>
        <span class="pill @(Model.CanConnect ? "ok" : "error")">
            <span class="dot @(Model.CanConnect ? "ok" : "err")"></span>
            @(Model.CanConnect ? "Bağlantı Başarılı" : "Bağlantı Başarısız")
        </span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert error" role="alert">
        <i class="fas fa-exclamation-circle icon-mr" aria-hidden="true"></i>
        <strong>Hata:</strong> @Model.Error
    </div>
}

<div class="kpi-grid cols-3 mb-18">
    <div class="kpi-card k-ink">
        <div class="head">
            <span class="label">Veri Kaynakları</span>
        </div>
        <div class="value">@Model.DataSourceCount</div>
    </div>
    <div class="kpi-card k-ink">
        <div class="head">
            <span class="label">Raporlar</span>
        </div>
        <div class="value">@Model.ReportCount</div>
    </div>
    <div class="kpi-card k-ink">
        <div class="head">
            <span class="label">Loglar</span>
        </div>
        <div class="value">@Model.LogCount</div>
    </div>
</div>

@if (Model.DataSources != null && Model.DataSources.Count > 0)
{
    <div class="table-card mb-18">
        <div class="table-card-head">
            <h2 class="table-card-head__title">Mevcut Veri Kaynakları</h2>
            <span class="table-card-head__count">@Model.DataSources.Count kayıt</span>
        </div>
        <table class="dt">
            <thead>
                <tr>
                    <th scope="col">Anahtar</th>
                    <th scope="col">Başlık</th>
                    <th scope="col">Durum</th>
                    <th scope="col">Oluşturulma</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ds in Model.DataSources)
                {
                    <tr>
                        <td><span class="mono">@ds.DataSourceKey</span></td>
                        <td>@ds.Title</td>
                        <td>
                            <span class="status @(ds.IsActive ? "ok" : "err")">@(ds.IsActive ? "Aktif" : "Pasif")</span>
                        </td>
                        <td><span class="ago">@ds.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.DataSources != null)
{
    <div class="dashed-card mb-18">
        <i class="fas fa-database dc-icon" aria-hidden="true"></i>
        <p>Henüz veri kaynağı bulunmuyor.</p>
    </div>
}

<div class="btn-row">
    <button onclick="addSampleData()" class="btn primary">
        <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
        Örnek Veri Ekle
    </button>
    <button onclick="location.reload()" class="btn">
        <i class="fas fa-rotate text-[10px]" aria-hidden="true"></i>
        Yenile
    </button>
</div>

<script src="~/assets/js/test-page.js"></script>
