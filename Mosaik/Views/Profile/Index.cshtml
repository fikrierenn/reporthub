@model Mosaik.ViewModels.ProfileViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Profil - BKM Rapor Paneli";
    ViewData["PageTitle"] = "Profil";
    var message = Model.Message ?? string.Empty;
    var messageType = Model.MessageType ?? string.Empty;

    string AvatarInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(new[] { ' ', '.', '_' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpperInvariant();
    }

    var avatar = AvatarInitials(string.IsNullOrWhiteSpace(Model.FullName) ? Model.Username : Model.FullName);
}

<div class="hero">
    <h1>Profil</h1>
    <div class="sub">
        <span class="mono">@Model.Username</span>
        <span class="pill"><i class="fas fa-shield-halved icon-xs text-muted" aria-hidden="true"></i> @Model.Roles</span>
        <span class="pill @(Model.IsActive ? "" : "error")">
            <span class="dot @(Model.IsActive ? "ok" : "err")"></span>
            @(Model.IsActive ? "Aktif" : "Pasif")
        </span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    @await Html.PartialAsync("_AlertMessage", (messageType == "success" ? "success" : "error", message))
}

<div class="form-section-card narrow">

    @* Card header — avatar + isim *@
    <div class="profile-card-head">
        <div class="avatar lg">@avatar</div>
        <div class="profile-card-head__body">
            <h2 class="profile-card-head__title">Hesap Bilgileri</h2>
            <div class="profile-card-head__sub">Kişisel bilgilerinizi güncelleyin</div>
        </div>
    </div>

    <form method="post" class="profile-card-body">
        @Html.AntiForgeryToken()

        <div class="grid-2col stack-14">
            <div class="field">
                <label class="lab" for="fld-username">Kullanıcı Adı</label>
                <input type="text" id="fld-username" value="@Model.Username" readonly class="inp disabled-mono" />
            </div>
            <div class="field">
                <label class="lab" for="fld-status">Durum</label>
                <input type="text" id="fld-status" value="@(Model.IsActive ? "Aktif" : "Pasif")" readonly class="inp disabled-mono" />
            </div>
        </div>

        <div class="grid-2col stack-14">
            <div class="field">
                <label class="lab" for="FullName">Ad Soyad <span class="req">*</span></label>
                <input type="text" id="FullName" name="FullName" value="@Model.FullName" required class="inp" placeholder="Ad Soyad" />
            </div>
            <div class="field">
                <label class="lab" for="Email">E-posta</label>
                <input type="email" id="Email" name="Email" value="@Model.Email" class="inp" placeholder="ornek@bkmkitap.com" />
            </div>
        </div>

        <div class="section-title profile-section-divider">
            <h2>Şifre Değiştir <span class="muted-suffix">— boş bırakırsanız değişmez</span></h2>
        </div>

        @* Plan 04 F2.3 (28 Nisan): _PasswordInput partial — DRY + Alpine show/hide toggle. *@
        <div class="grid-2col stack-14">
            @await Html.PartialAsync("_PasswordInput", new Mosaik.ViewModels.PasswordInputViewModel {
                Id = "NewPassword",
                Name = "NewPassword",
                Label = "Yeni Şifre",
                Placeholder = "Yeni şifre",
                Autocomplete = "new-password"
            })
            @await Html.PartialAsync("_PasswordInput", new Mosaik.ViewModels.PasswordInputViewModel {
                Id = "ConfirmPassword",
                Name = "ConfirmPassword",
                Label = "Yeni Şifre (Tekrar)",
                Placeholder = "Yeni şifreyi tekrar girin",
                Autocomplete = "new-password"
            })
        </div>

        <div class="profile-card-actions">
            <a href="/Dashboard" class="btn ghost">
                <i class="fas fa-arrow-left icon-xs" aria-hidden="true"></i>
                Geri Dön
            </a>
            <button type="submit" class="btn primary">
                <i class="fas fa-check icon-xs" aria-hidden="true"></i>
                Profili Güncelle
            </button>
        </div>
    </form>
</div>
