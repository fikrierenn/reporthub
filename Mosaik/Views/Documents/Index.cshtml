@model List<Mosaik.Models.ContractFile>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Belgeler";
    ViewData["PageTitle"] = "Belgeler";
    var contracts = ViewBag.Contracts as List<(int Id, string Title)>;
    var contractFilter = ViewBag.ContractFilter as int?;
    var q = ViewBag.Q as string;
    var hasFilter = !string.IsNullOrWhiteSpace(q) || contractFilter.HasValue;
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Ana Sayfa</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Belgeler</span>
    </nav>
}

@section TopActions {
    <button type="button" class="btn primary" onclick="toggleUpload()">
        <i class="fas fa-upload text-[10px]"></i>
        Yeni Belge
    </button>
    <a href="#" class="icon-btn" title="Yardım">
        <i class="fas fa-circle-question"></i>
    </a>
}

<div class="hero">
    <h1>Belgeler</h1>
    <div class="sub">
        <span class="mono">@Model.Count belge</span>
    </div>
</div>

@await Html.PartialAsync("_AlertMessage", TempData["Success"] != null ? ("success", TempData["Success"]!.ToString()!) : TempData["Error"] != null ? ("error", TempData["Error"]!.ToString()!) : ("", ""))

<div x-data="{ q: '@(q ?? "")' }">

    @* Upload formu — collapsible (Yeni Belge butonu tetikler). Default gizli, JS toggle. *@
    <form id="uploadForm" method="post" action="/Documents/Upload" enctype="multipart/form-data" class="hidden">
        @Html.AntiForgeryToken()
        <div class="form-section-card wide">
            <div class="form-section-head">
                <h2>
                    <i class="fas fa-upload text-muted"></i>
                    Belge Yükle
                </h2>
                <button type="button" class="icon-btn" onclick="toggleUpload(false)" title="Kapat">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <div class="form-section-body stack">
                <div class="grid-2col">
                    <div class="field">
                        <label class="lab" for="fileInput">Dosya</label>
                        <input class="inp" type="file" id="fileInput" name="file" accept=".pdf,.docx,.xlsx,.doc" required>
                        <p class="help-text">PDF / DOCX / XLSX, maks. 50 MB</p>
                    </div>
                    <div class="field">
                        <label class="lab" for="contractSel">Sözleşme (opsiyonel)</label>
                        <select class="inp" id="contractSel" name="contractId">
                            <option value="">— Seçin —</option>
                            @if (contracts != null)
                            {
                                foreach (var c in contracts)
                                {
                                    <option value="@c.Id">@c.Title</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-action-row wide">
            <button type="button" class="btn ghost" onclick="toggleUpload(false)">İptal</button>
            <button type="submit" class="btn primary">
                <i class="fas fa-upload text-[10px]"></i>
                Yükle
            </button>
        </div>
    </form>

    @* Filter bar — standart pattern *@
    <form method="get" class="filter-bar">
        <div class="filter-bar__field filter-bar__field--grow">
            <label class="lab" for="qInput">Dosya adı</label>
            <input class="inp" type="text" id="qInput" name="q" value="@q" placeholder="Dosya ara..." x-model="q">
        </div>
        <div class="filter-bar__field">
            <label class="lab" for="contractFilter">Sözleşme</label>
            <select class="inp" id="contractFilter" name="contractId">
                <option value="">Tümü</option>
                @if (contracts != null)
                {
                    foreach (var c in contracts)
                    {
                        if (contractFilter.HasValue && c.Id == contractFilter.Value)
                        {
                            <option value="@c.Id" selected>@c.Title</option>
                        }
                        else
                        {
                            <option value="@c.Id">@c.Title</option>
                        }
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn primary">
            <i class="fas fa-filter text-[10px]"></i>
            Filtrele
        </button>
        @if (hasFilter)
        {
            <a href="/Documents" class="btn ghost">
                <i class="fas fa-xmark text-[10px]"></i>
                Temizle
            </a>
        }
    </form>

</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-folder-open empty-state__icon"></i>
        <h3>Belge bulunamadı</h3>
        <p>@(hasFilter ? "Filtre kriterlerinize uygun belge yok. Filtreleri temizleyip tekrar deneyin." : "Henüz belge yüklenmemiş. \"Yeni Belge\" ile başlayın.")</p>
    </div>
}
else
{
    <div class="table-card">
        <table class="dt">
            <thead>
                <tr>
                    <th scope="col">Dosya</th>
                    <th scope="col">Sözleşme</th>
                    <th scope="col">Boyut</th>
                    <th scope="col">Versiyon</th>
                    <th scope="col">Yüklenme</th>
                    <th scope="col" class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    var icon = f.MimeType?.Contains("pdf") == true ? "fas fa-file-pdf"
                             : f.MimeType?.Contains("word") == true ? "fas fa-file-word"
                             : f.MimeType?.Contains("sheet") == true ? "fas fa-file-excel"
                             : "fas fa-file";
                    var sizeLabel = f.FileSize >= 1024 * 1024
                        ? $"{f.FileSize / 1024.0 / 1024.0:F1} MB"
                        : $"{f.FileSize / 1024.0:F0} KB";

                    string? aiDocType = null;
                    var aiTagList = new List<string>();
                    if (!string.IsNullOrWhiteSpace(f.AiTagsJson))
                    {
                        try
                        {
                            using var d = System.Text.Json.JsonDocument.Parse(f.AiTagsJson);
                            var r = d.RootElement;
                            if (r.TryGetProperty("documentType", out var dt) && dt.ValueKind == System.Text.Json.JsonValueKind.String)
                                aiDocType = dt.GetString();
                            if (r.TryGetProperty("tags", out var ta) && ta.ValueKind == System.Text.Json.JsonValueKind.Array)
                            {
                                foreach (var t in ta.EnumerateArray())
                                    if (t.ValueKind == System.Text.Json.JsonValueKind.String)
                                        aiTagList.Add(t.GetString() ?? "");
                            }
                        }
                        catch { }
                    }
                    <tr>
                        <td>
                            <a href="/@f.FilePath" target="_blank" class="row-link" title="@(f.AiSummary ?? "")">
                                <i class="@icon" aria-hidden="true"></i>
                                <span>@f.FileName</span>
                            </a>
                            @if (!string.IsNullOrWhiteSpace(aiDocType) || aiTagList.Count > 0)
                            {
                                <div class="doc-tags">
                                    @if (!string.IsNullOrWhiteSpace(aiDocType))
                                    {
                                        <span class="pill">@aiDocType</span>
                                    }
                                    @foreach (var t in aiTagList.Take(3))
                                    {
                                        <span class="pill ghost">@t</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            @if (f.Contract != null)
                            {
                                <a href="/Contracts/Details/@f.Contract.Id" class="row-link">@f.Contract.Title</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td><span class="mono">@sizeLabel</span></td>
                        <td><span class="pill">v@f.Version</span></td>
                        <td><span class="ago">@f.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span></td>
                        <td class="text-right">
                            @if (f.MimeType?.Contains("pdf") == true)
                            {
                                <button type="button" class="btn sm ghost" title="Belgeye soru sor"
                                        onclick="DocChat.open(@f.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(f.FileName)))">
                                    <i class="fas fa-comments text-[9px]"></i>
                                    Sor
                                </button>
                                <a href="/Ai?fileId=@f.Id" class="btn sm ghost" title="AI Analiz">
                                    <i class="fas fa-robot text-[9px]"></i>
                                    AI
                                </a>
                            }
                            <form method="post" action="/Documents/Delete" class="inline-form" onsubmit="return confirm('Bu belge silinsin mi?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@f.Id">
                                <button type="submit" class="btn sm danger" title="Sil">
                                    <i class="fas fa-trash text-[9px]"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_FooterHint", (string?)$"{Model.Count} belge")

@* Plan 27 Faz B-05 — Belgeye soru sor drawer'ı *@
<div id="docChatDrawer" class="doc-chat-drawer hidden">
    <div class="doc-chat-head">
        <div>
            <div class="doc-chat-title" id="docChatFileName">—</div>
            <div class="doc-chat-sub">Belgeye soru sorun, AI cevaplasın</div>
        </div>
        <button type="button" class="icon-btn" onclick="DocChat.close()" title="Kapat">
            <i class="fas fa-xmark"></i>
        </button>
    </div>
    <div class="doc-chat-body" id="docChatBody">
        <p class="text-muted">Henüz soru sorulmadı.</p>
    </div>
    <form class="doc-chat-form" onsubmit="event.preventDefault(); DocChat.ask();">
        <input type="text" id="docChatQ" class="inp" placeholder="Örn. Sözleşme süresi nedir?" autocomplete="off">
        <button type="submit" class="btn primary" id="docChatBtn">
            <i class="fas fa-paper-plane text-[10px]"></i>
            Sor
        </button>
    </form>
</div>

@section Scripts {
<script>
// Yeni Belge butonu — TopActions x-data scope'unun dışında olduğundan native JS toggle.
window.toggleUpload = function (force) {
    var f = document.getElementById('uploadForm');
    if (!f) return;
    var shown = !f.classList.contains('hidden');
    var target = (typeof force === 'boolean') ? force : !shown;
    f.classList.toggle('hidden', !target);
    if (target) {
        var fi = document.getElementById('fileInput');
        if (fi) setTimeout(function () { fi.focus(); }, 50);
    }
};

(function () {
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    var state = { fileId: 0, fileName: '', messages: [] };

    function el(id) { return document.getElementById(id); }

    function escapeHtml(s) {
        var d = document.createElement('div'); d.textContent = s; return d.innerHTML;
    }

    function render() {
        var body = el('docChatBody');
        if (state.messages.length === 0) {
            body.innerHTML = '<p class="text-muted">Henüz soru sorulmadı.</p>';
            return;
        }
        body.innerHTML = state.messages.map(function (m) {
            if (m.role === 'user')
                return '<div class="msg-row user"><div class="msg user">' + escapeHtml(m.text) + '</div></div>';
            if (m.role === 'assistant')
                return '<div class="msg-row ai"><div class="msg ai">' + escapeHtml(m.text) + '</div></div>';
            if (m.role === 'error')
                return '<div class="msg-row ai"><div class="msg error">' + escapeHtml(m.text) + '</div></div>';
            if (m.role === 'loading')
                return '<div class="msg-row ai"><div class="msg loading"><i class="fas fa-spinner fa-spin"></i> Düşünüyor...</div></div>';
            return '';
        }).join('');
        body.scrollTop = body.scrollHeight;
    }

    window.DocChat = {
        open: function (fileId, fileName) {
            state.fileId = fileId;
            state.fileName = fileName;
            state.messages = [];
            el('docChatFileName').textContent = fileName;
            el('docChatDrawer').classList.remove('hidden');
            render();
            setTimeout(function () { el('docChatQ').focus(); }, 50);
        },
        close: function () {
            el('docChatDrawer').classList.add('hidden');
        },
        ask: async function () {
            var q = el('docChatQ').value.trim();
            if (!q) return;
            state.messages.push({ role: 'user', text: q });
            state.messages.push({ role: 'loading' });
            el('docChatQ').value = '';
            el('docChatBtn').disabled = true;
            render();

            try {
                var form = new FormData();
                form.append('fileId', state.fileId);
                form.append('question', q);
                form.append('__RequestVerificationToken', token);
                var r = await fetch('/Ai/AskDocument', { method: 'POST', body: form });
                var data = await r.json();

                state.messages.pop(); // remove loading
                if (data.ok) state.messages.push({ role: 'assistant', text: data.answer });
                else state.messages.push({ role: 'error', text: data.error || 'Bilinmeyen hata' });
            } catch (e) {
                state.messages.pop();
                state.messages.push({ role: 'error', text: 'Ağ hatası: ' + e.message });
            } finally {
                el('docChatBtn').disabled = false;
                render();
                el('docChatQ').focus();
            }
        }
    };
})();
</script>
}
