@model List<Mosaik.Models.DocumentVersion>
@{
    Layout = "_AppLayout";
    var file = ViewBag.File as Mosaik.Models.ContractFile;
    var userNames = ViewBag.UserNames as Dictionary<int, string> ?? new();
    ViewData["Title"] = "Versiyon Geçmişi";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/">Ana Sayfa</a>
        <a href="/Documents">Belgeler</a>
        <span aria-current="page">Versiyon Geçmişi</span>
    </nav>
}

@section TopActions {
    <a href="/Documents" class="btn">Geri Dön</a>
}

<div class="hero">
    <h1><i class="fas fa-clock-rotate-left" aria-hidden="true"></i> Versiyon Geçmişi</h1>
    <p class="sub">
        <span class="mono">@file?.FileName</span>
        <span class="pill">güncel v@(file?.Version)</span>
        <span class="mono">@Model.Count arşiv</span>
    </p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="fas fa-folder-open" aria-hidden="true"></i>
        <h3>Arşivlenmiş versiyon yok</h3>
        <p>Bu belgeye yeni versiyon yüklendiğinde eski kopya burada listelenir.</p>
    </div>
}
else
{
    <div class="content-card">
        <table class="dt">
            <thead>
                <tr>
                    <th scope="col">Versiyon</th>
                    <th scope="col">Dosya Adı</th>
                    <th scope="col">Boyut</th>
                    <th scope="col">Arşivlenme</th>
                    <th scope="col">Arşivleyen</th>
                    <th scope="col" class="ta-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td><span class="pill">v@(v.VersionNumber)</span></td>
                        <td><span class="mono">@v.FileName</span></td>
                        <td>@((v.FileSize / 1024.0).ToString("N0")) KB</td>
                        <td><span class="ago">@v.ArchivedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span></td>
                        <td>@(userNames.GetValueOrDefault(v.ArchivedById, "—"))</td>
                        <td class="ta-right">
                            <a class="btn ghost sm" href="/Documents/DownloadVersion?versionId=@v.Id">
                                <i class="fas fa-download text-[9px]" aria-hidden="true"></i> İndir
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_FooterHint", (string?)$"{Model.Count} arşivlenmiş versiyon")
