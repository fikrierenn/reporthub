@model Mosaik.ViewModels.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Giriş - BKM Rapor Paneli";
}

<div class="form-header">
    <h2>Giriş Yap</h2>
    <div class="sub">Hesabınızla devam edin</div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div role="alert" class="alert error">
        <i class="fas fa-circle-exclamation alert-icon" aria-hidden="true"></i>
        Giriş bilgileri hatalı.
    </div>
}

@if (ViewData["LoginWarning"] is string warning && !string.IsNullOrWhiteSpace(warning))
{
    <div role="alert" class="alert warn">
        <i class="fas fa-triangle-exclamation alert-icon" aria-hidden="true"></i>
        @warning
    </div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <div class="field">
        <label class="lab" for="Username">Kullanıcı Adı</label>
        <input asp-for="Username" id="Username" required autocomplete="username" class="inp" placeholder="DOMAIN\kullanici veya kullanici" />
        <p class="help-text">AD kullanıcıları DOMAIN\kullanici formatını kullanır.</p>
    </div>

    @* Plan 04 F2.3 (28 Nisan): _PasswordInput partial — DRY (Profile + Login ortak). *@
    @await Html.PartialAsync("_PasswordInput", new Mosaik.ViewModels.PasswordInputViewModel {
        Id = "Password",
        Name = "Password",
        Label = "Şifre",
        Placeholder = "Şifrenizi girin",
        Autocomplete = "current-password",
        Required = true
    })

    <button type="submit" class="btn primary block">
        <i class="fas fa-right-to-bracket text-[10px]" aria-hidden="true"></i>
        Giriş Yap
    </button>
</form>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('Username');
            if (!input || input.value) {
                return;
            }

            fetch('/Login/WindowsIdentity', { credentials: 'include' })
                .then(function (response) {
                    return response.ok ? response.json() : null;
                })
                .then(function (data) {
                    if (data && data.username) {
                        input.value = data.username;
                    }
                })
                .catch(function () { /* AD probe sessizce baris */ });
        })();
    </script>
}
