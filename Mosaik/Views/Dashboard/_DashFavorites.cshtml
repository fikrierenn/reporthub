@model Mosaik.ViewModels.DashboardViewModel

@if (!Model.FavoriteReports.Any())
{
    <div class="empty-state paper-dashed">
        <i class="fas fa-folder-open empty-state__icon" aria-hidden="true"></i>
        <p>Henüz erişilebilir rapor yok. Yöneticinizden rol veya rapor erişimi isteyin.</p>
    </div>
}
else
{
    <div class="quick-grid">
        @foreach (var report in Model.FavoriteReports)
        {
            <a href="/Reports/Run?reportId=@report.ReportId" class="qcard">
                <div class="row1">
                    <span class="type-chip type-dash">Dashboard</span>
                    <span class="qcard__id">#@report.ReportId</span>
                </div>
                <h3>@report.Title</h3>
                <div class="sub">@(string.IsNullOrWhiteSpace(report.Description) ? (report.DataSource?.Title ?? report.DataSourceKey) : report.Description)</div>
                <div class="meta">
                    <span class="ago">@(report.DataSource?.Title ?? report.DataSourceKey)</span>
                    <span class="run">Aç <i class="fas fa-arrow-right text-[10px]" aria-hidden="true"></i></span>
                </div>
            </a>
        }
    </div>
}
