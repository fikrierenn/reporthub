@model Mosaik.ViewModels.DashboardViewModel
@using System.Globalization
@{
    var tr = new CultureInfo("tr-TR");
    var t = Model.TodaysCircular;
    var saatNow = DateTime.Now.Hour;
    var bugun = DateTime.Now.ToString("dd MMMM yyyy dddd", tr);
}

<div class="section-title">
    <h2>Bugünün Tamimi</h2>
    <a href="/Circular/Circular" class="more">Tüm tamimler <i class="fas fa-chevron-right text-[10px]"></i></a>
</div>

@if (t != null)
{
    <div class="quick-grid" style="margin-bottom:24px;">
        <div class="qcard" style="position:relative; border-color:var(--accent-soft);">
            <div class="row1">
                <span class="type-chip type-dash">Tamim</span>
                <span class="mono" style="font-size:10.5px; color:var(--ink-4); margin-left:auto;">@t.CircularNumber</span>
                <span class="badge" style="background:var(--accent); color:#fff; font-size:10px; font-weight:600; padding:2px 7px; border-radius:999px; margin-left:6px;">Bugün</span>
            </div>
            <a href="/Circular/Circular/Details/@t.Id" style="text-decoration:none; color:inherit;">
                <h3>@t.Title</h3>
                <div class="sub">
                    <i class="fas fa-layer-group" style="font-size:9px; color:var(--ink-4); margin-right:3px;"></i>
                    @Model.TodaysBlockCount blok
                    @if (Model.TodaysUrgentCount > 0)
                    {
                        <span style="margin-left:8px; color:var(--accent); font-weight:600;">
                            <i class="fas fa-bolt" style="font-size:9px;"></i> @Model.TodaysUrgentCount acil
                        </span>
                    }
                </div>
                <div class="meta">
                    <span class="ago" style="font-family:'JetBrains Mono',monospace;">
                        <i class="fas fa-clock" style="font-size:9px; color:var(--ink-4); margin-right:3px;"></i>
                        @t.PublishedAt.ToString("HH:mm")
                    </span>
                    <span class="run">Aç <i class="fas fa-arrow-right text-[10px]"></i></span>
                </div>
            </a>
        </div>
    </div>
}
else if (saatNow < 17)
{
    <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:18px 22px; margin-bottom:24px; display:flex; align-items:center; gap:14px;">
        <div style="width:40px; height:40px; border-radius:8px; background:rgba(245,158,11,.12); display:grid; place-items:center; flex-shrink:0;">
            <i class="fas fa-hourglass-half" style="color:#92400e; font-size:16px;"></i>
        </div>
        <div style="flex:1;">
            <div style="font-size:13.5px; font-weight:600; color:var(--ink-0); margin-bottom:2px;">Bugünün tamimi 17:00'de yayınlanacak</div>
            <div style="font-size:12px; color:var(--ink-3);" class="mono">@bugun</div>
        </div>
        <a href="/Circular/Block/Create" class="btn">
            <i class="fas fa-plus text-[10px]"></i>
            Block Yaz
        </a>
    </div>
}
else
{
    <div style="background:var(--paper); border:1px dashed var(--line); border-radius:10px; padding:18px 22px; margin-bottom:24px; display:flex; align-items:center; gap:14px;">
        <div style="width:40px; height:40px; border-radius:8px; background:var(--line-2); display:grid; place-items:center; flex-shrink:0;">
            <i class="fas fa-inbox" style="color:var(--ink-3); font-size:16px;"></i>
        </div>
        <div style="flex:1;">
            <div style="font-size:13.5px; font-weight:600; color:var(--ink-0); margin-bottom:2px;">Bugün için tamim yayınlanmadı</div>
            <div style="font-size:12px; color:var(--ink-3);" class="mono">@bugun</div>
        </div>
        <a href="/Circular/Circular" class="btn">
            <i class="fas fa-list text-[10px]"></i>
            Geçmiş
        </a>
    </div>
}
