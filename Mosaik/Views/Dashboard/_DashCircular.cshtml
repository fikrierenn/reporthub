@model Mosaik.ViewModels.DashboardViewModel
@using System.Globalization
@{
    var tr = new CultureInfo("tr-TR");
    var t = Model.TodaysCircular;
    var saatNow = DateTime.Now.Hour;
    var bugun = DateTime.Now.ToString("dd MMMM yyyy dddd", tr);
}

<div class="section-title">
    <h2>Bugünün Tamimi</h2>
    <a href="/Circular/Circular" class="more">Tüm tamimler <i class="fas fa-chevron-right text-[10px]"></i></a>
</div>

@if (t != null)
{
    <div class="quick-grid mb-18">
        <div class="qcard accent-soft">
            <div class="row1">
                <span class="type-chip type-dash">Tamim</span>
                <span class="qcard__id">@t.CircularNumber</span>
                <span class="qcard__date-badge">Bugün</span>
            </div>
            <a href="/Circular/Circular/Details/@t.Id" class="qcard__link">
                <h3>@t.Title</h3>
                <div class="sub">
                    <i class="fas fa-layer-group qcard__sub-icon"></i>
                    @Model.TodaysBlockCount blok
                    @if (Model.TodaysUrgentCount > 0)
                    {
                        <span class="qcard__urgent">
                            <i class="fas fa-bolt"></i> @Model.TodaysUrgentCount acil
                        </span>
                    }
                </div>
                <div class="meta">
                    <span class="ago">
                        <i class="fas fa-clock qcard__meta-icon"></i>
                        @t.PublishedAt.ToString("HH:mm")
                    </span>
                    <span class="run">Aç <i class="fas fa-arrow-right text-[10px]"></i></span>
                </div>
            </a>
        </div>
    </div>
}
else if (saatNow < 17)
{
    <div class="dash-info-card">
        <div class="dash-info-card__icon tone-warn">
            <i class="fas fa-hourglass-half"></i>
        </div>
        <div class="dash-info-card__body">
            <div class="dash-info-card__title">Bugünün tamimi 17:00'de yayınlanacak</div>
            <div class="dash-info-card__desc mono">@bugun</div>
        </div>
        <a href="/Circular/Block/Create" class="btn">
            <i class="fas fa-plus text-[10px]"></i>
            Block Yaz
        </a>
    </div>
}
else
{
    <div class="dash-info-card dashed">
        <div class="dash-info-card__icon tone-neutral">
            <i class="fas fa-inbox"></i>
        </div>
        <div class="dash-info-card__body">
            <div class="dash-info-card__title">Bugün için tamim yayınlanmadı</div>
            <div class="dash-info-card__desc mono">@bugun</div>
        </div>
        <a href="/Circular/Circular" class="btn">
            <i class="fas fa-list text-[10px]"></i>
            Geçmiş
        </a>
    </div>
}
