@model Mosaik.ViewModels.DashboardViewModel
@using System.Globalization
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Genel Bakış - BKM Rapor Paneli";
    ViewData["PageTitle"] = "Genel Bakış";

    var trCulture = new CultureInfo("tr-TR");
    // ADR-006 — UTC convention. View'da Turkey TZ'ye convert.
    var trTz = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows() ? "Turkey Standard Time" : "Europe/Istanbul");
    var nowLocal = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, trTz);
    var todayStr = nowLocal.ToString("d MMMM yyyy, dddd", trCulture);
    var firstName = !string.IsNullOrWhiteSpace(Model.FullName)
        ? Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.User
        : Model.User;

    string GreetingByHour()
    {
        var h = nowLocal.Hour;
        if (h < 6) return "İyi geceler";
        if (h < 12) return "Günaydın";
        if (h < 18) return "İyi günler";
        return "İyi akşamlar";
    }

    var statusDotClass = Model.SystemStatusKind switch
    {
        "warn" => "warn",
        "err"  => "err",
        _      => "ok"
    };
}

<div class="hero">
    <h1>@GreetingByHour(), @firstName 👋</h1>
    <div class="sub">
        <span class="mono">@todayStr</span>
        @if (Model.IsAdminView)
        {
            <span class="pill"><span class="dot @statusDotClass"></span>@Model.SystemStatus</span>
            <span class="pill mono">@Model.DataSourceStatus</span>
        }
        else if (Model.UserRoles.Any())
        {
            <span class="pill mono">@string.Join(" · ", Model.UserRoles)</span>
        }
    </div>
</div>

@await Html.PartialAsync("_DashKpi", Model)

@await Html.PartialAsync("_DashWorkflow", Model)

@await Html.PartialAsync("_DashCircular", Model)

<div class="section-title">
    <h2>Bugünün Özeti</h2>
    <a href="/Logs" class="more">Detaylı analiz <i class="fas fa-chevron-right text-[10px]"></i></a>
</div>

@await Html.PartialAsync("_DashMiniCharts", Model)

<div class="section-title">
    <h2>Hızlı Erişim</h2>
    <a href="/Reports" class="more">Tüm raporları gör <i class="fas fa-chevron-right text-[10px]"></i></a>
</div>

@await Html.PartialAsync("_DashFavorites", Model)

@if (Model.IsAdminView)
{
    <div class="section-title">
        <h2>Son Aktivite</h2>
        <a href="/Logs" class="more">Tüm log <i class="fas fa-chevron-right text-[10px]"></i></a>
    </div>

    @await Html.PartialAsync("_DashActivity", Model)
}

@await Html.PartialAsync("_FooterHint", (string?)null)
