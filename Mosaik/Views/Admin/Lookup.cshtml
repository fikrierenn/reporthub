@model List<Mosaik.Core.Lookup.DictionaryType>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Lookup Yönetimi - Mosaik";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Ana Sayfa</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Lookup</span>
    </nav>
}

@section TopActions {
    <a href="/Admin" class="btn ghost">
        <i class="fas fa-arrow-left text-[10px]"></i>
        Geri
    </a>
}

<div class="hero">
    <h1>Lookup Yönetimi</h1>
    <div class="sub">
        <span>Sistem genelinde kullanılan sabit değer listeleri</span>
        <span class="pill"><span class="mono">@Model.Count</span> tip</span>
    </div>
</div>

@if (TempData["Message"] != null)
{
    @await Html.PartialAsync("_AlertMessage", (TempData["MessageType"]?.ToString() ?? "success", TempData["Message"]!.ToString()!))
}

@foreach (var type in Model)
{
    <div class="form-section-card wide">
        <div class="form-section-head">
            <div class="lookup-head-row">
                <div>
                    <span class="form-section-head__title">@type.Name</span>
                    <span class="mono text-muted ml-4 text-xs">@type.Code</span>
                </div>
                <span class="mono text-muted text-xs">@type.Values.Count(v => v.IsActive) aktif değer</span>
            </div>
        </div>
        <div class="form-section-body stack">
            @if (!type.Values.Any())
            {
                <p class="text-muted text-xs">Henüz değer eklenmemiş.</p>
            }
            else
            {
                <table class="dt mb-8">
                    <thead>
                        <tr>
                            <th scope="col">Kod</th>
                            <th scope="col">Etiket</th>
                            <th scope="col">Sıra</th>
                            <th scope="col" class="th-right">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var val in type.Values.OrderBy(v => v.DisplayOrder))
                        {
                            <tr>
                                <td><span class="mono">@val.Code</span></td>
                                <td>@val.Label</td>
                                <td>@val.DisplayOrder</td>
                                <td class="td-right">
                                    <form method="post" action="/Admin/LookupToggleValue" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="valueId" value="@val.Id" />
                                        <input type="hidden" name="active" value="@(!val.IsActive ? "true" : "false")" />
                                        <button type="submit" class="btn sm @(val.IsActive ? "danger" : "")">
                                            @(val.IsActive ? "Pasif Et" : "Aktif Et")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @* TODO(Plan 25.1): <details>/summary için utility class yok — minimum inline kalıyor (cursor + user-select). *@
            <details class="lookup-add-details">
                <summary class="lookup-add-summary">+ Yeni Değer Ekle</summary>
                <form method="post" action="/Admin/LookupAddValue" class="lookup-add-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="typeId" value="@type.Id" />
                    <div class="field">
                        <label class="lab">Kod</label>
                        <input class="inp inp-code" type="text" name="code" placeholder="camelCase" required />
                    </div>
                    <div class="field">
                        <label class="lab">Etiket</label>
                        <input class="inp inp-label" type="text" name="label" placeholder="Türkçe görünen ad" required />
                    </div>
                    <div class="field">
                        <label class="lab">Sıra</label>
                        <input class="inp inp-order" type="number" name="displayOrder" value="@(type.Values.Any() ? type.Values.Max(v => v.DisplayOrder) + 10 : 10)" />
                    </div>
                    <button type="submit" class="btn primary">Ekle</button>
                </form>
            </details>
        </div>
    </div>
}

@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", new Mosaik.ViewModels.Ui.EmptyStateViewModel
    {
        Icon = "fa-list",
        Title = "Lookup tipi yok",
        Message = "DictionaryTypes tablosuna kayıt eklendiğinde burada görünür."
    })
}

@* Plan 33: utility'ler components.css'e taşındı (lookup-head-row, inp-code/label/order, th-right/td-right, inline-form). *@
