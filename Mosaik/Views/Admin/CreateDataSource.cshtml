@model Mosaik.ViewModels.AdminDataSourceFormViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Yeni Veri Kaynağı - Mosaik";
    ViewData["PageTitle"] = "Yeni Veri Kaynağı";
    var ds = Model.DataSource;
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Mosaik</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=datasources">Veri Kaynakları</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Yeni</span>
    </nav>
}

@section TopActions {
    <a href="/Admin?tab=datasources" class="btn">
        <i class="fas fa-xmark icon-xs"></i> İptal
    </a>
}

<div class="hero">
    <h1>Yeni Veri Kaynağı</h1>
    <div class="sub">
        <span>Yeni veritabanı bağlantısı oluşturun</span>
    </div>
</div>

<form method="post" onsubmit="return validateForm()" novalidate>
    @Html.AntiForgeryToken()

    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-tag icon-mr"></i> Genel Bilgiler
            </h2>
        </div>
        <div class="form-section-body">
            <div class="grid-2-1">
                <div class="field">
                    <label class="lab" for="DataSourceKey">Anahtar <span class="text-danger">*</span></label>
                    <input type="text" id="DataSourceKey" name="DataSourceKey" value="@ds.DataSourceKey" required class="inp mono"
                           placeholder="örn: MAIN, IK, MALI" />
                    <p class="help-text">Benzersiz anahtar — büyük harf önerilir</p>
                </div>
                <div class="field">
                    <label class="lab" for="Title">Başlık <span class="text-danger">*</span></label>
                    <input type="text" id="Title" name="Title" value="@ds.Title" required class="inp" placeholder="örn: Ana Veritabanı" />
                </div>
            </div>
        </div>
    </div>

    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-server icon-mr"></i> Veritabanı Bağlantı Ayarları
            </h2>
        </div>
        <div class="form-section-body stack">
            <div class="grid-2col">
                <div class="field">
                    <label class="lab" for="serverName">Sunucu Adı <span class="text-danger">*</span></label>
                    <input type="text" id="serverName" value="BT-FIKRI\SQLEXPRESS" class="inp" placeholder="örn: BT-FIKRI\SQLEXPRESS" />
                </div>
                <div class="field">
                    <label class="lab" for="databaseName">Veritabanı Adı <span class="text-danger">*</span></label>
                    <input type="text" id="databaseName" value="Mosaik" class="inp" placeholder="örn: Mosaik" />
                    <div class="btn-group mt-8">
                        <button type="button" onclick="setDatabase('Mosaik')" class="btn ghost sm">Mosaik</button>
                        <button type="button" onclick="setDatabase('BKM_GENEL')" class="btn ghost sm">BKM_GENEL</button>
                        <button type="button" onclick="setDatabase('MainDB')" class="btn ghost sm">MainDB</button>
                        <button type="button" onclick="setDatabase('MaliDB')" class="btn ghost sm">MaliDB</button>
                    </div>
                </div>
            </div>

            <div class="field">
                <label class="lab">Kimlik Doğrulama</label>
                <div class="grid-2col">
                    <label class="opt-card" onclick="selectAuth('windows')">
                        <input type="radio" name="authType" value="windows" id="authWindows" />
                        <div>
                            <div class="t">Windows Authentication</div>
                            <div class="s">Güvenli, şifre gerektirmez</div>
                        </div>
                    </label>
                    <label class="opt-card" onclick="selectAuth('sql')">
                        <input type="radio" name="authType" value="sql" id="authSql" checked />
                        <div>
                            <div class="t">SQL Server Authentication</div>
                            <div class="s">Kullanıcı adı + şifre ile</div>
                        </div>
                    </label>
                </div>
            </div>

            <div id="sqlAuthFields" class="grid-2col">
                <div class="field">
                    <label class="lab" for="username">Kullanıcı Adı</label>
                    <input type="text" id="username" value="sa" class="inp" />
                </div>
                <div class="field">
                    <label class="lab" for="password">Şifre</label>
                    <input type="password" id="password" value="" class="inp" autocomplete="off" />
                </div>
            </div>

            <div class="field">
                <label class="lab" for="connString">
                    Oluşturulan Bağlantı String
                    <i class="fas fa-circle-info icon-xs text-muted ml-4" title="Bu alan otomatik oluşturulur"></i>
                </label>
                <textarea id="connString" name="ConnString" required rows="3" readonly class="inp json disabled-mono"></textarea>
            </div>
        </div>
    </div>

    <div class="toggle-row">
        <input type="hidden" name="IsActive" value="false" />
        <input type="checkbox" name="IsActive" value="true" id="dsActive" @(ds.IsActive ? "checked" : "") class="checkbox checkbox-lg" />
        <label for="dsActive" class="lab inline">Veri kaynağını aktif yap</label>
    </div>

    <div class="action-row wide">
        <a href="/Admin?tab=datasources" class="btn ghost">
            <i class="fas fa-arrow-left icon-xs"></i> Geri Dön
        </a>
        <div class="btn-group">
            <button type="button" class="btn">
                <i class="fas fa-plug icon-xs"></i> Bağlantıyı Test Et
            </button>
            <button type="submit" class="btn primary">
                <i class="fas fa-check icon-xs"></i> Veri Kaynağını Kaydet
            </button>
        </div>
    </div>
</form>

<script src="~/assets/js/admin-datasource-form.js"></script>
