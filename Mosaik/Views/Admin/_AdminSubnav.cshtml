@{
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var tab = Context.Request.Query["tab"].FirstOrDefault() ?? "";
    if (string.IsNullOrEmpty(tab) && act.Equals("Index", StringComparison.OrdinalIgnoreCase))
        tab = "datasources";

    string NavActive(string key) =>
        act.Equals(key, StringComparison.OrdinalIgnoreCase) ||
        (act.Equals("Index", StringComparison.OrdinalIgnoreCase) && tab == key)
            ? "active" : "";
}
<nav class="subnav subnav-grouped" aria-label="Yönetim alt-navigasyonu">
    @* Grup 1: İçerik & Veri *@
    <a href="/Admin?tab=datasources" class="@NavActive("datasources")" title="Veri Kaynakları">
        <i class="fas fa-database"></i>
        <span>Veri Kaynakları</span>
    </a>
    <a href="/Admin?tab=reports" class="@NavActive("reports")" title="Rapor Kataloğu">
        <i class="fas fa-file-lines"></i>
        <span>Raporlar</span>
    </a>
    <a href="/Admin?tab=filters" class="@NavActive("filters")" title="Filtre Tanımları">
        <i class="fas fa-filter"></i>
        <span>Filtreler</span>
    </a>
    <a href="/Admin/Lookup" class="@NavActive("Lookup")" title="Sözlükler / Lookup Listeleri">
        <i class="fas fa-list"></i>
        <span>Lookup</span>
    </a>

    <span class="subnav-sep" aria-hidden="true"></span>

    @* Grup 2: Erişim *@
    <a href="/Admin?tab=users" class="@NavActive("users")" title="Kullanıcılar">
        <i class="fas fa-users"></i>
        <span>Kullanıcılar</span>
    </a>
    <a href="/Admin?tab=roles" class="@NavActive("roles")" title="Roller">
        <i class="fas fa-shield-halved"></i>
        <span>Roller</span>
    </a>
    <a href="/Admin?tab=groups" class="@NavActive("groups")" title="Rapor Grupları">
        <i class="fas fa-folder-tree"></i>
        <span>Gruplar</span>
    </a>

    <span class="subnav-sep" aria-hidden="true"></span>

    @* Grup 3: Yapı *@
    <a href="/Admin/OrgChart" class="@NavActive("OrgChart")" title="Organizasyon Şeması">
        <i class="fas fa-sitemap"></i>
        <span>Organizasyon</span>
    </a>

    <span class="subnav-sep" aria-hidden="true"></span>

    @* Grup 4: Sistem *@
    <a href="/Admin/BrandSettings" class="@NavActive("BrandSettings")" title="Marka Ayarları">
        <i class="fas fa-palette"></i>
        <span>Marka</span>
    </a>
    <a href="/Admin/Modules" class="@NavActive("Modules")" title="Modüller">
        <i class="fas fa-puzzle-piece"></i>
        <span>Modüller</span>
    </a>
    <a href="/Admin/AiSettings" class="@NavActive("AiSettings")" title="Yapay Zeka Ayarları">
        <i class="fas fa-wand-magic-sparkles"></i>
        <span>AI</span>
    </a>
</nav>
