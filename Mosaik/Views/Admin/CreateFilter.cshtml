@model Mosaik.ViewModels.AdminFilterDefinitionFormViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Yeni Filtre - BKM Rapor Paneli";
    ViewData["PageTitle"] = "Yeni Filtre";
    var message = Model.Message ?? "";
    var messageType = Model.MessageType ?? "";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=filters">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=filters">Filtreler</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Yeni</span>
    </nav>
}

@section TopActions {
    <a href="/Admin?tab=filters" class="btn">
        <i class="fas fa-xmark icon-xs" aria-hidden="true"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Yeni Filtre</h1>
    <div class="sub">
        <span>FilterDefinition oluştur — DataSource bazlı veya cross-cutting</span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    @await Html.PartialAsync("_AlertMessage", (messageType == "success" ? "success" : "error", message))
}

<div class="form-section-card wide">
    <div class="form-section-head">
        <h2 class="form-section-head__title">
            <i class="fas fa-filter icon-mr" aria-hidden="true"></i>
            Filter Tanımı
        </h2>
        <p class="form-section-head__sub">Aşağıdaki bilgileri doldurun</p>
    </div>

    @await Html.PartialAsync("_AdminFilterFormBody", Model)
</div>
