@model Mosaik.ViewModels.AdminIndexViewModel

<div class="tab-toolbar">
    <div class="tab-toolbar__desc">Kullanıcıları ekleyin, güncelleyin ve pasif edin</div>
    <a href="/Admin/CreateUser" class="btn primary">
        <i class="fas fa-user-plus text-[10px]" aria-hidden="true"></i>
        Yeni Kullanıcı
    </a>
</div>

<div class="paper-card clip">
    <table class="dt">
        <thead>
            <tr>
                <th scope="col">Kullanıcı</th>
                <th scope="col">Ad Soyad</th>
                <th scope="col">E-posta</th>
                <th scope="col">Roller</th>
                <th scope="col">Durum</th>
                <th scope="col">Son Giriş</th>
                <th scope="col" class="col-right">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td><span class="mono">@user.Username</span></td>
                    <td>@user.FullName</td>
                    <td class="cell-muted">@user.Email</td>
                    <td class="text-sm">@(Model.UserRoleNames.TryGetValue(user.UserId, out var _roleNames) ? string.Join(", ", _roleNames) : "-")</td>
                    <td>
                        <span class="status @(user.IsActive ? "ok" : "err")">@(user.IsActive ? "Aktif" : "Pasif")</span>
                    </td>
                    <td><span class="ago">@(user.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</span></td>
                    <td class="cell-right">
                        <div class="row-actions">
                            <a href="/Admin/EditUser/@user.UserId" class="btn ghost sm">
                                <i class="fas fa-pen text-[9px]" aria-hidden="true"></i>
                                Düzenle
                            </a>
                            <form method="post" class="inline-form" onsubmit="return confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="action" value="delete_user" />
                                <input type="hidden" name="id" value="@user.UserId" />
                                <button type="submit" class="btn sm danger">
                                    <i class="fas fa-trash text-[9px]" aria-hidden="true"></i>
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
