@model Mosaik.ViewModels.AdminGroupFormViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Grup Düzenle - BKM Rapor Paneli";
    ViewData["PageTitle"] = "Grup Düzenle";
    var message = Model.Message ?? "";
    var messageType = Model.MessageType ?? "";
    var group = Model.Group ?? new Mosaik.Models.ReportGroup();
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=groups">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=groups">Gruplar</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">@(string.IsNullOrWhiteSpace(group.Name) ? "Düzenle" : group.Name)</span>
    </nav>
}

@section TopActions {
    <a href="/Admin?tab=groups" class="btn">
        <i class="fas fa-xmark text-[10px]"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Grup Düzenle</h1>
    <div class="sub">
        <span>Grup bilgilerini güncelleyin</span>
        <span class="pill"><span class="mono">#@group.GroupId</span></span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div role="alert" class="alert @(messageType == "success" ? "success" : "error")">
        <i class="fas @(messageType == "success" ? "fa-check-circle" : "fa-exclamation-circle") icon-mr"></i>
        @message
    </div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <div class="form-section-card narrow">
        <div class="form-section-head">
            <h2><i class="fas fa-folder-tree text-muted"></i> Grup Bilgileri</h2>
            <div class="help-text">Değişiklikleri kaydedin</div>
        </div>

        <div class="form-section-body">
            <div class="grid-2col">
                <div class="field">
                    <label class="lab">Grup Adı <span class="req">*</span></label>
                    <input type="text" name="Name" value="@group.Name" required class="inp" />
                </div>
                <div class="field">
                    <label class="lab">Açıklama</label>
                    <input type="text" name="Description" value="@group.Description" class="inp" />
                </div>
            </div>

            <div class="checkbox-row mt-14">
                <input type="hidden" name="IsActive" value="false" />
                <input type="checkbox" name="IsActive" value="true" id="groupActive" @(group.IsActive ? "checked" : "") />
                <label for="groupActive" class="lab">Grubu aktif yap</label>
            </div>
        </div>
    </div>

    <div class="action-row narrow">
        <a href="/Admin?tab=groups" class="btn ghost">
            <i class="fas fa-arrow-left text-[10px]"></i>
            Geri Dön
        </a>
        <button type="submit" class="btn primary">
            <i class="fas fa-check text-[10px]"></i>
            Grubu Güncelle
        </button>
    </div>
</form>
