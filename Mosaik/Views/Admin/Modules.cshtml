@model List<Mosaik.Models.AppModule>
@{
    ViewData["Title"] = "Modüller";
    Layout = "_AppLayout";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Ana Sayfa</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Modüller</span>
    </nav>
}

@section TopActions {
    <a href="/Admin" class="btn">
        <i class="fas fa-xmark icon-xs"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Yönetim Paneli</h1>
    <div class="sub"><span>Marka, modül ve sistem yapılandırması</span></div>
</div>

@if (TempData["Message"] != null)
{
    @await Html.PartialAsync("_AlertMessage", (TempData["MessageType"]?.ToString() ?? "info", TempData["Message"]?.ToString() ?? ""))
}

<form method="post" action="/Admin/Modules">
    @Html.AntiForgeryToken()

    <div class="form-section-card narrow">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-puzzle-piece icon-mr"></i>
                Aktif Modüller
            </h2>
            <p class="form-section-head__sub">Sidebar'da görünecek modülleri seçin</p>
        </div>

        <div class="form-section-body stack">
            @if (!Model.Any())
            {
                <p class="text-muted">Henüz modül tanımlanmamış.</p>
            }
            else
            {
                @foreach (var module in Model)
                {
                    @* TODO inline-style-guard: module-row utility (paper card + hover) components.css'e eklenmeli *@
                    <label class="toggle-row">
                        <input type="checkbox" name="enabledIds" value="@module.ModuleId"
                               @(module.IsEnabled ? "checked" : "")
                               class="checkbox checkbox-lg" />
                        <span>
                            <span class="d-block">@module.DisplayName</span>
                            <span class="mono text-xs text-muted">@module.ModuleKey</span>
                        </span>
                    </label>
                }
            }
        </div>
    </div>

    <div class="action-row narrow">
        <a href="/Admin" class="btn ghost">
            <i class="fas fa-arrow-left icon-xs"></i> Geri Dön
        </a>
        <button type="submit" class="btn primary">
            <i class="fas fa-save icon-xs"></i> Kaydet
        </button>
    </div>
</form>
