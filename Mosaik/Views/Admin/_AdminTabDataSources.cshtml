@model Mosaik.ViewModels.AdminIndexViewModel
@functions {
    private static string MaskConnString(string? connString)
    {
        if (string.IsNullOrWhiteSpace(connString)) return string.Empty;
        const int keepStart = 8;
        const int keepEnd = 6;
        if (connString.Length <= keepStart + keepEnd + 3)
        {
            return new string('*', connString.Length);
        }
        return connString.Substring(0, keepStart) + "..." + connString.Substring(connString.Length - keepEnd);
    }
}

<div class="tab-toolbar">
    <div class="tab-toolbar__desc">Veritabanı bağlantılarını yönetin</div>
    <a href="/Admin/CreateDataSource" class="btn primary">
        <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
        Yeni Veri Kaynağı
    </a>
</div>

<div class="paper-card clip">
    <table class="dt">
        <thead>
            <tr>
                <th scope="col">Anahtar</th>
                <th scope="col">Başlık</th>
                <th scope="col">Bağlantı</th>
                <th scope="col">Durum</th>
                <th scope="col" class="col-right">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ds in Model.DataSources)
            {
                <tr>
                    <td><span class="mono">@ds.DataSourceKey</span></td>
                    <td>@ds.Title</td>
                    <td class="cell-mono-sm">@MaskConnString(ds.ConnString)</td>
                    <td>
                        <span class="status @(ds.IsActive ? "ok" : "err")">@(ds.IsActive ? "Aktif" : "Pasif")</span>
                    </td>
                    <td class="cell-right">
                        <div class="row-actions">
                            <a href="/Admin/EditDataSource/@ds.DataSourceKey" class="btn ghost sm">
                                <i class="fas fa-pen text-[9px]" aria-hidden="true"></i>
                                Düzenle
                            </a>
                            <form method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="action" value="test_datasource" />
                                <input type="hidden" name="key" value="@ds.DataSourceKey" />
                                <button type="submit" class="btn ghost sm">
                                    <i class="fas fa-plug text-[9px]" aria-hidden="true"></i>
                                    Test
                                </button>
                            </form>
                            <form method="post" class="inline-form" onsubmit="return confirm('Bu veri kaynağını silmek istediğinizden emin misiniz?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="action" value="delete_datasource" />
                                <input type="hidden" name="key" value="@ds.DataSourceKey" />
                                <button type="submit" class="btn sm danger">
                                    <i class="fas fa-trash text-[9px]" aria-hidden="true"></i>
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
