@model List<Mosaik.Models.AiSettings>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Yapay Zeka Profilleri - Mosaik";
    ViewData["PageTitle"] = "Yapay Zeka Profilleri";
    var primaryEnabled = Model.Any(x => x.IsPrimary && x.IsEnabled && !string.IsNullOrEmpty(x.ApiKey));
    var fallbackCount = Model.Count(x => x.IsEnabled && !x.IsPrimary && !string.IsNullOrEmpty(x.ApiKey));
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Mosaik</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Yapay Zeka</span>
    </nav>
}

@section TopActions {
    <a href="/Admin/AiSettings/Edit" class="btn primary">
        <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
        Yeni Profil
    </a>
    <button type="button" class="icon-btn" title="Yardım" aria-label="Yardım">
        <i class="fas fa-circle-question" aria-hidden="true"></i>
    </button>
}

<div class="hero">
    <h1>Yapay Zeka Profilleri</h1>
    <div class="sub">
        <span>Birden fazla provider tanımlanabilir — birincil başarısız olursa fallback zinciri devreye girer</span>
        @if (primaryEnabled)
        {
            <span class="pill ok-tone"><span class="dot"></span>Birincil aktif · @fallbackCount fallback</span>
        }
        else
        {
            <span class="pill warn"><span class="dot"></span>Birincil profil yok / kapalı</span>
        }
    </div>
</div>

@if (TempData["Message"] != null)
{
    @await Html.PartialAsync("_AlertMessage", (TempData["MessageType"]?.ToString() ?? "error", TempData["Message"]?.ToString() ?? ""))
}

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-wand-magic-sparkles empty-state__icon" aria-hidden="true"></i>
        <h3>Henüz AI profili tanımlanmamış</h3>
        <p>İlk profili oluşturmak için <a href="/Admin/AiSettings/Edit" class="alert-link">yeni profil ekle</a>.</p>
    </div>
}
else
{
    <div class="paper-table">
        <table class="dt">
            <thead>
                <tr>
                    <th scope="col" class="th-w-30"></th>
                    <th scope="col">Ad</th>
                    <th scope="col">Provider / Model</th>
                    <th scope="col">Durum</th>
                    <th scope="col">Öncelik</th>
                    <th scope="col">Son Test</th>
                    <th scope="col" class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            @if (p.IsPrimary)
                            {
                                <i class="fas fa-star text-accent" title="Birincil" aria-hidden="true"></i>
                            }
                        </td>
                        <td>
                            <span class="fw-500 text-ink-1">@(p.Name ?? p.Provider)</span>
                            @if (!string.IsNullOrEmpty(p.ApiKey))
                            {
                                <span class="key-ind ok ml-4" title="Anahtar kayıtlı"><i class="fas fa-key" aria-hidden="true"></i></span>
                            }
                            else
                            {
                                <span class="key-ind err" title="Anahtar yok"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></span>
                            }
                        </td>
                        <td>
                            <span class="mono provider-mono">@p.Provider</span>
                            <span class="text-muted">·</span>
                            <span class="mono provider-mono">@p.Model</span>
                        </td>
                        <td>
                            @if (p.IsEnabled)
                            {
                                <span class="status ok"><i class="fas fa-check" aria-hidden="true"></i> Aktif</span>
                            }
                            else
                            {
                                <span class="status warn"><i class="fas fa-pause" aria-hidden="true"></i> Kapalı</span>
                            }
                        </td>
                        <td><span class="mono">@p.Priority</span></td>
                        <td>
                            @if (p.LastTestAt.HasValue)
                            {
                                <span class="ago test-ago @(p.LastTestSuccess ? "ok" : "err")">
                                    <i class="fas @(p.LastTestSuccess ? "fa-circle-check" : "fa-circle-xmark") icon-mr" aria-hidden="true"></i>
                                    @p.LastTestAt.Value.ToLocalTime().ToString("dd.MM HH:mm")
                                </span>
                            }
                            else
                            {
                                <span class="text-dim">—</span>
                            }
                        </td>
                        <td class="text-right">
                            <div class="btn-group">
                                @if (!p.IsPrimary && p.IsEnabled && !string.IsNullOrEmpty(p.ApiKey))
                                {
                                    <form method="post" action="/Admin/AiSettings/SetPrimary/@p.Id" class="form-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn ghost sm" title="Birincil yap">
                                            <i class="fas fa-star text-[9px]" aria-hidden="true"></i>
                                            Primary
                                        </button>
                                    </form>
                                }
                                <form method="post" action="/Admin/AiSettings/Test/@p.Id" class="form-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn ghost sm" title="Bağlantıyı test et">
                                        <i class="fas fa-bolt text-[9px]" aria-hidden="true"></i>
                                        Test
                                    </button>
                                </form>
                                <a href="/Admin/AiSettings/Edit/@p.Id" class="btn ghost sm">
                                    <i class="fas fa-pen text-[9px]" aria-hidden="true"></i>
                                    Düzenle
                                </a>
                                <form method="post" action="/Admin/AiSettings/Delete/@p.Id" class="form-inline"
                                      onsubmit="return confirm('@(p.Name ?? p.Provider) profilini sil?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn sm danger">
                                        <i class="fas fa-trash text-[9px]" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="help-card">
    <strong>Fallback nasıl çalışır?</strong>
    <ul>
        <li>İstek geldiğinde önce <strong>birincil (⭐)</strong> profil denenir.</li>
        <li>Birincil başarısız olursa (HTTP hata, quota dolu, key invalid vs) diğer <em>aktif</em> profiller <strong>öncelik sırasına göre</strong> (düşük → yüksek) denenir.</li>
        <li>Test butonu sadece o profili izole ederek çalıştırır (geçici olarak diğerleri devre dışı bırakılır).</li>
        <li>Provider değiştirsen bile diğer profiller saklı kalır — istediğin zaman birincil değiştirebilirsin.</li>
    </ul>
</div>

