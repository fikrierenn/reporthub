@model Mosaik.ViewModels.AdminUserFormViewModel
@using System.Linq
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Yeni Kullanıcı - BKM Rapor Paneli";
    ViewData["PageTitle"] = "Yeni Kullanıcı";
    var message = Model.Message ?? "";
    var messageType = Model.MessageType ?? "";
    var availableRoles = Model.AvailableRoles ?? new List<Mosaik.Models.Role>();
    var selectedRoleIds = Model.SelectedRoleIds ?? new HashSet<int>();
    var user = Model.User ?? new Mosaik.Models.User();
    var dataSources = Model.DataSources ?? new List<Mosaik.Models.DataSource>();
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=users">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=users">Kullanıcılar</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Yeni Kullanıcı</span>
    </nav>
}

@section TopActions {
    <a href="/Admin?tab=users" class="btn">
        <i class="fas fa-xmark text-[10px]" aria-hidden="true"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Yeni Kullanıcı</h1>
    <div class="sub">
        <span>Yeni kullanıcı oluşturun</span>
        <span class="pill">
            <i class="fas fa-circle-info text-[9px] text-muted" aria-hidden="true"></i>
            Roller + opsiyonel veri filtreleri
        </span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div role="alert" class="alert @(messageType == "success" ? "success" : "error")">
        <i class="fas @(messageType == "success" ? "fa-check-circle" : "fa-exclamation-circle")" aria-hidden="true"></i>
        @message
    </div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2>
                <i class="fas fa-user-plus text-muted" aria-hidden="true"></i>
                Kullanıcı Bilgileri
            </h2>
            <div class="help-text">Gerekli alanları doldurun</div>
        </div>

        <div class="form-section-body stack">
            <div class="grid-2col">
                <div class="field mb-0">
                    <label class="lab">Kullanıcı Adı <span class="req">*</span></label>
                    <input type="text" name="Username" value="@user.Username" required class="inp" placeholder="örn: admin_staging" />
                </div>
                <div class="field mb-0">
                    <label class="lab">Ad Soyad <span class="req">*</span></label>
                    <input type="text" name="FullName" value="@user.FullName" required class="inp" placeholder="örn: Staging Admin" />
                </div>
            </div>

            @{
                var firmaList = ViewBag.Firmas as List<Mosaik.Models.Firma> ?? new();
                var selectedFirmaIds = string.IsNullOrWhiteSpace(user.FirmaIds)
                    ? new HashSet<int>()
                    : user.FirmaIds.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .Select(s => int.TryParse(s, out var n) ? n : 0).Where(n => n > 0).ToHashSet();
            }
            <div class="grid-2col">
                <div class="field mb-0">
                    <label class="lab">E-posta</label>
                    <input type="email" name="Email" value="@user.Email" class="inp" placeholder="ornek@bkmkitap.com" />
                </div>
                <div class="field mb-0">
                    <label class="lab" for="personelno">Personel No (Zirve)</label>
                    <input id="personelno" name="Personelno" value="@user.Personelno" class="inp" maxlength="50" placeholder="4634-BKM" />
                    <p class="help-text">Org şemasıyla eşleme — izin onayı gerçek amire bu koddan gider.</p>
                </div>
                <div class="field mb-0">
                    <label class="lab">Firma Erişimi</label>
                    <div class="checkbox-grid">
                        @if (!firmaList.Any())
                        {
                            <div class="text-xs text-muted">Firma listesi tanımlı değil.</div>
                        }
                        else
                        {
                            foreach (var f in firmaList)
                            {
                                var isFirmaChecked = selectedFirmaIds.Contains(f.FirmaId);
                                <label class="checkbox-row">
                                    <input type="checkbox" name="SelectedFirmaIds" value="@f.FirmaId" @(isFirmaChecked ? "checked" : "")
                                           class="checkbox" />
                                    <span>@f.Name</span>
                                </label>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="field mb-0">
                <label class="lab">Roller <span class="req">*</span></label>
                <div class="checkbox-grid">
                    @if (!availableRoles.Any())
                    {
                        <div class="text-xs text-muted">Rol listesi tanımlı değil.</div>
                    }
                    else
                    {
                        foreach (var role in availableRoles)
                        {
                            var isChecked = selectedRoleIds.Contains(role.RoleId);
                            <label class="checkbox-row">
                                <input type="checkbox" name="SelectedRoles" value="@role.RoleId" @(isChecked ? "checked" : "")
                                       class="checkbox" />
                                <span>@role.Name</span>
                            </label>
                        }
                    }
                </div>
            </div>

            <div class="field mb-0">
                <label class="lab">Şifre <span class="req">*</span></label>
                <input type="password" id="Password" name="Password" required class="inp" placeholder="Şifre belirleyin" autocomplete="new-password" />
            </div>

            <div class="toolbar-row">
                <div class="checkbox-row">
                    <input type="hidden" name="IsAdUser" value="false" />
                    <input type="checkbox" id="IsAdUser" name="IsAdUser" value="true" @(user.IsAdUser ? "checked" : "")
                           class="checkbox" />
                    <label for="IsAdUser" class="lab inline">Windows AD kullanıcısı</label>
                    <span class="text-xs text-muted" title="AD kullanıcıları DOMAIN\\kullanici ile giriş yapar">
                        <i class="fas fa-circle-info" aria-hidden="true"></i>
                    </span>
                </div>
                <div class="checkbox-row">
                    <input type="hidden" name="IsActive" value="false" />
                    <input type="checkbox" id="userActive" name="IsActive" value="true" @(user.IsActive ? "checked" : "")
                           class="checkbox" />
                    <label for="userActive" class="lab inline">Kullanıcıyı aktif yap</label>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AdminUserDataFilterPanel", Model)

    <div class="action-row wide">
        <a href="/Admin?tab=users" class="btn ghost">
            <i class="fas fa-arrow-left text-[10px]" aria-hidden="true"></i>
            Geri Dön
        </a>
        <button type="submit" class="btn primary">
            <i class="fas fa-check text-[10px]" aria-hidden="true"></i>
            Kullanıcı Kaydet
        </button>
    </div>
</form>

@await Html.PartialAsync("_AdminUserAdToggleScript")
