@model Mosaik.ViewModels.AdminIndexViewModel

<div class="inline-create-card">
    <h2 class="inline-create-card__title">
        <i class="fas fa-circle-plus"></i>
        Yeni Rol Ekle
    </h2>
    <form method="post" class="inline-create-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="action" value="create_role" />
        <div class="field tight">
            <label class="lab">Rol Adı <span class="req">*</span></label>
            <input type="text" name="Name" class="inp" required />
        </div>
        <div class="field tight">
            <label class="lab">Açıklama</label>
            <input type="text" name="Description" class="inp" />
        </div>
        <div class="checkbox-cell">
            <input type="hidden" name="IsActive" value="false" />
            <input type="checkbox" name="IsActive" value="true" id="newRoleActive" checked class="checkbox" />
            <label for="newRoleActive" class="lab inline">Aktif</label>
        </div>
        <button type="submit" class="btn primary">
            <i class="fas fa-plus text-[10px]"></i>
            Ekle
        </button>
    </form>
</div>

<div class="paper-card clip">
    <table class="dt">
        <thead>
            <tr>
                <th>Rol</th>
                <th>Açıklama</th>
                <th>Durum</th>
                <th class="col-right">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model.Roles)
            {
                <tr>
                    <td class="cell-name">@role.Name</td>
                    <td class="cell-muted">@role.Description</td>
                    <td>
                        <span class="status @(role.IsActive ? "ok" : "err")">@(role.IsActive ? "Aktif" : "Pasif")</span>
                    </td>
                    <td class="cell-right">
                        <div class="row-actions">
                            <a href="/Admin/EditRole/@role.RoleId" class="btn ghost sm">
                                <i class="fas fa-pen text-[9px]"></i>
                                Düzenle
                            </a>
                            <form method="post" class="inline-form" onsubmit="return confirm('Rol silinsin mi?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="action" value="delete_role" />
                                <input type="hidden" name="id" value="@role.RoleId" />
                                <button type="submit" class="btn sm danger">
                                    <i class="fas fa-trash text-[9px]"></i>
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
