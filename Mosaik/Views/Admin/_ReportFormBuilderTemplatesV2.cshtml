@*
    V2 builder F-10 template picker modal.
    Builder root x-data="builderV2" component'i içinde render edilir; templatesMixin'den
    templateModal / templateOptions / applyTemplate / closeTemplateModal kullanılır.
    Topbar'daki "Şablondan Seç" butonu $dispatch('builder-template-open') ile açar.
*@

<div @@builder-template-open.window="openTemplateModal()" class="hidden"></div>

<div x-show="templateModal && templateModal.open" x-cloak
     class="builder-v2-modal-backdrop"
     @@click.self="closeTemplateModal()">
    <div class="builder-v2-modal md">
        <div class="m-head">
            <span class="m-title">
                <i class="fas fa-grip text-[12px]" aria-hidden="true"></i> Şablondan Seç
            </span>
            <button type="button" class="m-close" @@click="closeTemplateModal()" title="Kapat">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div class="m-body padded">
            <p class="builder-template-intro">
                Şablon seçince mevcut canvas yerini alır (boş canvas üzerine direkt yüklenir; doluyken onay ister).
                Yüklenen widget'lar <code>rs0</code> bağlamasıyla gelir; kolonları drawer'dan ayarlarsınız.
            </p>
            <div class="builder-template-grid">
                <template x-for="key in templateKeys()" :key="key">
                    <button type="button"
                            class="builder-template-card"
                            @@click="applyTemplate(key)">
                        <div class="builder-template-card__icon">
                            <i class="fas" :class="templateOptions[key].icon" aria-hidden="true"></i>
                        </div>
                        <div class="builder-template-card__body">
                            <div class="builder-template-card__title" x-text="templateOptions[key].label"></div>
                            <div class="builder-template-card__desc" x-text="templateOptions[key].description"></div>
                            <div class="builder-template-card__count"
                                 x-text="(templateOptions[key].config.tabs[0].components || []).length + ' bileşen'"></div>
                        </div>
                        <i class="fas fa-arrow-right builder-template-card__arrow" aria-hidden="true"></i>
                    </button>
                </template>
            </div>
        </div>
        <div class="m-foot">
            <button type="button" class="btn ghost" @@click="closeTemplateModal()">İptal</button>
        </div>
    </div>
</div>
