@model Mosaik.ViewModels.AdminFilterDefinitionFormViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Filtre Düzenle - BKM Rapor Paneli";
    ViewData["PageTitle"] = "Filtre Düzenle";
    var message = Model.Message ?? "";
    var messageType = Model.MessageType ?? "";
    var def = Model.Definition ?? new Mosaik.Models.FilterDefinition();
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=filters">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=filters">Filtreler</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">@(string.IsNullOrWhiteSpace(def.Label) ? "Düzenle" : def.Label)</span>
    </nav>
}

@section TopActions {
    <a href="/Admin?tab=filters" class="btn">
        <i class="fas fa-xmark text-[10px]" aria-hidden="true"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Filtre Düzenle</h1>
    <div class="sub">
        <span>@def.Label</span>
        <span class="pill"><span class="mono">#@def.FilterDefinitionId</span></span>
        @if (!string.IsNullOrWhiteSpace(def.DataSourceKey))
        {
            <span class="pill"><span class="mono">@def.DataSourceKey</span></span>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    @await Html.PartialAsync("_AlertMessage", (messageType == "success" ? "success" : "error", message))
}

<div class="form-section-card wide">
    <div class="form-section-head">
        <h2 class="form-section-head__title">
            <i class="fas fa-filter icon-mr" aria-hidden="true"></i>
            Filter Tanımı
        </h2>
        <p class="form-section-head__sub">Değişiklikleri kaydedin</p>
    </div>

    @await Html.PartialAsync("_AdminFilterFormBody", Model)
</div>
