@model Mosaik.ViewModels.AdminIndexViewModel
@*
    Plan 07 Faz 6 — Admin Filtreler tab.
    FilterDefinition listesi (DataSource bazli gruplandirilmis); CRUD detay sayfasi
    /Admin/CreateFilter ve /Admin/EditFilter/{id}.
*@
@{
    var dataSourceTitleByKey = (Model.DataSources ?? new List<Mosaik.Models.DataSource>())
        .ToDictionary(ds => ds.DataSourceKey, ds => ds.Title ?? ds.DataSourceKey, StringComparer.OrdinalIgnoreCase);

    var groups = Model.FilterDefinitions
        .GroupBy(f => f.DataSourceKey)
        .OrderBy(g => g.Key == null ? 1 : 0).ThenBy(g => g.Key)
        .ToList();
}

<div class="tab-toolbar">
    <div class="tab-toolbar__desc">
        Veri filtreleri — kullanıcılara atanan FilterDefinition tanımları. Her DataSource kendi
        sube/bolum/kategori vb. filter'larını burada yönetir; cross-cutting (DataSource bağımsız)
        filter'lar "Sistem" başlığı altındadır.
    </div>
    <a href="/Admin/CreateFilter" class="btn primary">
        <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
        Yeni Filtre
    </a>
</div>

@if (Model.FilterDefinitions.Count == 0)
{
    <div class="empty-note">
        Henüz filtre tanımı yok. "Yeni Filtre" ile ekleyin.
    </div>
}
else
{
    @foreach (var group in groups)
    {
        var dsKey = group.Key;
        var dsTitle = dsKey == null
            ? "Sistem (cross-cutting)"
            : (dataSourceTitleByKey.TryGetValue(dsKey, out var t) ? $"{t} ({dsKey})" : dsKey);

        <div class="ds-group">
            <div class="ds-group__head">
                <i class="fas fa-database" aria-hidden="true"></i>
                <span class="ds-group__title">@dsTitle</span>
            </div>

            <div class="paper-card clip">
                <table class="dt">
                    <thead>
                        <tr>
                            <th scope="col">Anahtar</th>
                            <th scope="col">Etiket</th>
                            <th scope="col">Scope</th>
                            <th scope="col">OptionsQuery</th>
                            <th scope="col">Sıra</th>
                            <th scope="col">Durum</th>
                            <th scope="col" class="col-right">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fd in group.OrderBy(d => d.DisplayOrder).ThenBy(d => d.Label))
                        {
                            <tr>
                                <td><span class="mono">@fd.FilterKey</span></td>
                                <td class="cell-name">@fd.Label</td>
                                <td>
                                    @if (fd.Scope == "spInjection")
                                    {
                                        <span class="pill xs">SP enjeksiyon</span>
                                    }
                                    else
                                    {
                                        <span class="pill xs info">Rapor erişim</span>
                                    }
                                </td>
                                <td class="cell-truncate" title="@fd.OptionsQuery">
                                    @(string.IsNullOrEmpty(fd.OptionsQuery) ? "—" : fd.OptionsQuery)
                                </td>
                                <td>@fd.DisplayOrder</td>
                                <td>
                                    <span class="status @(fd.IsActive ? "ok" : "err")">@(fd.IsActive ? "Aktif" : "Pasif")</span>
                                </td>
                                <td class="cell-right">
                                    <div class="row-actions">
                                        <a href="/Admin/EditFilter/@fd.FilterDefinitionId" class="btn ghost sm">
                                            <i class="fas fa-pen text-[9px]" aria-hidden="true"></i>
                                            Düzenle
                                        </a>
                                        <form method="post" class="inline-form" onsubmit="return confirm('Bu filtre tanimi silinsin mi? Kullanicilara atanan kayitlar kalir.')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="action" value="delete_filter" />
                                            <input type="hidden" name="id" value="@fd.FilterDefinitionId" />
                                            <button type="submit" class="btn sm danger">
                                                <i class="fas fa-trash text-[9px]" aria-hidden="true"></i>
                                                Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
