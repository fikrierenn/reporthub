@model Mosaik.ViewModels.AdminRoleFormViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Rol Düzenle - BKM Rapor Paneli";
    ViewData["PageTitle"] = "Rol Düzenle";
    var message = Model.Message ?? "";
    var messageType = Model.MessageType ?? "";
    var role = Model.Role ?? new Mosaik.Models.Role();
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=roles">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=roles">Roller</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">@(string.IsNullOrWhiteSpace(role.Name) ? "Düzenle" : role.Name)</span>
    </nav>
}

@section TopActions {
    <a href="/Admin?tab=roles" class="btn">
        <i class="fas fa-xmark text-[10px]" aria-hidden="true"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Rol Düzenle</h1>
    <div class="sub">
        <span>Rol bilgilerini güncelleyin</span>
        <span class="pill"><span class="mono">#@role.RoleId</span></span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div role="alert" class="alert @(messageType == "success" ? "success" : "error")">
        <i class="fas @(messageType == "success" ? "fa-check-circle" : "fa-exclamation-circle")" aria-hidden="true"></i>
        @message
    </div>
}

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="RoleId" value="@role.RoleId" />

    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2><i class="fas fa-shield-halved text-muted" aria-hidden="true"></i> Rol Bilgileri</h2>
            <div class="help-text">Değişiklikleri kaydedin</div>
        </div>

        <div class="form-section-body">
            <div class="grid-2col">
                <div class="field">
                    <label class="lab">Rol Adı <span class="text-accent">*</span></label>
                    <input type="text" name="Name" value="@role.Name" required class="inp" />
                </div>
                <div class="field">
                    <label class="lab">Açıklama</label>
                    <input type="text" name="Description" value="@role.Description" class="inp" />
                </div>
            </div>

            <div class="checkbox-row">
                <input type="hidden" name="IsActive" value="false" />
                <input type="checkbox" name="IsActive" value="true" id="roleActive"
                       @(role.IsActive ? "checked" : "")
                       class="checkbox" />
                <label for="roleActive" class="lab inline">Rolü aktif yap</label>
            </div>
        </div>
    </div>

    <div class="action-row wide">
        <a href="/Admin?tab=roles" class="btn ghost">
            <i class="fas fa-arrow-left text-[10px]" aria-hidden="true"></i>
            Geri Dön
        </a>
        <button type="submit" class="btn primary">
            <i class="fas fa-check text-[10px]" aria-hidden="true"></i>
            Rolü Güncelle
        </button>
    </div>
</form>
