@*
    V2 builder F-10 keyboard shortcuts help modal.
    Builder root x-data="builderV2" component'i içinde render edilir; shortcutsMixin'den
    shortcutsModal / openShortcutsHelp / closeShortcutsHelp kullanılır.
    Klavyeden "?" tuşu listener (builder-shortcuts.js initShortcuts) modal'ı açar.
*@

<div x-show="shortcutsModal && shortcutsModal.open" x-cloak
     class="builder-v2-modal-backdrop"
     @@click.self="closeShortcutsHelp()">
    <div class="builder-v2-modal sm">
        <div class="m-head">
            <span class="m-title">
                <i class="fas fa-keyboard text-[12px]" aria-hidden="true"></i> Klavye Kısayolları
            </span>
            <button type="button" class="m-close" @@click="closeShortcutsHelp()" title="Kapat">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div class="m-body padded">
            <table class="builder-shortcut-table">
                <tbody>
                    <tr>
                        <td class="keys">
                            <span class="kbd">Ctrl/⌘</span><span class="kbd-sep">+</span><span class="kbd">S</span>
                        </td>
                        <td>Kaydet</td>
                    </tr>
                    <tr>
                        <td class="keys">
                            <span class="kbd">Ctrl/⌘</span><span class="kbd-sep">+</span><span class="kbd">P</span>
                        </td>
                        <td>Tam Önizle</td>
                    </tr>
                    <tr>
                        <td class="keys"><span class="kbd">Esc</span></td>
                        <td>Açık modal'ı kapat veya seçimi bırak</td>
                    </tr>
                    <tr>
                        <td class="keys"><span class="kbd">Delete</span></td>
                        <td>Seçili bileşeni sil</td>
                    </tr>
                    <tr>
                        <td class="keys"><span class="kbd">?</span></td>
                        <td>Bu yardım penceresini aç/kapat</td>
                    </tr>
                </tbody>
            </table>
            <p class="builder-shortcut-note">
                <i class="fas fa-circle-info text-[9px]" aria-hidden="true"></i>
                Form alanlarında yazarken Ctrl+S/P haricindeki kısayollar pasifleşir.
            </p>
        </div>
    </div>
</div>
