@model Mosaik.Models.AiSettings
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Yapay Zeka Ayarları - Mosaik";
    ViewData["PageTitle"] = "Yapay Zeka Ayarları";
    var hasKey = !string.IsNullOrWhiteSpace(Model.ApiKey);
    var isActive = Model.IsEnabled && hasKey;
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Mosaik</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin/AiSettings">Yapay Zeka</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">@(Model.Id > 0 ? "Düzenle" : "Yeni")</span>
    </nav>
}

@section TopActions {
    <a href="/Admin/AiSettings" class="btn">
        <i class="fas fa-xmark icon-xs" aria-hidden="true"></i> İptal
    </a>
}

<div class="hero">
    <h1>Yapay Zeka Ayarları</h1>
    <div class="sub">
        <span>AI özet (tamim derleme), kategori önerisi, içerik analizi için provider yapılandırması</span>
        @if (isActive)
        {
            <span class="pill ok-tone"><span class="dot"></span>Aktif</span>
        }
        else
        {
            <span class="pill warn"><span class="dot"></span>Kapalı</span>
        }
    </div>
</div>

@if (TempData["Message"] != null)
{
    @await Html.PartialAsync("_AlertMessage", (TempData["MessageType"]?.ToString() ?? "info", TempData["Message"]?.ToString() ?? ""))
}

<form method="post" action="@(Model.Id > 0 ? $"/Admin/AiSettings/Edit/{Model.Id}" : "/Admin/AiSettings/Edit")" novalidate>
    @Html.AntiForgeryToken()

    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-wand-magic-sparkles icon-mr" aria-hidden="true"></i> Provider Ayarları
            </h2>
            <p class="form-section-head__sub">Open-source / free-tier önerilir: Groq Llama 3.3 (14 400 req/gün), Gemini Flash (1 500 req/gün)</p>
        </div>

        <div class="form-section-body stack">
            <div class="field">
                <label class="lab" for="Name">Profil Adı</label>
                <input type="text" id="Name" name="Name" value="@(Model.Name ?? "")" class="inp" maxlength="50"
                       placeholder="örn: Groq Production / Gemini Backup / z.ai Free" />
                <p class="help-text">UI'da tanımak için etiket. Boş bırakırsan provider adı kullanılır.</p>
            </div>

            <div class="grid-200-1fr">
                <div class="field">
                    <label class="lab" for="Provider">Provider <span class="text-danger">*</span></label>
                    <select id="Provider" name="Provider" class="inp" required>
                        <option value="groq" selected="@(Model.Provider == "groq")">Groq (Llama 3.x — hızlı, free)</option>
                        <option value="grok" selected="@(Model.Provider == "grok")">Grok (xAI — paid)</option>
                        <option value="gemini" selected="@(Model.Provider == "gemini")">Google Gemini (free)</option>
                        <option value="zai" selected="@(Model.Provider == "zai")">z.ai (GLM — free tier)</option>
                        <option value="openrouter" selected="@(Model.Provider == "openrouter")">OpenRouter (multi)</option>
                        <option value="openai" selected="@(Model.Provider == "openai")">OpenAI (paid)</option>
                        <option value="ollama" selected="@(Model.Provider == "ollama")">Ollama (local)</option>
                        <option value="local" selected="@(Model.Provider == "local")">Yerleşik AI (Qwen 2.5 3B — KVKK uyumlu, $0)</option>
                    </select>
                </div>
                <div class="field">
                    <label class="lab" for="Model">Model <span class="text-danger">*</span></label>
                    <input type="text" id="Model" name="Model" value="@Model.Model" class="inp" maxlength="100" required
                           placeholder="örn: llama-3.3-70b-versatile / gemini-1.5-flash / gpt-4o-mini" />
                </div>
            </div>

            <div class="field">
                <label class="lab" for="ApiKey">API Anahtarı @(hasKey ? "" : "*")</label>
                <input type="password" id="ApiKey" name="ApiKey" class="inp" maxlength="500"
                       placeholder="@(hasKey ? "(kayıtlı — değiştirmek için yeni anahtar gir, boş bırakırsan korunur)" : "Provider panelinden aldığın API key")"
                       autocomplete="off"
                       @(hasKey ? "" : "required") />
                @if (hasKey)
                {
                    <p class="help-text help-success">
                        <i class="fas fa-key icon-xs" aria-hidden="true"></i> Anahtar kayıtlı. Değiştirmek için yeni anahtar gir.
                    </p>
                }
                else
                {
                    <p class="help-text error">
                        <i class="fas fa-triangle-exclamation icon-xs" aria-hidden="true"></i> API anahtarı henüz kaydedilmemiş. Provider panelinden aldığın anahtarı buraya yapıştır.
                    </p>
                }
                <div class="field-warn-banner">
                    <i class="fas fa-circle-info icon-xs" aria-hidden="true"></i>
                    <strong>Önemli:</strong> Her provider'ın ayrı API anahtarı vardır. Provider değiştirdiysen yeni provider'dan <em>ayrı bir anahtar</em> al ve buraya yapıştır (Groq key Gemini'da çalışmaz, tersi de geçerli).
                </div>
            </div>

            <div class="grid-3col">
                <div class="field">
                    <label class="lab" for="MaxTokens">Max Token</label>
                    <input type="number" id="MaxTokens" name="MaxTokens" value="@Model.MaxTokens" class="inp"
                           min="128" max="8192" step="128" />
                </div>
                <div class="field">
                    <label class="lab" for="Temperature">Temperature</label>
                    <input type="number" id="Temperature" name="Temperature"
                           value="@Model.Temperature.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                           class="inp" min="0" max="2" step="0.1" />
                </div>
                <div class="field">
                    <label class="lab" for="BaseUrl">Base URL (ops.)</label>
                    <input type="text" id="BaseUrl" name="BaseUrl" value="@(Model.BaseUrl ?? "")" class="inp"
                           placeholder="Provider default için boş bırak" />
                </div>
            </div>

            <div class="grid-2col">
                <div class="field">
                    <label class="lab toggle-label" for="IsEnabled">
                        <input type="checkbox" id="IsEnabled" name="IsEnabled" value="true" @(Model.IsEnabled ? "checked" : "") class="checkbox checkbox-lg" />
                        <span><i class="fas fa-power-off icon-xs" aria-hidden="true"></i> Aktif (kullanılabilir)</span>
                    </label>
                </div>
                <div class="field">
                    <label class="lab toggle-label" for="IsPrimary">
                        <input type="checkbox" id="IsPrimary" name="IsPrimary" value="true" @(Model.IsPrimary ? "checked" : "") class="checkbox checkbox-lg" />
                        <span><i class="fas fa-star icon-xs text-accent" aria-hidden="true"></i> Birincil (primary) — ilk denenir</span>
                    </label>
                </div>
            </div>

            <div class="field">
                <label class="lab" for="Priority">Fallback önceliği</label>
                <input type="number" id="Priority" name="Priority" value="@Model.Priority" class="inp inp-narrow"
                       min="0" max="999" step="10" />
                <p class="help-text">
                    <i class="fas fa-circle-info icon-xs" aria-hidden="true"></i>
                    Düşük = önce. Birincil başarısız olursa diğer aktif profiller bu sıraya göre denenir. Default 100.
                </p>
            </div>
        </div>
    </div>

    @if (Model.LastTestAt.HasValue)
    {
        <div class="test-result-bar">
            <i class="fas @(Model.LastTestSuccess ? "fa-circle-check ok" : "fa-circle-xmark err")" aria-hidden="true"></i>
            <strong>Son test:</strong> @Model.LastTestAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.LastTestMessage
        </div>
    }

    <div class="action-row wide">
        <a href="/Admin/AiSettings" class="btn ghost">
            <i class="fas fa-arrow-left icon-xs" aria-hidden="true"></i> Geri Dön
        </a>
        <div class="btn-group">
            <button type="submit" formaction="@($"/Admin/AiSettings/Test/{Model.Id}")" class="btn"
                    title="Bağlantıyı test et (önce kaydet)" @(Model.Id > 0 ? "" : "disabled")>
                <i class="fas fa-bolt icon-xs" aria-hidden="true"></i> Test Et
            </button>
            <button type="submit" class="btn primary">
                <i class="fas fa-check icon-xs" aria-hidden="true"></i> Kaydet
            </button>
        </div>
    </div>
</form>

<div class="help-card">
    <strong>Provider seçim rehberi:</strong>
    <ul>
        <li><strong>Gemini</strong> (Türkçe için önerilir, free) — Doğal Türkçe çıktı. Model: <code>gemini-2.0-flash</code> veya <code>gemini-1.5-flash</code>, 1 500 req/gün ücretsiz. API: <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">aistudio.google.com/apikey</a></li>
        <li><strong>Groq</strong> (hızlı, free) — Llama 3.3 70B / 3.1 8B, 14 400 req/gün, ~1-2sn. <em>Türkçe'de Gemini'den zayıf</em>. Model: <code>llama-3.3-70b-versatile</code>. API: <a href="https://console.groq.com/keys" target="_blank" rel="noopener">console.groq.com/keys</a></li>
        <li><strong>Grok (xAI)</strong> — grok-2-1212, grok-3, grok-3-mini. Model: <code>grok-2-1212</code>. API: <a href="https://console.x.ai/" target="_blank" rel="noopener">console.x.ai</a></li>
        <li><strong>z.ai (Zhipu GLM)</strong> — Modeller: <code>glm-4.5</code> / <code>glm-4.6</code> / <code>glm-4.7</code> / <code>glm-5.1</code> (flagship). API: <a href="https://z.ai/manage-apikey/apikey-list" target="_blank" rel="noopener">z.ai/manage-apikey</a> · BaseUrl otomatik <code>https://api.z.ai/api/paas/v4</code> · <em>Free tier sınırlı, çoğu model paid.</em></li>
        <li><strong>OpenRouter</strong> — Multi-provider proxy (DeepSeek/Llama/Mistral free models). Model: <code>deepseek/deepseek-chat</code>. API: <a href="https://openrouter.ai/keys" target="_blank" rel="noopener">openrouter.ai/keys</a></li>
        <li><strong>Ollama</strong> — yerel kurulum, tamamen free, internet yok. BaseUrl: <code>http://localhost:11434/v1</code>. Model: <code>llama3.1</code></li>
        <li><strong>OpenAI</strong> — Model: <code>gpt-4o-mini</code> (paid).</li>
    </ul>
    <p>
        <i class="fas fa-circle-info" aria-hidden="true"></i>
        <strong>Not:</strong> Modüller (Tamim, ileride HR/Doküman vb) bu tek ayara bağlanır. Modüller kendi prompt'larını gönderir + opsiyonel olarak model/temperature override edebilir.
    </p>
</div>

@* Provider değişince Model placeholder + default değer auto-suggest *@
<script>
(function () {
    const providerEl = document.getElementById('Provider');
    const modelEl = document.getElementById('Model');
    if (!providerEl || !modelEl) return;

    const suggestions = {
        groq:        { model: 'llama-3.3-70b-versatile',         hint: 'llama-3.3-70b-versatile / llama-3.1-8b-instant / gemma2-9b-it' },
        grok:        { model: 'grok-2-1212',                     hint: 'grok-2-1212 / grok-3-mini / grok-3 / grok-2-vision-1212' },
        zai:         { model: 'glm-4.5',                         hint: 'glm-4.5 / glm-4.6 / glm-4.7 / glm-5 / glm-5.1 (flagship) / glm-5v-turbo (vision)' },
        gemini:      { model: 'gemini-1.5-flash',                hint: 'gemini-2.0-flash / gemini-1.5-flash / gemini-1.5-pro' },
        openrouter:  { model: 'qwen/qwen-2.5-72b-instruct:free', hint: 'qwen/qwen-2.5-72b-instruct:free (Türkçe iyi) / meta-llama/llama-3.3-70b-instruct:free / deepseek/deepseek-chat:free / google/gemma-3-27b-it:free' },
        openai:      { model: 'gpt-4o-mini',                     hint: 'gpt-4o-mini / gpt-4o / o1-mini' },
        ollama:      { model: 'llama3.1',                        hint: 'llama3.1 / qwen2.5:7b / mistral / phi3' }
    };

    function updateHint() {
        const p = providerEl.value;
        const sug = suggestions[p];
        if (!sug) return;
        modelEl.placeholder = 'örn: ' + sug.hint;
        if (!modelEl.value || modelEl.dataset.autoFilled === '1') {
            modelEl.value = sug.model;
            modelEl.dataset.autoFilled = '1';
        }
    }

    providerEl.addEventListener('change', updateHint);
    modelEl.addEventListener('input', () => { modelEl.dataset.autoFilled = '0'; });
    updateHint();
})();
</script>
