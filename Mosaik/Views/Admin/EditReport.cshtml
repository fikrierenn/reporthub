@model Mosaik.ViewModels.AdminReportFormViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = $"Düzenle: {Model.Report.Title} - Mosaik";
    ViewData["PageTitle"] = "Rapor Düzenle";
    var dataSources = Model.DataSources ?? new List<Mosaik.Models.DataSource>();
    var availableRoles = Model.AvailableRoles ?? new List<Mosaik.Models.Role>();
    var selectedRoleIds = Model.SelectedRoleIds ?? new HashSet<int>();
    var availableGroups = Model.AvailableGroups ?? new List<Mosaik.Models.ReportGroup>();
    var selectedGroupIds = Model.SelectedGroupIds ?? new HashSet<int>();
}

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@@10.3.1/dist/gridstack.min.css" crossorigin="anonymous" />
    <script defer src="https://cdn.jsdelivr.net/npm/gridstack@@10.3.1/dist/gridstack-all.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/assets/css/dashboard-builder.css" asp-append-version="true" />
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Mosaik</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin?tab=reports">Raporlar</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">@Model.Report.Title</span>
    </nav>
}

@* Builder topbar — Mode/Önizle/Geri Al/JSON/Kaydet butonları *@
@section TopActions {
    @await Html.PartialAsync("_ReportFormBuilderTopActions", "reportEditForm")
}

<div class="hero">
    <h1>Rapor Düzenle</h1>
    <div class="sub">
        <span class="pill"><span class="mono">#@Model.Report.ReportId</span></span>
        <span>@Model.Report.Title</span>
        <span class="pill @(Model.Report.IsActive ? "ok-tone" : "danger")">
            <span class="dot"></span>
            @(Model.Report.IsActive ? "Aktif" : "Pasif")
        </span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    @await Html.PartialAsync("_AlertMessage", (Model.MessageType ?? "info", Model.Message))
}

@* Alpine $store.builder.dirty — herhangi input değişimi dirty chip + beforeunload uyarısı.
   Razor `:` attribute izin vermediği için form yerine wrapper div. *@
<div x-data @@input="$store.builder.dirty = true">
<form id="reportEditForm" method="post" action="/Admin/EditReport/@Model.Report.ReportId" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="ReportId" value="@Model.Report.ReportId" />

    @* ===== 1. Genel Bilgiler ===== *@
    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-file-lines icon-mr"></i> Genel Bilgiler
            </h2>
        </div>
        <div class="form-section-body stack">
            <div class="grid-2-1">
                <div class="field">
                    <label class="lab" for="ReportId">Rapor ID</label>
                    <input type="text" id="ReportId" value="@Model.Report.ReportId" disabled class="inp disabled-mono" />
                </div>
                <div class="field">
                    <label class="lab" for="Title">Rapor Adı <span class="text-danger">*</span></label>
                    <input type="text" id="Title" name="Title" value="@Model.Report.Title" required class="inp" placeholder="örn: Satış Raporu" />
                </div>
            </div>

            <div class="field">
                <label class="lab" for="DataSourceKey">Veri Kaynağı <span class="text-danger">*</span></label>
                <select id="DataSourceKey" name="DataSourceKey" required class="inp">
                    <option value="">Veri kaynağını seçiniz...</option>
                    @foreach (var ds in dataSources)
                    {
                        <option value="@ds.DataSourceKey" selected="@(ds.DataSourceKey == Model.Report.DataSourceKey)">
                            @ds.Title (@ds.DataSourceKey)
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <label class="lab" for="Description">Açıklama</label>
                <textarea id="Description" name="Description" rows="3" class="inp textarea-auto"
                          placeholder="Rapor hakkında açıklama yazın...">@Model.Report.Description</textarea>
            </div>

            <div class="field">
                <label class="lab">Gruplar</label>
                <div class="checkbox-grid auto-fit-160">
                    @if (!availableGroups.Any())
                    {
                        <div class="help-text error">Grup listesi tanımlı değil.</div>
                    }
                    else
                    {
                        foreach (var group in availableGroups)
                        {
                            var isChecked = selectedGroupIds.Contains(group.GroupId);
                            <label class="checkbox-row">
                                <input type="checkbox" name="SelectedGroups" value="@group.GroupId" @(isChecked ? "checked" : "") class="checkbox" />
                                <span>@group.Name</span>
                            </label>
                        }
                    }
                </div>
                <p class="help-text">Birden fazla kategori seçilebilir.</p>
            </div>
        </div>
    </div>

    @* ===== 2. Teknik Ayarlar ===== *@
    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-gear icon-mr"></i> Teknik Ayarlar
            </h2>
        </div>
        <div class="form-section-body stack">
            <div class="grid-2col">
                <div class="field">
                    <label class="lab" for="ProcName">Prosedür Adı <span class="text-danger">*</span></label>
                    <div class="inp-with-action">
                        <input type="text" id="ProcName" name="ProcName" value="@Model.Report.ProcName" required list="spList"
                               class="inp mono" placeholder="sp_SatisRaporu veya listeden seçin" />
                        <datalist id="spList"></datalist>
                        <button type="button" id="spPreviewBtn" class="btn" title="SP'yi çalıştır ve dönen kolonları/veriyi gör">
                            <i class="fas fa-play icon-xs"></i> SP Önizle
                        </button>
                    </div>
                    <p class="help-text">Veri kaynağı seçildiğinde liste otomatik dolar.</p>
                    <div id="spPreviewPanel" class="hidden"></div>
                </div>

                <div class="field">
                    <label class="lab">İzinli Roller</label>
                    <div class="checkbox-grid auto-fit-140">
                        @if (!availableRoles.Any())
                        {
                            <div class="help-text error">Rol listesi tanımlı değil.</div>
                        }
                        else
                        {
                            foreach (var role in availableRoles)
                            {
                                var isChecked = selectedRoleIds.Contains(role.RoleId);
                                <label class="checkbox-row">
                                    <input type="checkbox" name="SelectedRoles" value="@role.RoleId" @(isChecked ? "checked" : "") class="checkbox" />
                                    <span>@role.Name</span>
                                </label>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="field">
                <label class="lab" for="ParamSchemaJson">ParamSchemaJson</label>
                @Html.TextArea("ParamSchemaJson", Model.Report.ParamSchemaJson, new
                {
                    id = "ParamSchemaJson",
                    rows = "3",
                    @class = "inp json",
                    placeholder = "{\"fields\":[{\"name\":\"StartDate\",\"label\":\"Başlangıç Tarihi\",\"type\":\"date\",\"required\":true}]}"
                })
                <p class="help-text">JSON formatında parametre tanımı.</p>
            </div>
        </div>
    </div>

    @* ===== 3. Parametre Oluşturucu ===== *@
    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-list-ul icon-mr"></i> Parametre Oluşturucu
            </h2>
        </div>
        <div class="form-section-body">
            <div class="param-builder-row">
                <div class="field">
                    <label class="lab" for="paramName">Ad</label>
                    <input type="text" id="paramName" class="inp" placeholder="StartDate" />
                </div>
                <div class="field">
                    <label class="lab" for="paramLabel">Etiket</label>
                    <input type="text" id="paramLabel" class="inp" placeholder="Başlangıç Tarihi" />
                </div>
                <div class="field">
                    <label class="lab" for="paramPlaceholder">Placeholder</label>
                    <input type="text" id="paramPlaceholder" class="inp" placeholder="gg.aa.yyyy" />
                </div>
                <div class="field">
                    <label class="lab" for="paramType">Tip</label>
                    <select id="paramType" class="inp">
                        <option value="text">text</option>
                        <option value="number">number</option>
                        <option value="decimal">decimal</option>
                        <option value="date">date</option>
                        <option value="checkbox">checkbox</option>
                    </select>
                </div>
                <div class="field">
                    <label class="lab" for="paramDefault">Varsayılan</label>
                    <input type="text" id="paramDefault" class="inp" placeholder="today" />
                </div>
                <div class="field">
                    <label class="lab" for="paramHelp">Yardım</label>
                    <input type="text" id="paramHelp" class="inp" placeholder="Zorunlu alan" />
                </div>
                <div class="param-required-cell">
                    <input type="checkbox" id="paramRequired" class="checkbox" />
                    <label for="paramRequired" class="lab inline">Zorunlu</label>
                </div>
                <button type="button" id="addParamBtn" class="btn primary">
                    <i class="fas fa-plus icon-xs"></i> Ekle
                </button>
                <button type="button" id="loadParamsBtn" class="btn">
                    <i class="fas fa-download icon-xs"></i> SP'den Getir
                </button>
            </div>

            <div class="mt-14">
                <div class="text-muted text-xs mb-8">Parametreler</div>
                <div id="paramList" class="param-list-stack"></div>
            </div>
        </div>
    </div>

    @* ===== 4. Dashboard Oluşturucu ===== *@
    <div id="dashboardConfigSection" class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-table-cells-large icon-mr"></i> Dashboard Oluşturucu
            </h2>
            <p class="form-section-head__sub">Widget'ları ekle, düzenle, kaydet</p>
        </div>
        <textarea name="DashboardConfigJson" id="DashboardConfigJson" class="hidden">@Model.Report.DashboardConfigJson</textarea>
        <div id="dashboardBuilder" class="form-section-body"></div>
    </div>

    @* ===== 5. Aktif + footer (Kaydet topbar'da, alt 'Geri Dön' kalır) ===== *@
    <div class="toggle-row">
        <input type="checkbox" name="IsActive" value="true" id="reportActive" @(Model.Report.IsActive ? "checked" : "") class="checkbox checkbox-lg" />
        <label for="reportActive" class="lab inline">Raporu aktif olarak işaretle</label>
    </div>

    <div class="action-row wide with-hint">
        <a href="/Admin?tab=reports" class="btn ghost">
            <i class="fas fa-arrow-left icon-xs"></i> Geri Dön
        </a>
        <span class="hint-text">Kaydet işlemi üst topbar'dan da yapılabilir</span>
    </div>
</form>
</div>

@* M-13 R3 (28 Nisan): admin-report-form.js 531 sat → 2 modül (param-builder + sp-helper) *@
<script src="~/assets/js/admin-report-form/param-builder.js"></script>
<script src="~/assets/js/admin-report-form/sp-helper.js"></script>
<script src="~/assets/js/dashboard-builder/builder-core.js"></script>
<script src="~/assets/js/dashboard-builder/builder-canvas.js"></script>
<script src="~/assets/js/dashboard-builder/builder-contract.js"></script>
<script src="~/assets/js/dashboard-builder/builder-list.js"></script>
<script src="~/assets/js/dashboard-builder/builder-drawer.js"></script>
<script src="~/assets/js/dashboard-builder/builder-preview.js"></script>
<script src="~/assets/js/dashboard-builder/builder-templates.js"></script>
