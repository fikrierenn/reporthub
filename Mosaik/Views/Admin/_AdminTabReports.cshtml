@model Mosaik.ViewModels.AdminIndexViewModel

<div class="tab-toolbar">
    <div class="tab-toolbar__desc">Sistem raporlarını yönetin</div>
    <a href="/Admin/CreateReportV2" class="btn primary">
        <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
        Yeni Rapor
    </a>
</div>

<div class="paper-card clip">
    <table class="dt">
        <thead>
            <tr>
                <th scope="col" class="w-100">ID</th>
                <th scope="col">Rapor</th>
                <th scope="col">Veri Kaynağı</th>
                <th scope="col">Prosedür</th>
                <th scope="col">Kategori</th>
                <th scope="col">Durum</th>
                <th scope="col" class="col-right">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model.Reports)
            {
                var reportGroups = report.ReportGroups
                    .Select(rg => rg.Group?.Name ?? "")
                    .Where(name => !string.IsNullOrWhiteSpace(name))
                    .ToList();
                <tr>
                    <td><span class="mono">#@report.ReportId</span></td>
                    <td>
                        <div class="cell-name">@report.Title</div>
                        @if (!string.IsNullOrWhiteSpace(report.Description))
                        {
                            <div class="cell-stack__sub">@report.Description</div>
                        }
                    </td>
                    <td><span class="mono">@report.DataSourceKey</span></td>
                    <td class="cell-mono-sm">@report.ProcName</td>
                    <td class="cell-muted">@string.Join(", ", reportGroups)</td>
                    <td>
                        <span class="status @(report.IsActive ? "ok" : "err")">@(report.IsActive ? "Aktif" : "Pasif")</span>
                    </td>
                    <td class="cell-right">
                        <div class="row-actions">
                            <a href="/Admin/EditReportV2/@report.ReportId" class="btn ghost sm">
                                <i class="fas fa-pen text-[9px]" aria-hidden="true"></i>
                                Düzenle
                            </a>
                            <form method="post" class="inline-form" onsubmit="return confirm('Bu raporu silmek istediğinizden emin misiniz?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="action" value="delete_report" />
                                <input type="hidden" name="id" value="@report.ReportId" />
                                <button type="submit" class="btn sm danger">
                                    <i class="fas fa-trash text-[9px]" aria-hidden="true"></i>
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
