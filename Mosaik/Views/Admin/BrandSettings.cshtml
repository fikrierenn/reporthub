@model Mosaik.Models.BrandSettings
@{
    ViewData["Title"] = "Marka Ayarları";
    Layout = "_AppLayout";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Ana Sayfa</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/Admin">Yönetim</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Marka Ayarları</span>
    </nav>
}

@section TopActions {
    <a href="/Admin" class="btn">
        <i class="fas fa-xmark icon-xs"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Yönetim Paneli</h1>
    <div class="sub"><span>Marka, modül ve sistem yapılandırması</span></div>
</div>

@if (TempData["Message"] != null)
{
    var msgType = TempData["MessageType"]?.ToString() == "success" ? "success" : "error";
    @await Html.PartialAsync("_AlertMessage", (msgType, TempData["Message"]?.ToString() ?? ""))
}

<form method="post" action="/Admin/BrandSettings" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-palette icon-mr"></i>
                Marka Bilgileri
            </h2>
            <p class="form-section-head__sub">Site adı, logo ve renk yapılandırması</p>
        </div>

        <div class="form-section-body stack">
            <div class="field">
                <label class="lab" for="SiteTitle">Site Adı <span class="text-danger">*</span></label>
                <input type="text" id="SiteTitle" name="SiteTitle" value="@Model.SiteTitle" class="inp" required maxlength="100" placeholder="örn: Mosaik" />
            </div>

            <div class="field">
                <label class="lab" for="Slogan">Slogan</label>
                <input type="text" id="Slogan" name="Slogan" value="@Model.Slogan" class="inp" maxlength="200" placeholder="Opsiyonel" />
            </div>

            <div class="field">
                <label class="lab">Logo</label>
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <div class="logo-preview">
                        <img src="@Model.LogoPath" alt="Mevcut logo" class="logo-preview__img" />
                        <span class="text-muted text-xs">Mevcut logo</span>
                    </div>
                    @* TODO inline-style-guard: .logo-preview + .logo-preview__img utility'leri components.css'e eklenecek (max-height:40px, border, radius, padding). *@
                }
                <input type="file" name="logoFile" accept=".png,.jpg,.jpeg,.svg,.webp" class="inp inp-file" />
                <p class="help-text">PNG, JPG, SVG veya WebP. Yeni dosya yüklenirse mevcut değiştirilir.</p>
                @* TODO inline-style-guard: .inp-file utility'si (height:auto; padding:6px 12px) components.css'e eklenecek. *@
            </div>

            <div class="field">
                <label class="lab" for="colorHex">Birincil Renk</label>
                <div class="color-picker-row">
                    <input type="color" name="PrimaryColor" value="@Model.PrimaryColor" id="colorPicker" class="color-swatch" />
                    <input type="text" id="colorHex" value="@Model.PrimaryColor" maxlength="7"
                           class="inp inp-hex"
                           placeholder="#dc2626" />
                </div>
                <p class="help-text">Hex renk kodu (#rrggbb). Sidebar ve butonlarda kullanılır.</p>
                @* TODO inline-style-guard: .color-picker-row (flex+gap), .color-swatch (40x34 native color input), .inp-hex (width:110px) utility'leri components.css'e eklenecek. *@
            </div>
        </div>
    </div>

    <div class="action-row wide">
        <a href="/Admin" class="btn ghost">
            <i class="fas fa-arrow-left icon-xs"></i> Geri Dön
        </a>
        <button type="submit" class="btn primary">
            <i class="fas fa-save icon-xs"></i> Kaydet
        </button>
    </div>
</form>

@section Scripts {
    <script>
    (() => {
        const picker = document.getElementById('colorPicker');
        const hex    = document.getElementById('colorHex');
        picker?.addEventListener('input', () => { hex.value = picker.value; });
        hex?.addEventListener('input',   () => { if (/^#[0-9a-fA-F]{6}$/.test(hex.value)) picker.value = hex.value; });
    })();
    </script>
}
