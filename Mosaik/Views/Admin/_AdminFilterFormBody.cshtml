@model Mosaik.ViewModels.AdminFilterDefinitionFormViewModel
@*
    Plan 07 Faz 6 — Create + Edit ortak form gövdesi.
    Caller: CreateFilter.cshtml ve EditFilter.cshtml.
*@
@{
    var def = Model.Definition ?? new Mosaik.Models.FilterDefinition();
    var dataSources = Model.DataSources ?? new List<Mosaik.Models.DataSource>();
}

<form method="post" class="form-body stack-14">
    @Html.AntiForgeryToken()

    <div class="grid-2col">
        <div class="field tight">
            <label class="lab">Filter Anahtarı <span class="req">*</span></label>
            <input type="text" name="FilterKey" value="@def.FilterKey" required maxlength="50"
                   pattern="^[a-zA-Z][a-zA-Z0-9_]*$" class="inp"
                   placeholder="örn: sube, bolum, kategori" />
            <p class="help-text">
                SP parametresi <span class="mono">@@&lt;anahtar&gt;_Filtre</span> olarak gönderilir. Sadece harf/rakam/_, harfle başlamalı.
            </p>
        </div>
        <div class="field tight">
            <label class="lab">Etiket <span class="req">*</span></label>
            <input type="text" name="Label" value="@def.Label" required maxlength="100" class="inp"
                   placeholder="örn: Şube, Bölüm, Kategori" />
        </div>
    </div>

    <div class="grid-3col-fixed-end">
        <div class="field tight">
            <label class="lab">Scope <span class="req">*</span></label>
            <select name="Scope" class="inp" required>
                @if (def.Scope == "spInjection")
                {
                    <option value="spInjection" selected>SP Enjeksiyon (rapor parametresi)</option>
                }
                else
                {
                    <option value="spInjection">SP Enjeksiyon (rapor parametresi)</option>
                }
                @if (def.Scope == "reportAccess")
                {
                    <option value="reportAccess" selected>Rapor Erişim (Reports/Index liste filtresi)</option>
                }
                else
                {
                    <option value="reportAccess">Rapor Erişim (Reports/Index liste filtresi)</option>
                }
            </select>
        </div>
        <div class="field tight">
            <label class="lab">Veri Kaynağı</label>
            <select name="DataSourceKey" class="inp">
                @if (string.IsNullOrEmpty(def.DataSourceKey))
                {
                    <option value="" selected>— Sistem (cross-cutting) —</option>
                }
                else
                {
                    <option value="">— Sistem (cross-cutting) —</option>
                }
                @foreach (var ds in dataSources)
                {
                    if (def.DataSourceKey == ds.DataSourceKey)
                    {
                        <option value="@ds.DataSourceKey" selected>@ds.Title (@ds.DataSourceKey)</option>
                    }
                    else
                    {
                        <option value="@ds.DataSourceKey">@ds.Title (@ds.DataSourceKey)</option>
                    }
                }
            </select>
            <p class="help-text">spInjection için zorunlu, reportAccess için boş.</p>
        </div>
        <div class="field tight">
            <label class="lab">Sıra</label>
            <input type="number" name="DisplayOrder" value="@def.DisplayOrder" class="inp" min="0" />
        </div>
    </div>

    <div class="field tight">
        <label class="lab">OptionsQuery (SQL)</label>
        <textarea id="optionsQueryTxt" name="OptionsQuery" class="inp code" rows="4"
                  placeholder="SELECT CAST(SubeNo AS varchar(10)) AS Value, SubeAd AS Label FROM vrd.SubeListe">@def.OptionsQuery</textarea>
        <p class="help-text">
            Yalnız <span class="mono">SELECT</span> (veya <span class="mono">WITH ... SELECT</span>). EXEC/INSERT/UPDATE/DELETE/DROP yasak.
            <span class="mono">Value</span> + <span class="mono">Label</span> kolonları döndürmeli.
            spInjection için zorunlu; reportAccess için boş (native registry kullanır).
        </p>
        <div class="btn-row mt-8">
            <button type="button" id="testOptionsQueryBtn" class="btn ghost sm">
                <i class="fas fa-flask text-[10px]"></i>
                OptionsQuery Test Et
            </button>
            <span id="testOptionsQueryStatus" class="status-text"></span>
        </div>
        <div id="testOptionsQueryResult" class="query-preview-box hidden">
            <table class="dt">
                <thead><tr><th>Value</th><th>Label</th></tr></thead>
                <tbody id="testOptionsQueryRows"></tbody>
            </table>
        </div>
    </div>

    <div class="active-toggle-row">
        <input type="hidden" name="IsActive" value="false" />
        <input type="checkbox" name="IsActive" value="true" id="filterActive"
               @(def.IsActive ? "checked" : "")
               class="checkbox checkbox-lg" />
        <label for="filterActive" class="lab">Filtre tanımı aktif</label>
    </div>

    <div class="form-inline-footer">
        <a href="/Admin?tab=filters" class="btn ghost">
            <i class="fas fa-arrow-left text-[10px]"></i>
            Geri Dön
        </a>
        <button type="submit" class="btn primary">
            <i class="fas fa-check text-[10px]"></i>
            Kaydet
        </button>
    </div>
</form>

<script>
(function () {
    var btn = document.getElementById('testOptionsQueryBtn');
    var statusEl = document.getElementById('testOptionsQueryStatus');
    var resultBox = document.getElementById('testOptionsQueryResult');
    var rowsEl = document.getElementById('testOptionsQueryRows');
    if (!btn) return;

    function setStatus(msg, kind) {
        statusEl.textContent = msg;
        statusEl.classList.remove('err', 'ok', 'muted');
        if (kind) statusEl.classList.add(kind);
    }

    btn.addEventListener('click', async function () {
        var ds = (document.querySelector('select[name="DataSourceKey"]').value || '').trim();
        var q = (document.getElementById('optionsQueryTxt').value || '').trim();
        var token = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
        if (!ds) { setStatus('DataSource seçin.', 'err'); return; }
        if (!q)  { setStatus('OptionsQuery boş.', 'err'); return; }

        setStatus('Çalıştırılıyor…', 'muted');
        resultBox.classList.add('hidden');
        rowsEl.innerHTML = '';

        try {
            var fd = new FormData();
            fd.append('dataSourceKey', ds);
            fd.append('optionsQuery', q);
            fd.append('__RequestVerificationToken', token);

            var r = await fetch('/Admin/TestFilterOptionsQuery', { method: 'POST', body: fd });
            var d = await r.json();
            if (!d.success) {
                setStatus(d.error || 'Bilinmeyen hata.', 'err');
                return;
            }
            if (!d.rows || d.rows.length === 0) {
                setStatus('Sorgu başarılı ama 0 satır döndü.', 'muted');
                return;
            }
            setStatus(d.total + ' satır (ilk 10).', 'ok');
            d.rows.forEach(function (row) {
                var tr = document.createElement('tr');
                var tdV = document.createElement('td'); tdV.textContent = row.value;
                var tdL = document.createElement('td'); tdL.textContent = row.label;
                tr.appendChild(tdV); tr.appendChild(tdL);
                rowsEl.appendChild(tr);
            });
            resultBox.classList.remove('hidden');
        } catch (err) {
            setStatus('İstek başarısız: ' + (err.message || err), 'err');
        }
    });
})();
</script>
