@model Mosaik.ViewModels.AdminIndexViewModel

<div class="inline-create-card">
    <h2 class="inline-create-card__title">
        <i class="fas fa-circle-plus" aria-hidden="true"></i>
        Yeni Grup Ekle
    </h2>
    <form method="post" class="inline-create-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="action" value="create_group" />
        <div class="field tight">
            <label class="lab" for="Name">Grup Adı <span class="req">*</span></label>
            <input type="text" id="Name" name="Name" class="inp" required />
        </div>
        <div class="field tight">
            <label class="lab" for="Description">Açıklama</label>
            <input type="text" id="Description" name="Description" class="inp" />
        </div>
        <div class="checkbox-cell">
            <input type="hidden" name="IsActive" value="false" />
            <input type="checkbox" name="IsActive" value="true" id="newGroupActive" checked class="checkbox" />
            <label for="newGroupActive" class="lab inline">Aktif</label>
        </div>
        <button type="submit" class="btn primary">
            <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
            Ekle
        </button>
    </form>
</div>

<div class="paper-card clip">
    <table class="dt">
        <thead>
            <tr>
                <th scope="col">Grup</th>
                <th scope="col">Açıklama</th>
                <th scope="col">Durum</th>
                <th scope="col" class="col-right">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model.Groups)
            {
                <tr>
                    <td class="cell-name">@group.Name</td>
                    <td class="cell-muted">@group.Description</td>
                    <td>
                        <span class="status @(group.IsActive ? "ok" : "err")">@(group.IsActive ? "Aktif" : "Pasif")</span>
                    </td>
                    <td class="cell-right">
                        <div class="row-actions">
                            <a href="/Admin/EditGroup/@group.GroupId" class="btn ghost sm">
                                <i class="fas fa-pen text-[9px]" aria-hidden="true"></i>
                                Düzenle
                            </a>
                            <form method="post" class="inline-form" onsubmit="return confirm('Grup silinsin mi?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="action" value="delete_group" />
                                <input type="hidden" name="id" value="@group.GroupId" />
                                <button type="submit" class="btn sm danger">
                                    <i class="fas fa-trash text-[9px]" aria-hidden="true"></i>
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
