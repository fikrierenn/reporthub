@model Mosaik.ViewModels.ContractCreateViewModel
@using Mosaik.Models

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Yeni Sözleşme";
    var accessibleFirmas = ViewBag.AccessibleFirmas as List<Mosaik.Models.Firma> ?? new();
    var multiFirma = accessibleFirmas.Count > 1;
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/">Ana Sayfa</a>
        <a href="/Contracts">Sözleşmeler</a>
        <span aria-current="page">Yeni Sözleşme</span>
    </nav>
}

@section TopActions {
    <a href="/Contracts" class="btn ghost">İptal</a>
}

<div class="hero">
    <h1>Yeni Sözleşme</h1>
    <div class="sub"><span>Sözleşme bilgilerini doldurun</span></div>
</div>

@if (TempData["Error"] is string err)
{
    @await Html.PartialAsync("_AlertMessage", ("error", err))
}

@if (!ViewData.ModelState.IsValid)
{
    <div role="alert" class="alert error">
        @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@modelError.ErrorMessage</div>
        }
    </div>
}

<form method="post" action="/Contracts/Create">
    @Html.AntiForgeryToken()
    @if (!multiFirma)
    {
        <input type="hidden" name="FirmaId" value="@Model.FirmaId" />
    }

    @* === AI Destekli Doldur === *@
    <div class="form-section-card split" x-data="wizardPanel()">
        <div class="form-section-head" role="button" tabindex="0"
             @@click="toggle()" @@keydown.enter="toggle()" @@keydown.space.prevent="toggle()"
             :aria-expanded="open.toString()">
            <span><i class="fas fa-robot text-[11px]"></i> AI Destekli Doldur</span>
            <span class="text-xs text-muted" x-show="!open">PDF yükle, alanları otomatik doldur</span>
            <i class="fas fa-chevron-down text-[10px] ml-auto" :class="open ? 'fa-rotate-180' : ''"></i>
        </div>
        <div class="form-section-body" x-show="open" x-cloak>
            <p class="help-text">PDF sözleşmeyi yükleyin — AI başlık, taraf, tarih ve kategoriyi otomatik çıkarsın. İstediğiniz alanları düzenleyebilirsiniz.</p>

            <div class="upload-zone" @@dragover.prevent @@drop.prevent="onDrop($event)">
                <div class="upload-icon"><i class="fas fa-file-pdf"></i></div>
                <div class="upload-title" x-text="file ? file.name : 'PDF seçin veya buraya sürükleyin'"></div>
                <div class="upload-sub" x-show="!file">Maks. 30 MB</div>
                <input type="file" id="wizardFile" accept=".pdf" class="upload-input"
                       @@change="onFile($event)" :disabled="uploading" />
            </div>

            <div class="action-row" x-show="file && !uploading && !result">
                <button type="button" class="btn primary" @@click="upload()">
                    <i class="fas fa-magic text-[10px]"></i> AI ile Doldur
                </button>
            </div>

            <div class="alert warn" role="status" x-show="uploading" x-cloak>
                <i class="fas fa-spinner fa-spin text-[11px]"></i>
                <span x-text="jobId ? 'Analiz ediliyor...' : 'Yükleniyor...'"></span>
            </div>

            <div class="alert success" role="status" x-show="result && !errMsg" x-cloak>
                <i class="fas fa-check-circle text-[11px]"></i> Alanlar dolduruldu. İnceleyip düzenleyebilirsiniz.
                <button type="button" class="btn sm" @@click="populate()">Tekrar Uygula</button>
            </div>

            <template x-if="riskFlags.length > 0">
                <div class="alert warn" role="alert">
                    <strong><i class="fas fa-triangle-exclamation text-[11px]"></i> Hukuki Risk Uyarıları</strong>
                    <ul class="risk-flag-list">
                        <template x-for="flag in riskFlags" :key="flag">
                            <li x-text="flag"></li>
                        </template>
                    </ul>
                </div>
            </template>

            <div class="alert error" role="alert" x-show="errMsg" x-cloak>
                <i class="fas fa-exclamation-circle text-[11px]"></i>
                <span x-text="errMsg"></span>
            </div>
        </div>
    </div>

    @* === Temel Bilgiler === *@
    <div class="form-section-card split">
        <div class="form-section-head">Temel Bilgiler</div>
        <div class="form-section-body">
            @if (multiFirma)
            {
                <div class="field">
                    <label class="lab" for="FirmaId">Firma <span class="form-required">*</span></label>
                    <select class="inp" id="FirmaId" name="FirmaId" required>
                        @foreach (var f in accessibleFirmas)
                        {
                            <option value="@f.FirmaId" selected="@(Model.FirmaId == f.FirmaId)">@f.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="field">
                <label class="lab" for="Title">Sözleşme Başlığı <span class="form-required">*</span></label>
                <input class="inp" id="Title" name="Title" value="@Model.Title" required maxlength="200"
                       placeholder="Örn: Bilgisayar Kiralama Sözleşmesi 2026" />
            </div>

            <div class="field">
                <label class="lab" for="Counterparty">Karşı Taraf</label>
                <input class="inp" id="Counterparty" name="Counterparty" value="@Model.Counterparty" maxlength="200"
                       placeholder="Şirket veya kişi adı" />
            </div>

            <div class="form-grid-2">
                <div class="field">
                    <label class="lab" for="Category">Kategori</label>
                    <select class="inp" id="Category" name="Category">
                        <option value="6" selected="@(Model.Category == ContractCategory.Other)">Diğer</option>
                        <option value="0" selected="@(Model.Category == ContractCategory.Lease)">Kira</option>
                        <option value="1" selected="@(Model.Category == ContractCategory.Service)">Hizmet</option>
                        <option value="2" selected="@(Model.Category == ContractCategory.Supply)">Tedarik</option>
                        <option value="3" selected="@(Model.Category == ContractCategory.Employment)">İş</option>
                        <option value="4" selected="@(Model.Category == ContractCategory.License)">Lisans</option>
                        <option value="5" selected="@(Model.Category == ContractCategory.Insurance)">Sigorta</option>
                    </select>
                </div>
                <div class="field">
                    <label class="lab" for="Status">Durum</label>
                    <select class="inp" id="Status" name="Status">
                        <option value="0" selected="@(Model.Status == ContractStatus.Draft)">Taslak</option>
                        <option value="1" selected="@(Model.Status == ContractStatus.Active)">Aktif</option>
                    </select>
                </div>
            </div>

            <div class="form-grid-2">
                <div class="field">
                    <label class="lab" for="StartDate">Başlangıç Tarihi</label>
                    <input class="inp" type="date" id="StartDate" name="StartDate"
                           value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="field">
                    <label class="lab" for="EndDate">Bitiş Tarihi</label>
                    <input class="inp" type="date" id="EndDate" name="EndDate"
                           value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                </div>
            </div>

            <div class="field">
                <label class="lab" for="Notes">Notlar</label>
                <textarea class="inp" id="Notes" name="Notes" rows="3" maxlength="2000"
                          placeholder="İsteğe bağlı notlar...">@Model.Notes</textarea>
            </div>

            @* === AI wizard'ın çıkardığı opsiyonel alanlar === *@
            <div class="form-grid-2">
                <div class="field">
                    <label class="lab" for="ContractValue">Sözleşme Bedeli</label>
                    <input class="inp" type="number" step="0.01" id="ContractValue" name="ContractValue"
                           value="@(Model.ContractValue?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                           placeholder="0,00" />
                </div>
                <div class="field">
                    <label class="lab" for="Currency">Para Birimi</label>
                    <input class="inp" id="Currency" name="Currency" maxlength="8"
                           value="@(Model.Currency ?? "TRY")" />
                </div>
            </div>

            <div class="field">
                <label class="lab" for="GoverningLaw">Geçerli Hukuk / Tahkim</label>
                <input class="inp" id="GoverningLaw" name="GoverningLaw" maxlength="200"
                       value="@Model.GoverningLaw"
                       placeholder="Türk Hukuku / İstanbul Tahkim" />
            </div>

            <div class="form-grid-2">
                <label class="field-check">
                    <input type="checkbox" id="AutoRenewal" name="AutoRenewal" value="true"
                           @(Model.AutoRenewal == true ? "checked" : "") />
                    Otomatik yenileme maddesi var
                </label>
                <label class="field-check">
                    <input type="checkbox" id="KvkkInvolved" name="KvkkInvolved" value="true"
                           @(Model.KvkkInvolved == true ? "checked" : "") />
                    KVKK / kişisel veri işleme içerir
                </label>
            </div>
        </div>
    </div>

    @* === Periyodik Yükümlülükler (kira, stopaj, KDV vb.) === *@
    <div class="form-section-card split"
         x-data="recurringPanel()">
        <div class="form-section-head form-section-head--with-action">
            <span>Periyodik Yükümlülükler</span>
            <button type="button" class="btn sm" @@click="addItem()">
                <i class="fa fa-plus text-[9px]"></i> Ekle
            </button>
        </div>
        <div class="form-section-body">
            <p class="form-help" x-show="items.length === 0">
                Kira, stopaj, KDV gibi tekrarlayan ödemeleri buradan tanımlayın.
                Sözleşme kaydedildiğinde tüm dönemler otomatik üretilir.
            </p>

            <template x-for="(item, i) in items" :key="i">
                <div class="recurring-item">
                    <div class="recurring-item-head">
                        <span x-text="'Yükümlülük #' + (i + 1)"></span>
                        <button type="button" class="btn sm danger" @@click="removeItem(i)">
                            <i class="fa fa-trash text-[9px]"></i>
                        </button>
                    </div>

                    <div class="form-grid-2">
                        <div class="field">
                            <label class="lab">Başlık <span class="form-required">*</span></label>
                            <input class="inp" type="text" x-model="item.title"
                                   :name="'Recurrences[' + i + '].Title'"
                                   maxlength="200" placeholder="Örn: Aylık Kira" />
                        </div>
                        <div class="field">
                            <label class="lab">Tür</label>
                            <select class="inp" x-model="item.type" :name="'Recurrences[' + i + '].Type'">
                                <option value="0">Ödeme</option>
                                <option value="1">Vergi (Stopaj/KDV)</option>
                                <option value="2">Uyumluluk</option>
                                <option value="3">Yenileme</option>
                                <option value="4">Son Tarih</option>
                                <option value="5">Denetim</option>
                            </select>
                        </div>
                    </div>

                    <div class="recurring-row-3">
                        <div class="field">
                            <label class="lab">Tutar</label>
                            <input class="inp" type="number" step="0.01" min="0" x-model="item.amount"
                                   :name="'Recurrences[' + i + '].Amount'" placeholder="0.00" />
                        </div>
                        <div class="field">
                            <label class="lab">Döviz</label>
                            <select class="inp" x-model="item.currency" :name="'Recurrences[' + i + '].Currency'">
                                <option value="TRY">TRY</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="lab">Periyot</label>
                            <select class="inp" x-model="item.recurrenceType"
                                    :name="'Recurrences[' + i + '].RecurrenceType'">
                                <option value="0">Aylık</option>
                                <option value="1">3 Aylık</option>
                                <option value="2">Yıllık</option>
                                <option value="3">Özel (ay aralığı)</option>
                            </select>
                        </div>
                    </div>

                    <div class="recurring-row-4">
                        <div class="field">
                            <label class="lab">Ayın günü</label>
                            <input class="inp" type="number" min="1" max="28" x-model="item.dayOfMonth"
                                   :name="'Recurrences[' + i + '].DayOfMonth'" />
                        </div>
                        <div class="field" x-show="item.recurrenceType == '2'">
                            <label class="lab">Yılın ayı</label>
                            <input class="inp" type="number" min="1" max="12" x-model="item.monthOfYear"
                                   :name="'Recurrences[' + i + '].MonthOfYear'" />
                        </div>
                        @* Custom interval — sadece Custom seçildiğinde DOM'da; aynı name'li hidden input ile çakışmasın *@
                        <template x-if="item.recurrenceType == '3'">
                            <div class="field">
                                <label class="lab">Aralık (ay)</label>
                                <input class="inp" type="number" min="1" max="60" x-model="item.intervalValue"
                                       :name="'Recurrences[' + i + '].IntervalValue'" />
                            </div>
                        </template>
                        <div class="field">
                            <label class="lab">Başlangıç</label>
                            <input class="inp" type="date" x-model="item.startDate"
                                   :name="'Recurrences[' + i + '].StartDate'" />
                        </div>
                        <div class="field">
                            <label class="lab">Bitiş</label>
                            <input class="inp" type="date" x-model="item.endDate"
                                   :name="'Recurrences[' + i + '].EndDate'" />
                        </div>
                    </div>

                    <div class="field">
                        <label class="lab">Notlar</label>
                        <input class="inp" type="text" x-model="item.notes"
                               :name="'Recurrences[' + i + '].Notes'" maxlength="2000"
                               placeholder="Örn: Stopaj %20 — vergi dairesine" />
                    </div>

                    @* RecurrenceType=Monthly/Quarterly/Yearly için intervalValue otomatik.
                       template x-if ile DOM'dan çıkar — Custom'daki visible input ile name çakışması olmasın. *@
                    <template x-if="item.recurrenceType != '3'">
                        <input type="hidden"
                               x-bind:value="item.recurrenceType == '0' ? 1 : item.recurrenceType == '1' ? 3 : item.recurrenceType == '2' ? 12 : 1"
                               :name="'Recurrences[' + i + '].IntervalValue'" />
                    </template>
                </div>
            </template>
        </div>
    </div>

    <div class="form-action-row">
        <a href="/Contracts" class="btn ghost">Geri Dön</a>
        <button type="submit" class="btn primary">
            <i class="fa fa-check text-[10px]"></i> Oluştur
        </button>
    </div>
</form>

@section Scripts {
    <script>
        function wizardPanel() {
            return {
                open: false,
                file: null,
                uploading: false,
                jobId: null,
                pollTimer: null,
                result: null,
                errMsg: null,
                riskFlags: [],

                toggle() { this.open = !this.open; },

                _resetJobState() {
                    if (this.pollTimer) { clearInterval(this.pollTimer); this.pollTimer = null; }
                    this.jobId = null;
                    this.uploading = false;
                    this.result = null;
                    this.errMsg = null;
                    this.riskFlags = [];
                },

                onFile(e) {
                    this._resetJobState();
                    this.file = e.target.files[0] || null;
                },

                onDrop(e) {
                    const f = e.dataTransfer.files[0];
                    if (f) { this._resetJobState(); this.file = f; }
                },

                async upload() {
                    if (!this.file) return;
                    // Önceki iş açıksa temizle (dosyayı koru — kullanıcı tekrar göndermek istiyor).
                    if (this.pollTimer) { clearInterval(this.pollTimer); this.pollTimer = null; }
                    this.jobId = null;
                    this.result = null;
                    this.errMsg = null;
                    this.riskFlags = [];
                    this.uploading = true;

                    const fd = new FormData();
                    fd.append('file', this.file);
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    fd.append('__RequestVerificationToken', token);

                    try {
                        const r = await fetch('/Ai/WizardStart', { method: 'POST', body: fd });
                        const data = await r.json();
                        if (!r.ok) {
                            this.errMsg = data.error || 'Yükleme başarısız.';
                            this.uploading = false;
                            return;
                        }
                        this.jobId = data.jobId;
                        this.pollTimer = setInterval(() => this._poll(), 2000);
                    } catch {
                        this.errMsg = 'Ağ hatası oluştu.';
                        this.uploading = false;
                    }
                },

                async _poll() {
                    try {
                        const r = await fetch('/Ai/WizardStatus?jobId=' + encodeURIComponent(this.jobId));
                        if (!r.ok) {
                            // 4xx (job TTL doldu) veya 5xx — polling sonsuz devam etmesin.
                            clearInterval(this.pollTimer);
                            this.pollTimer = null;
                            this.uploading = false;
                            this.errMsg = r.status === 404
                                ? 'İş süresi doldu (10 dk TTL).'
                                : 'Sunucu hatası oluştu, lütfen tekrar deneyin.';
                            return;
                        }
                        const data = await r.json();
                        if (data.done) {
                            clearInterval(this.pollTimer);
                            this.pollTimer = null;
                            this.uploading = false;
                            if (data.error) { this.errMsg = data.error; return; }
                            this.result = data.result;
                            this.populate();
                        }
                    } catch { /* network transient, retry next tick */ }
                },

                populate() {
                    if (!this.result) return;
                    const r = this.result;
                    const set = (id, val) => { if (val != null) { const el = document.getElementById(id); if (el) el.value = val; } };
                    const check = (id, val) => { if (val != null) { const el = document.getElementById(id); if (el) el.checked = !!val; } };
                    set('Title', r.title);
                    set('Counterparty', r.counterparty);
                    set('Category', r.category);
                    set('StartDate', r.startDate);
                    set('EndDate', r.endDate);
                    set('Notes', r.notes);
                    set('ContractValue', r.contractValue);
                    set('GoverningLaw', r.governingLaw);
                    check('AutoRenewal', r.autoRenewal);
                    check('KvkkInvolved', r.kvkkInvolved);
                    this.riskFlags = Array.isArray(r.riskFlags) ? r.riskFlags : [];
                }
            };
        }

        function recurringPanel() {
            return {
                items: [],
                addItem() {
                    this.items.push({
                        title: '',
                        type: '0',
                        category: '0',
                        amount: '',
                        currency: 'TRY',
                        recurrenceType: '0',
                        intervalValue: 1,
                        dayOfMonth: 1,
                        monthOfYear: 1,
                        startDate: '',
                        endDate: '',
                        notes: ''
                    });
                },
                removeItem(i) {
                    this.items.splice(i, 1);
                }
            };
        }
    </script>
}
