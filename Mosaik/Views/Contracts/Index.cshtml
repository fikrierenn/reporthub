@model List<Mosaik.Models.Contract>
@using Mosaik.Models

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Sözleşmeler";
    var statusFilter = ViewBag.StatusFilter as ContractStatus?;
    var q = ViewBag.Q as string ?? "";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/">Ana Sayfa</a>
        <span aria-current="page">Sözleşmeler</span>
    </nav>
}

@section TopActions {
    <a href="/Contracts/Create" class="btn primary">
        <i class="fa fa-plus text-[10px]" aria-hidden="true"></i> Yeni Sözleşme
    </a>
}

<div class="hero">
    <h1>Sözleşmeler</h1>
    <div class="sub">
        <span class="mono">@Model.Count kayıt</span>
        @if (statusFilter.HasValue)
        {
            <span class="pill">@statusFilter</span>
        }
    </div>
</div>

@if (TempData["Warning"] is string warn)
{
    <div role="alert" class="alert warn">
        <i class="fa fa-triangle-exclamation" aria-hidden="true"></i> @warn
    </div>
}

@* Filter bar *@
<div x-data="{ q: '@q', status: '@(statusFilter?.ToString() ?? "")' }" class="filter-bar">
    <form method="get" style="display:contents;">
        <div class="search-input-wrap">
            <i class="fa fa-magnifying-glass search-input-wrap__icon" aria-hidden="true"></i>
            <input type="text" name="q" value="@q" placeholder="Başlık veya karşı taraf ara..." x-model="q" class="inp" />
        </div>
        <select name="status" x-model="status" class="inp">
            <option value="">Tüm durumlar</option>
            <option value="0">Taslak</option>
            <option value="1">Aktif</option>
            <option value="2">Süresi Doldu</option>
            <option value="3">Feshedildi</option>
        </select>
        <button type="submit" class="btn primary">Filtrele</button>
        <a href="/Contracts" class="btn ghost" x-show="q || status">Temizle</a>
    </form>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="fa fa-file-contract empty-state__icon" aria-hidden="true"></i>
        <h3>Sözleşme bulunamadı</h3>
        <p>Yeni sözleşme ekleyerek başlayın.</p>
    </div>
}
else
{
    <div class="table-card">
        <table class="dt">
            <thead>
                <tr>
                    <th scope="col">Başlık</th>
                    <th scope="col">Karşı Taraf</th>
                    <th scope="col">Kategori</th>
                    <th scope="col">Durum</th>
                    <th scope="col">Bitiş Tarihi</th>
                    <th scope="col" class="ta-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><a href="/Contracts/Details/@c.Id" class="data-link fw-500">@c.Title</a></td>
                        <td>@(c.Counterparty ?? "—")</td>
                        <td>@CategoryLabel(c.Category)</td>
                        <td>@StatusBadge(c.Status)</td>
                        <td>
                            @if (c.EndDate.HasValue)
                            {
                                var days = c.EndDate.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
                                <span class="@(days < 30 ? "status err" : days < 90 ? "status warn" : "status ok")">
                                    @c.EndDate.Value.ToString("dd.MM.yyyy")
                                </span>
                            }
                            else { <span>—</span> }
                        </td>
                        <td class="ta-right">
                            <a href="/Contracts/Details/@c.Id" class="btn ghost sm">Detay</a>
                            <a href="/Contracts/Edit/@c.Id" class="btn ghost sm">Düzenle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_FooterHint", (string?)$"{Model.Count} sözleşme")

@functions {
    string CategoryLabel(ContractCategory cat) => cat switch
    {
        ContractCategory.Lease      => "Kira",
        ContractCategory.Service    => "Hizmet",
        ContractCategory.Supply     => "Tedarik",
        ContractCategory.Employment => "İş",
        ContractCategory.License    => "Lisans",
        ContractCategory.Insurance  => "Sigorta",
        _                           => "Diğer"
    };

    Microsoft.AspNetCore.Html.IHtmlContent StatusBadge(ContractStatus s)
    {
        var (cls, lbl) = s switch
        {
            ContractStatus.Active     => ("ok",   "Aktif"),
            ContractStatus.Draft      => ("warn",  "Taslak"),
            ContractStatus.Expired    => ("err",   "Süresi Doldu"),
            ContractStatus.Terminated => ("err",   "Feshedildi"),
            _                         => ("",      s.ToString())
        };
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"status {cls}\">{lbl}</span>");
    }
}
