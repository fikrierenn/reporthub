@model Mosaik.ViewModels.ContractEditViewModel
@using Mosaik.Models

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Sözleşme Düzenle";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/">Ana Sayfa</a>
        <a href="/Contracts">Sözleşmeler</a>
        <a href="/Contracts/Details/@Model.Id">@Model.Title</a>
        <span aria-current="page">Düzenle</span>
    </nav>
}

@section TopActions {
    <a href="/Contracts/Details/@Model.Id" class="btn ghost">İptal</a>
}

<div class="hero">
    <h1>Sözleşme Düzenle</h1>
    <div class="sub"><span class="mono">@Model.Title</span></div>
</div>

<form method="post" action="/Contracts/Edit/@Model.Id">
    @Html.AntiForgeryToken()

    <div class="form-section-card narrow">
        <div class="form-section-head">Bilgiler</div>
        <div class="form-section-body stack">
            <div class="field">
                <label class="lab" for="Title">Başlık <span class="req">*</span></label>
                <input class="inp" id="Title" name="Title" value="@Model.Title" required maxlength="200" />
            </div>
            <div class="field">
                <label class="lab" for="Counterparty">Karşı Taraf</label>
                <input class="inp" id="Counterparty" name="Counterparty" value="@Model.Counterparty" maxlength="200" />
            </div>
            <div class="grid-2col">
                <div class="field">
                    <label class="lab" for="Category">Kategori</label>
                    <select class="inp" id="Category" name="Category">
                        @foreach (var v in (List<Mosaik.Core.Lookup.DictionaryValue>)ViewBag.ContractCategories)
                        {
                            <option value="@v.Code" selected="@(string.Equals(Model.Category.ToString(), v.Code, StringComparison.OrdinalIgnoreCase))">@v.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label class="lab" for="Status">Durum</label>
                    <select class="inp" id="Status" name="Status">
                        <option value="0" selected="@(Model.Status == ContractStatus.Draft)">Taslak</option>
                        <option value="1" selected="@(Model.Status == ContractStatus.Active)">Aktif</option>
                        <option value="2" selected="@(Model.Status == ContractStatus.Expired)">Süresi Doldu</option>
                        <option value="3" selected="@(Model.Status == ContractStatus.Terminated)">Feshedildi</option>
                    </select>
                </div>
            </div>
            <div class="grid-2col">
                <div class="field">
                    <label class="lab" for="StartDate">Başlangıç</label>
                    <input class="inp" id="StartDate" type="date" name="StartDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="field">
                    <label class="lab" for="EndDate">Bitiş</label>
                    <input class="inp" id="EndDate" type="date" name="EndDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                </div>
            </div>
            <div class="field">
                <label class="lab" for="Notes">Notlar</label>
                <textarea class="inp" id="Notes" name="Notes" rows="3" maxlength="2000">@Model.Notes</textarea>
            </div>
        </div>
    </div>

    <div class="action-row narrow">
        <a href="/Contracts/Details/@Model.Id" class="btn ghost">Geri Dön</a>
        <button type="submit" class="btn primary">Kaydet</button>
    </div>
</form>
