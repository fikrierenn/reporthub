@model Mosaik.Models.Contract
@using Mosaik.Models

@{
    Layout = "_AppLayout";
    ViewData["Title"] = Model.Title;
    var extractions = ViewBag.Extractions as List<ContractAiExtraction> ?? new();
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/">Ana Sayfa</a>
        <a href="/Contracts">Sözleşmeler</a>
        <span aria-current="page">@Model.Title</span>
    </nav>
}

@section TopActions {
    <a href="/Contracts/Edit/@Model.Id" class="btn primary">
        <i class="fa fa-pen text-[10px]"></i> Düzenle
    </a>
}

<div class="hero">
    <h1>@Model.Title</h1>
    <div class="sub">
        @if (Model.Counterparty is not null)
        {
            <span>@Model.Counterparty</span>
        }
        <span class="pill">@CategoryLabel(Model.Category)</span>
        @{
            var (cls, lbl) = Model.Status switch
            {
                ContractStatus.Active     => ("ok",   "Aktif"),
                ContractStatus.Draft      => ("warn",  "Taslak"),
                ContractStatus.Expired    => ("err",   "Süresi Doldu"),
                ContractStatus.Terminated => ("err",   "Feshedildi"),
                _                         => ("",      Model.Status.ToString())
            };
        }
        <span class="pill"><span class="dot @cls"></span>@lbl</span>
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    @await Html.PartialAsync("_AlertMessage", ("success", msg))
}
@if (TempData["Warning"] is string warn)
{
    @await Html.PartialAsync("_AlertMessage", ("warn", warn))
}
@if (TempData["Error"] is string err)
{
    @await Html.PartialAsync("_AlertMessage", ("error", err))
}

<div class="detail-header-grid">

    @* Sol kolon *@
    <div>
        @* Özet *@
        <div class="form-section-card">
            <div class="form-section-head">Sözleşme Detayı</div>
            <div class="form-section-body detail-grid">
                <div><span class="text-muted">Başlangıç</span><br/>@(Model.StartDate?.ToString("dd.MM.yyyy") ?? "—")</div>
                <div><span class="text-muted">Bitiş</span><br/>
                    @if (Model.EndDate.HasValue)
                    {
                        var days = Model.EndDate.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
                        <span class="@(days < 30 ? "status err" : days < 90 ? "status warn" : "")">@Model.EndDate.Value.ToString("dd.MM.yyyy")</span>
                        if (days >= 0) { <text> (<span class="text-xs">@days gün kaldı</span>)</text> }
                    }
                    else { <text>—</text> }
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="col-span-2"><span class="text-muted">Notlar</span><br/>@Model.Notes</div>
                }
            </div>
        </div>

        @* Yükümlülükler *@
        <div class="form-section-card">
            <div class="form-section-head with-actions">
                <span>Yükümlülükler <span class="mono text-xs">@Model.Obligations.Count</span></span>
                <a href="/Obligations/Create?contractId=@Model.Id" class="btn sm primary">
                    <i class="fa fa-plus text-[9px]"></i> Ekle
                </a>
            </div>
            @if (!Model.Obligations.Any())
            {
                <div class="form-section-body ta-center"><span class="text-muted text-sm">Henüz yükümlülük yok.</span></div>
            }
            else
            {
                <table class="dt">
                    <thead>
                        <tr>
                            <th>Başlık</th>
                            <th>Vade</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Obligations)
                        {
                            <tr>
                                <td>@o.Title</td>
                                <td>
                                    @{
                                        var daysLeft = o.DueDate.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
                                    }
                                    <span class="@(daysLeft < 0 ? "status err" : daysLeft < 7 ? "status warn" : "")">
                                        @o.DueDate.ToString("dd.MM.yyyy")
                                    </span>
                                </td>
                                <td>
                                    @if (o.Amount.HasValue)
                                    {
                                        <span>@o.Amount.Value.ToString("N0") @o.Currency</span>
                                    }
                                    else { <text>—</text> }
                                </td>
                                <td>@ObligationStatusBadge(o.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* AI Analizler *@
        @if (extractions.Any())
        {
            <div class="form-section-card">
                <div class="form-section-head">AI Analiz Geçmişi</div>
                <table class="dt">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th>Model</th>
                            <th>Token</th>
                            <th class="text-right">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in extractions)
                        {
                            <tr>
                                <td><span class="ago">@x.CreatedAt.ToString("dd.MM.yy HH:mm")</span></td>
                                <td>@ExtractionStatusBadge(x.Status)</td>
                                <td><span class="mono text-xs">@(x.ModelUsed ?? "—")</span></td>
                                <td><span class="mono text-xs">@(x.InputTokens + x.OutputTokens)</span></td>
                                <td class="text-right">
                                    <a href="/Ai/Detail/@x.Id" class="btn sm ghost" title="Çıkarım detayı">
                                        <i class="fa fa-file-lines text-[9px]"></i>
                                    </a>
                                    @if (x.Status == ExtractionStatus.AwaitingReview)
                                    {
                                        <a href="/Ai/Review/@x.Id" class="btn sm primary" title="İnceleme">
                                            <i class="fa fa-magnifying-glass text-[9px]"></i>
                                            İncele
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* Sağ kolon — Dosyalar *@
    <div>
        <div class="form-section-card">
            <div class="form-section-head">Dosyalar</div>
            <div class="form-section-body">
                <form method="post" action="/Contracts/UploadFile" enctype="multipart/form-data" class="mb-14">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="contractId" value="@Model.Id" />
                    <div class="file-row">
                        <input type="file" name="file" accept=".pdf,.doc,.docx"
                               class="inp text-xs" />
                        <button type="submit" class="btn sm primary">
                            <i class="fa fa-upload text-[9px]"></i> Yükle
                        </button>
                    </div>
                </form>

                @if (!Model.Files.Any())
                {
                    <p class="text-xs text-muted ta-center">Henüz dosya yok.</p>
                }
                else
                {
                    <div class="file-row">
                        @foreach (var f in Model.Files)
                        {
                            var fileExt = extractions.FirstOrDefault(e => e.ContractFileId == f.Id);
                            var isPdf = f.MimeType == "application/pdf";
                            <div class="file-row__head">
                                <i class="fa fa-file-pdf text-err icon-md"></i>
                                <div class="flex-fill">
                                    <div class="text-strong text-truncate">@f.FileName</div>
                                    <div class="text-muted">@(f.FileSize / 1024) KB</div>
                                </div>
                                @if (isPdf)
                                {
                                    <a href="/@f.FilePath" target="_blank" class="btn sm ghost" title="PDF önizleme">
                                        <i class="fa fa-eye text-[9px]"></i>
                                    </a>
                                    @if (fileExt != null)
                                    {
                                        @* Mevcut AI çıkarımı var — sadece izlet *@
                                        <a href="/Ai/Detail/@fileExt.Id" class="btn sm ghost" title="AI çıkarımını görüntüle">
                                            <i class="fa fa-robot text-[9px]"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        @* AI hiç çalıştırılmamış — kullanıcı isterse tetikleyebilir *@
                                        <form method="post" action="/Contracts/StartAiExtraction" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="contractFileId" value="@f.Id" />
                                            <button type="submit" class="btn sm ghost" title="AI ile analiz et">
                                                <i class="fa fa-wand-magic-sparkles text-[9px]"></i>
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string CategoryLabel(ContractCategory cat) => cat switch
    {
        ContractCategory.Lease      => "Kira",
        ContractCategory.Service    => "Hizmet",
        ContractCategory.Supply     => "Tedarik",
        ContractCategory.Employment => "İş",
        ContractCategory.License    => "Lisans",
        ContractCategory.Insurance  => "Sigorta",
        _                           => "Diğer"
    };

    Microsoft.AspNetCore.Html.IHtmlContent ObligationStatusBadge(ObligationStatus s)
    {
        var (cls, lbl) = s switch
        {
            ObligationStatus.Completed => ("ok",   "Tamamlandı"),
            ObligationStatus.Overdue   => ("err",  "Gecikmiş"),
            ObligationStatus.Cancelled => ("",     "İptal"),
            _                          => ("warn", "Bekliyor")
        };
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"status {cls}\">{lbl}</span>");
    }

    Microsoft.AspNetCore.Html.IHtmlContent ExtractionStatusBadge(ExtractionStatus s)
    {
        var (cls, lbl) = s switch
        {
            ExtractionStatus.Processing     => ("warn",  "İşleniyor"),
            ExtractionStatus.AwaitingReview => ("warn",  "İnceleme Bekliyor"),
            ExtractionStatus.Approved       => ("ok",    "Onaylandı"),
            ExtractionStatus.Rejected       => ("err",   "Reddedildi"),
            ExtractionStatus.Failed         => ("err",   "Hata"),
            _                               => ("",      s.ToString())
        };
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"status {cls}\">{lbl}</span>");
    }
}
