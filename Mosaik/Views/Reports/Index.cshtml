@model Mosaik.ViewModels.ReportsIndexViewModel
@using System.Security.Claims
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Raporlar - BKM Rapor Paneli";
    ViewData["PageTitle"] = "Raporlar";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var isAdmin = User.IsInRole("admin");
    var totalCount = Model.Reports.Count;
    var favCount = Model.FavoriteReportIds.Count;
}

@section TopActions {
    @if (isAdmin)
    {
        <a href="/Admin/CreateReportV2" class="btn primary">
            <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
            Yeni Rapor
        </a>
    }
    <button type="button" class="icon-btn" title="Yardım" aria-label="Yardım">
        <i class="fas fa-circle-question" aria-hidden="true"></i>
    </button>
}

<div class="hero">
    <h1>Raporlar</h1>
    <div class="sub">
        <span class="mono">@totalCount erişilebilir rapor</span>
        @if (favCount > 0)
        {
            <span class="pill"><i class="fas fa-star pill__icon" aria-hidden="true"></i> @favCount favori</span>
        }
        @if (Model.UserRoles.Any())
        {
            <span class="pill mono">@string.Join(" · ", Model.UserRoles)</span>
        }
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="filter-bar__field filter-bar__field--grow">
        <label class="lab" for="reportSearch">Arama</label>
        <div class="search-input-wrap">
            <span class="search-input-wrap__icon">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            </span>
            <input type="text" id="reportSearch" name="q" value="@Model.SearchTerm"
                   class="inp"
                   placeholder="Rapor adı, açıklama veya grup..." />
        </div>
    </div>

    <div class="filter-bar__field">
        <label class="lab" for="reportGroup">Grup</label>
        <select id="reportGroup" name="group" class="inp">
            <option value="">Tüm gruplar</option>
            @foreach (var grpName in Model.Groups)
            {
                if (grpName == Model.SelectedGroup)
                {
                    <option value="@grpName" selected>@grpName</option>
                }
                else
                {
                    <option value="@grpName">@grpName</option>
                }
            }
        </select>
    </div>

    <div class="filter-bar__actions">
        <button type="submit" class="btn primary">
            <i class="fas fa-filter text-[10px]" aria-hidden="true"></i>
            Filtrele
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.SelectedGroup))
        {
            <a href="/Reports" class="btn ghost">
                <i class="fas fa-xmark text-[10px]" aria-hidden="true"></i>
                Temizle
            </a>
        }
    </div>
</form>

@if (!Model.Reports.Any())
{
    <div class="empty-state">
        <i class="fas fa-folder-open empty-state__icon" aria-hidden="true"></i>
        <h3>Erişilebilir rapor bulunamadı</h3>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.SelectedGroup))
        {
            <p>Filtre kriterlerini değiştirin veya <a href="/Reports" class="data-link fw-500">filtreyi temizle</a>.</p>
        }
        else
        {
            <p>Yöneticinizden rol veya rapor erişimi isteyin.</p>
        }
    </div>
}
else
{
    <div class="quick-grid">
        @foreach (var report in Model.Reports)
        {
            var isFavorite = Model.FavoriteReportIds.Contains(report.ReportId);
            var groupNames = report.ReportGroups
                .Select(rg => rg.Group?.Name ?? "")
                .Where(name => !string.IsNullOrWhiteSpace(name))
                .ToList();
            var displaySub = string.IsNullOrWhiteSpace(report.Description)
                ? (groupNames.Count > 0 ? string.Join(", ", groupNames) : (report.DataSource?.Title ?? report.DataSourceKey))
                : report.Description;
            <div class="qcard">
                <div class="row1">
                    <span class="type-chip type-dash">Dashboard</span>
                    <span class="qcard__id">#@report.ReportId</span>
                    <form method="post" action="@(isFavorite ? "/Reports/Unfavorite" : "/Reports/Favorite")" class="fav-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reportId" value="@report.ReportId" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit"
                                class="fav @(isFavorite ? "on" : "")"
                                title="@(isFavorite ? "Favoriden kaldır" : "Favorilere ekle")">
                            @if (isFavorite)
                            {
                                <i class="fas fa-star" aria-hidden="true"></i>
                            }
                            else
                            {
                                <i class="far fa-star" aria-hidden="true"></i>
                            }
                        </button>
                    </form>
                </div>
                <a href="/Reports/Run?reportId=@report.ReportId" class="qcard__link">
                    <h3>@report.Title</h3>
                    <div class="sub">@displaySub</div>
                    <div class="meta">
                        <span class="ago">
                            <i class="fas fa-database qcard__db-icon" aria-hidden="true"></i>
                            @(report.DataSource?.Title ?? report.DataSourceKey)
                        </span>
                        <span class="run">Çalıştır <i class="fas fa-arrow-right text-[10px]" aria-hidden="true"></i></span>
                    </div>
                </a>
            </div>
        }
    </div>
}

@{
    var reportsFooter = $"{totalCount} rapor";
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) reportsFooter += $" · arama \"{Model.SearchTerm}\"";
    if (!string.IsNullOrWhiteSpace(Model.SelectedGroup)) reportsFooter += $" · grup {Model.SelectedGroup}";
}

@await Html.PartialAsync("_FooterHint", (string?)reportsFooter)
