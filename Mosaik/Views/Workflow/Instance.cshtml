@model Mosaik.ViewModels.Workflow.WorkflowInstanceDetailViewModel
@using Mosaik.Core.Workflow
@using System.Text.Json
@{
    Layout = "_AppLayout";
    ViewData["Title"] = $"Onay Akışı #{Model.Instance.Id}";

    string EventLabel(string e) => e switch
    {
        "InstanceStarted" => "Akış başladı",
        "StepEntered" => "Adım açıldı",
        "StepCompleted" => "Adım onaylandı",
        "StepRejected" => "Adım reddedildi",
        "StepReassigned" => "Yeniden atandı",
        "EscalationFired" => "Yöneticiye eskalasyon",
        "DelayScheduled" => "Bekleme başladı",
        "InstanceCompleted" => "Akış tamamlandı",
        "InstanceCancelled" => "Akış iptal edildi",
        "ManagerResolved" => "Amir belirlendi (org şeması)",
        "ManagerResolutionFailed" => "Amir belirlenemedi — rol grubuna atandı",
        _ => e
    };
    string EventIcon(string e) => e switch
    {
        "InstanceStarted" => "fas fa-play",
        "StepEntered" => "fas fa-arrow-right",
        "StepCompleted" => "fas fa-check",
        "StepRejected" => "fas fa-xmark",
        "StepReassigned" => "fas fa-people-arrows",
        "EscalationFired" => "fas fa-bell",
        "DelayScheduled" => "fas fa-hourglass-half",
        "InstanceCompleted" => "fas fa-flag-checkered",
        "InstanceCancelled" => "fas fa-ban",
        "ManagerResolved" => "fas fa-sitemap",
        "ManagerResolutionFailed" => "fas fa-sitemap",
        _ => "fas fa-circle"
    };
    // Entity tipi Türkçe etiket (kart başlığı ham EntityType basıyordu — turkish-ui).
    string EntityTypeLabel(string t) => t?.ToLowerInvariant() switch
    {
        "formsubmission" => "Form Yanıtı",
        "processinstance" => "Vaka",
        "contract" => "Sözleşme",
        "circular" or "tamim" => "Tamim",
        _ => t ?? ""
    };
    string EventColor(string e) => e switch
    {
        "StepCompleted" or "InstanceCompleted" => "ok",
        "StepRejected" or "InstanceCancelled" => "err",
        "EscalationFired" => "warn",
        _ => ""
    };
    (string cls, string lbl) StatusPill(WorkflowInstanceStatus s) => s switch
    {
        WorkflowInstanceStatus.Active => ("ok", "Aktif"),
        WorkflowInstanceStatus.Completed => ("", "Tamamlandı"),
        WorkflowInstanceStatus.Cancelled => ("err", "İptal"),
        _ => ("", s.ToString())
    };
    string StepTypeLabel(string? t) => t?.ToLowerInvariant() switch
    {
        "approval" => "Onay",
        "notify" => "Bilgilendirme",
        "delay" => "Bekleme",
        _ => t ?? ""
    };
    (string? Comment, bool Auto, string? Other) ParsePayload(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return (null, false, null);
        try
        {
            using var doc = JsonDocument.Parse(json);
            var r = doc.RootElement;
            string? comment = null, other = null; bool auto = false;
            if (r.ValueKind == JsonValueKind.Object)
            {
                if (r.TryGetProperty("comment", out var c) && c.ValueKind == JsonValueKind.String) comment = c.GetString();
                if (r.TryGetProperty("auto", out var a)) auto = a.ValueKind == JsonValueKind.True;
                var extras = new List<string>();
                foreach (var p in r.EnumerateObject())
                {
                    if (p.Name is "comment" or "auto") continue;
                    // TR + gürültü temizliği: approved→Karar, reason→Sebep; boş değer gösterme.
                    var val = p.Value.ToString();
                    if (string.IsNullOrWhiteSpace(val)) continue;
                    var label = p.Name switch
                    {
                        "approved" => p.Value.ValueKind == JsonValueKind.True ? "Karar: Onay" : "Karar: Red",
                        "reason" => val == "auto-notify" ? "Sebep: otomatik bilgilendirme" : $"Sebep: {val}",
                        "payload" => null, // iç teknik alan — gösterme
                        _ => $"{p.Name}: {val}"
                    };
                    if (label != null) extras.Add(label);
                }
                if (extras.Count > 0) other = string.Join(" · ", extras);
            }
            return (comment, auto, other);
        }
        catch { return (null, false, json); }
    }

    var inst = Model.Instance;
    var (statusCls, statusLbl) = StatusPill(inst.Status);
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/">Ana Sayfa</a>
        <a href="/Workflow/Inbox">Onay Akışları</a>
        <span aria-current="page">#@inst.Id</span>
    </nav>
}

@section TopActions {
    @if (inst.Status == WorkflowInstanceStatus.Active)
    {
        <a class="btn" href="/Workflow/Instance/@(inst.Id).ics" download>
            <i class="fas fa-calendar-plus text-[10px]" aria-hidden="true"></i> Takvime Ekle
        </a>
    }
    @if (!string.IsNullOrEmpty(Model.EntityUrl))
    {
        <a class="btn primary" href="@Model.EntityUrl">
            <i class="fas fa-up-right-from-square text-[10px]" aria-hidden="true"></i> Belgeyi Aç
        </a>
    }
}

<div class="hero">
    <h1>@(inst.Template?.Name ?? "Onay Akışı") #@inst.Id</h1>
    <div class="sub">
        <span class="pill"><span class="dot @statusCls"></span>@statusLbl</span>
        @if (!string.IsNullOrEmpty(Model.StartedByName))
        {
            <span><strong>@Model.StartedByName</strong> başlattı</span>
        }
        <span>@inst.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    @await Html.PartialAsync("_AlertMessage", ("success", msg))
}

<div class="detail-header-grid">

    @* Sol kolon: Entity preview + Timeline *@
    <div>
        <div class="form-section-card">
            <div class="form-section-head">@EntityTypeLabel(inst.EntityType)</div>
            <div class="form-section-body">
                <h2 class="wf-entity-card__title">@Model.EntityTitle</h2>
                @if (!string.IsNullOrEmpty(Model.EntitySummary))
                {
                    <div class="text-muted">@Model.EntitySummary</div>
                }
            </div>
        </div>

        <div class="form-section-card">
            <div class="form-section-head">Olay Zaman Çizelgesi</div>
            <div class="form-section-body">
                <ul class="wf-timeline">
                    @foreach (var log in Model.Logs)
                    {
                        var (cmt, auto, other) = ParsePayload(log.PayloadJson);
                        var actorName = log.ActorId.HasValue
                            ? Model.ActorNames.GetValueOrDefault(log.ActorId.Value, $"Kullanıcı #{log.ActorId}")
                            : null;
                        var colorCls = EventColor(log.EventType);
                        <li class="wf-timeline-item">
                            <span class="wf-timeline-dot @colorCls">
                                <i class="@EventIcon(log.EventType)" aria-hidden="true"></i>
                            </span>
                            <div class="wf-timeline-body">
                                <div class="wf-timeline-title">@EventLabel(log.EventType)</div>
                                <div class="text-muted text-xs">
                                    @log.OccurredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    @if (!string.IsNullOrEmpty(actorName))
                                    {
                                        <span> · <strong>@actorName</strong></span>
                                    }
                                    @if (!string.IsNullOrEmpty(log.StepId))
                                    {
                                        <span> · @log.StepId</span>
                                    }
                                    @if (auto)
                                    {
                                        <span> · <em>otomatik</em></span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(cmt))
                                {
                                    <blockquote class="wf-timeline-comment">@cmt</blockquote>
                                }
                                @if (!string.IsNullOrEmpty(other))
                                {
                                    <div class="text-xs text-muted wf-timeline-extras">@other</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    @* Sağ kolon: Aktif step + karar paneli *@
    <div>
        @if (inst.Status == WorkflowInstanceStatus.Active && !string.IsNullOrEmpty(Model.CurrentStepName))
        {
            <div class="form-section-card wf-current-step-card">
                <div class="form-section-head">Şu Anki Adım</div>
                <div class="form-section-body">
                    <h3 class="wf-current-step__title">@Model.CurrentStepName</h3>
                    <dl class="wf-step-meta">
                        <dt>Tür</dt><dd>@StepTypeLabel(Model.CurrentStepType)</dd>
                        @if (!string.IsNullOrEmpty(Model.CurrentStepAssigneeName))
                        {
                            <dt>Atanan</dt><dd>@Model.CurrentStepAssigneeName</dd>
                        }
                        @if (Model.CurrentStepDeadlineDays.HasValue)
                        {
                            <dt>Süre</dt><dd>@Model.CurrentStepDeadlineDays gün</dd>
                        }
                        @if (Model.CurrentStepEnteredAt.HasValue)
                        {
                            <dt>Açıldı</dt><dd>@Model.CurrentStepEnteredAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                        }
                        @if (Model.CurrentStepRequireComment)
                        {
                            <dt>Yorum</dt><dd><span class="pill warn">Zorunlu</span></dd>
                        }
                    </dl>
                </div>
            </div>
        }

        @if (Model.CanRespond)
        {
            <div class="form-section-card">
                <div class="form-section-head">Kararını Ver</div>
                <div class="form-section-body">
                    <form method="post" action="/Workflow/Instance/@inst.Id/Respond">
                        @Html.AntiForgeryToken()
                        <div class="field">
                            <label class="lab" for="comment-input">
                                Yorum @(Model.CurrentStepRequireComment ? "(zorunlu)" : "(opsiyonel)")
                            </label>
                            <textarea id="comment-input" name="Comment" class="inp" rows="4"
                                      placeholder="Karar gerekçesi"
                                      @(Model.CurrentStepRequireComment ? "required" : "")></textarea>
                        </div>
                        <div class="action-row">
                            <button type="submit" name="Approved" value="true" class="btn primary">
                                <i class="fas fa-check text-[10px]" aria-hidden="true"></i> Onayla
                            </button>
                            <button type="submit" name="Approved" value="false" class="btn danger">
                                <i class="fas fa-xmark text-[10px]" aria-hidden="true"></i> Reddet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else if (inst.Status == WorkflowInstanceStatus.Active)
        {
            <div class="form-section-card">
                <div class="form-section-body ta-center">
                    <span class="text-muted text-sm">Bu adım sana atanmadığı için karar veremezsin.</span>
                </div>
            </div>
        }
        else
        {
            <div class="form-section-card">
                <div class="form-section-body ta-center">
                    <span class="text-muted text-sm">
                        Akış kapanmış.
                        @if (inst.CompletedAt.HasValue)
                        {
                            <br/>
                            <span class="text-xs">@inst.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </span>
                </div>
            </div>
        }
    </div>

</div>
