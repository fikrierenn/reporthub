@model Mosaik.Models.Workflow.WorkflowInstance
@using Mosaik.Core.Workflow
@{
    ViewData["Title"] = $"Workflow #{Model.Id}";
    Layout = "_AppLayout";
    var logs = ViewBag.Logs as IReadOnlyList<WorkflowInstanceLogDto> ?? new List<WorkflowInstanceLogDto>();
    var canRespond = (bool)(ViewBag.CanRespond ?? false);

    string EventLabel(string e) => e switch
    {
        "InstanceStarted" => "Akış başladı",
        "StepEntered" => "Adım açıldı",
        "StepCompleted" => "Adım onaylandı",
        "StepRejected" => "Adım reddedildi",
        "StepReassigned" => "Yeniden atandı",
        "EscalationFired" => "Yöneticiye eskalasyon",
        "InstanceCompleted" => "Akış tamamlandı",
        "InstanceCancelled" => "Akış iptal edildi",
        _ => e
    };

    string EventIcon(string e) => e switch
    {
        "InstanceStarted" => "fas fa-play",
        "StepEntered" => "fas fa-arrow-right",
        "StepCompleted" => "fas fa-check",
        "StepRejected" => "fas fa-xmark",
        "StepReassigned" => "fas fa-people-arrows",
        "EscalationFired" => "fas fa-bell",
        "InstanceCompleted" => "fas fa-flag-checkered",
        "InstanceCancelled" => "fas fa-ban",
        _ => "fas fa-circle"
    };

    string StatusBadge(WorkflowInstanceStatus s) => s switch
    {
        WorkflowInstanceStatus.Active => "<span class=\"pill ok\">Aktif</span>",
        WorkflowInstanceStatus.Completed => "<span class=\"pill\">Tamamlandı</span>",
        WorkflowInstanceStatus.Cancelled => "<span class=\"pill error\">İptal</span>",
        _ => ""
    };
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Workflow/Inbox">Workflow</a>
        <span>›</span>
        <span aria-current="page">#@Model.Id</span>
    </nav>
}

<div class="hero">
    <h1>@(Model.Template?.Name ?? "Workflow") #@Model.Id</h1>
    <div class="sub">
        <span class="mono">@Model.EntityType #@Model.EntityId</span>
        <span>·</span>
        @Html.Raw(StatusBadge(Model.Status))
        @if (Model.CurrentStepId is not null)
        {
            <span>·</span>
            <span>Aktif adım: <strong>@Model.CurrentStepId</strong></span>
        }
    </div>
</div>

@if (Model.Status == Mosaik.Core.Workflow.WorkflowInstanceStatus.Active && Model.CurrentStepId is not null)
{
    <div class="action-row">
        <a class="btn ghost sm" href="/Workflow/Instance/@(Model.Id).ics" download>
            <i class="fas fa-calendar-plus"></i> Takvime Ekle (.ics)
        </a>
    </div>
}

@if (!string.IsNullOrEmpty(TempData["Message"] as string))
{
    <div role="alert" class="alert success">@TempData["Message"]</div>
}

<div class="wf-grid">

    <section class="paper-card">
        <header class="paper-card-header">
            <h2>Olay Zaman Çizelgesi</h2>
        </header>
        <ul class="wf-timeline">
            @foreach (var log in logs)
            {
                <li class="wf-timeline-item">
                    <span class="wf-timeline-dot">
                        <i class="@EventIcon(log.EventType)" aria-hidden="true"></i>
                    </span>
                    <div class="wf-timeline-body">
                        <div class="wf-timeline-title">@EventLabel(log.EventType)</div>
                        <div class="text-muted text-xs">
                            @log.OccurredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            @if (log.ActorId.HasValue) { <span> · UserId @log.ActorId</span> }
                            @if (!string.IsNullOrEmpty(log.StepId)) { <span> · @log.StepId</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(log.PayloadJson))
                        {
                            <pre class="wf-timeline-payload">@log.PayloadJson</pre>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>

    <aside>
        @if (canRespond)
        {
            <section class="paper-card with-padding-lg">
                <h2>Kararını Ver</h2>
                <form method="post" action="/Workflow/Instance/@Model.Id/Respond">
                    @Html.AntiForgeryToken()
                    <div class="field">
                        <label class="lab" for="comment-input">Yorum</label>
                        <textarea id="comment-input" name="Comment" class="inp" rows="4" placeholder="Karar gerekçesi (opsiyonel)"></textarea>
                    </div>
                    <div class="wf-decision-row">
                        <button type="submit" name="Approved" value="true" class="btn primary">
                            <i class="fas fa-check"></i> Onayla
                        </button>
                        <button type="submit" name="Approved" value="false" class="btn danger">
                            <i class="fas fa-xmark"></i> Reddet
                        </button>
                    </div>
                </form>
            </section>
        }
        else if (Model.Status == WorkflowInstanceStatus.Active)
        {
            <section class="paper-card with-padding-lg">
                <p class="text-muted">Bu adım sana atanmadığı için karar veremezsin.</p>
            </section>
        }
        else
        {
            <section class="paper-card with-padding-lg">
                <p class="text-muted">Akış kapanmış.</p>
                @if (Model.CompletedAt.HasValue)
                {
                    <p class="text-xs">Tamamlanma: @Model.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                }
            </section>
        }
    </aside>

</div>
