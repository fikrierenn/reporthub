@model List<Mosaik.Core.Notification.Notification>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Bildirimler — Mosaik";
    ViewData["PageTitle"] = "Bildirimler";

    var filter = (string)(ViewData["Filter"] ?? "all");
    var unreadCount = Model.Count(n => !n.IsRead);
    var totalCount = Model.Count;
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <span aria-current="page">Bildirimler</span>
    </nav>
}

@section TopActions {
    @if (unreadCount > 0)
    {
        <form method="post" action="/Notifications/MarkAllAsRead" class="inline-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn ghost">
                <i class="fas fa-check-double text-[10px]" aria-hidden="true"></i>
                Tümünü okundu işaretle
            </button>
        </form>
    }
}

<div class="hero">
    <h1>Bildirimler</h1>
    <p class="sub">
        <span class="mono">@totalCount kayıt</span>
        @if (unreadCount > 0)
        {
            <span class="pill notif-pill-warn">
                <i class="fas fa-circle-exclamation text-[9px]" aria-hidden="true"></i>
                @unreadCount okunmamış
            </span>
        }
    </p>
</div>

@if (!string.IsNullOrWhiteSpace(TempData["Message"] as string))
{
    @await Html.PartialAsync("_AlertMessage", ((string)(TempData["MessageType"] ?? "success"), (string)TempData["Message"]!))
}

<div role="tablist" aria-label="Filtre" class="notif-tabs">
    <a href="?filter=all" role="tab" aria-selected="@(filter == "all" ? "true" : "false")" class="btn @(filter == "all" ? "primary" : "ghost") sm">
        Tümü
    </a>
    <a href="?filter=unread" role="tab" aria-selected="@(filter == "unread" ? "true" : "false")" class="btn @(filter == "unread" ? "primary" : "ghost") sm">
        Okunmamış
    </a>
    <a href="?filter=read" role="tab" aria-selected="@(filter == "read" ? "true" : "false")" class="btn @(filter == "read" ? "primary" : "ghost") sm">
        Okunmuş
    </a>
</div>

<div class="notif-list">
    @if (Model.Count == 0)
    {
        <div class="notif-empty">
            <i class="fas fa-bell-slash icon" aria-hidden="true"></i>
            <h3>Bildirim yok</h3>
            <p>
                @(filter switch {
                    "unread" => "Okunmamış bildirim yok.",
                    "read" => "Henüz okuduğun bildirim yok.",
                    _ => "Henüz hiç bildirim almadınız."
                })
            </p>
        </div>
    }
    else
    {
        <ul>
            @foreach (var n in Model)
            {
                <li class="notif-item @(n.IsRead ? "" : "unread") @(!string.IsNullOrWhiteSpace(n.TargetUrl) ? "is-link" : "")">
                    <span class="notif-dot" aria-hidden="true">
                        <i class="fas fa-circle"></i>
                    </span>
                    <div class="notif-body">
                        @if (!string.IsNullOrWhiteSpace(n.TargetUrl))
                        {
                            <a href="/Notifications/Open/@n.Id" class="notif-stretched" aria-label="@n.Title"></a>
                        }
                        <div class="notif-head">
                            <strong class="notif-title">@n.Title</strong>
                            <span class="notif-time ago">@n.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(n.Message))
                        {
                            <p class="notif-msg">@n.Message</p>
                        }
                    </div>
                    <div class="notif-actions">
                        @if (!n.IsRead)
                        {
                            <form method="post" action="/Notifications/MarkAsRead" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id" />
                                <button type="submit" class="btn sm" title="Okundu işaretle">
                                    <i class="fas fa-check text-[9px]" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>
