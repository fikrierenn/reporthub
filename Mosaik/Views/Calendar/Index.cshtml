@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Takvim";
    ViewData["PageTitle"] = "Takvim";
}

@section Head {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Ana Sayfa</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Takvim</span>
    </nav>
}

@section TopActions {
    <button type="button" class="btn primary" id="btnNewEvent">
        <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
        Etkinlik Ekle
    </button>
    <button type="button" class="icon-btn" title="Yardım" aria-label="Yardım">
        <i class="fas fa-circle-question" aria-hidden="true"></i>
    </button>
}

<div class="hero">
    <h1>Takvim</h1>
    <div class="sub">
        <span>Sözleşme tarihleri ve yükümlülük takviminiz</span>
    </div>
</div>

@* Kaynak filtre chip'leri (ADR-016) *@
<div class="filter-bar" x-data="calSourceFilter()" x-cloak>
    <div class="filter-chips" role="group" aria-label="Kaynak filtresi">
        <button type="button" class="chip" :class="{ active: isActive('ContractEvent') }" @@click="toggle('ContractEvent')">
            <span class="legend-dot contract"></span>Sözleşme Olayları
        </button>
        <button type="button" class="chip" :class="{ active: isActive('Obligation') }" @@click="toggle('Obligation')">
            <span class="legend-dot obligation"></span>Yükümlülükler
        </button>
        <button type="button" class="chip" :class="{ active: isActive('Holiday') }" @@click="toggle('Holiday')">
            <span class="legend-dot holiday"></span>Resmi Tatiller
        </button>
        <button type="button" class="chip" :class="{ active: isActive('ImportantDate') }" @@click="toggle('ImportantDate')">
            <span class="legend-dot important"></span>Önemli Günler
        </button>
    </div>
</div>

<div class="form-section-card padded">
    <div id="calendar"></div>
</div>

@* Etkinlik Detay Modal *@
<div id="eventModal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-hidden="true" tabindex="-1">
    <div class="modal-card">
        <div class="modal-head">
            <h3 id="modalTitle" class="modal-title"></h3>
            <button type="button" class="icon-btn modal-close" onclick="closeEventModal()" title="Kapat">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="meta-row">
                <i class="fas fa-calendar-day" aria-hidden="true"></i>
                <span id="modalDate"></span>
            </div>
            <div class="meta-row">
                <i class="fas fa-tag" aria-hidden="true"></i>
                <span id="modalType"></span>
                <span id="modalStatus" class="pill"></span>
            </div>
            <div id="modalContractRow" class="meta-row is-hidden">
                <i class="fas fa-file-contract" aria-hidden="true"></i>
                <a id="modalContractLink" href="#" class="accent-link"></a>
            </div>
            <div id="modalNotesRow" class="meta-row top is-hidden">
                <i class="fas fa-note-sticky mt-2" aria-hidden="true"></i>
                <span id="modalNotes" class="ink-3"></span>
            </div>
        </div>
        <div class="modal-actions">
            <form id="frmComplete" method="post" action="/Calendar/Complete" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalEventId">
                <button type="submit" class="btn sm ghost">Tamamlandı İşaretle</button>
            </form>
            <form id="frmDelete" method="post" action="/Calendar/Delete" class="inline" onsubmit="return confirm('Etkinlik silinsin mi?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalEventId2">
                <button type="submit" class="btn sm danger">Sil</button>
            </form>
            <button type="button" class="btn sm primary" onclick="closeEventModal()">Kapat</button>
        </div>
    </div>
</div>

@* Etkinlik Oluşturma Modal *@
<div id="createModal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="createModalTitle" aria-hidden="true" tabindex="-1">
    <div class="modal-card">
        <h3 id="createModalTitle" class="modal-title compact">Yeni Etkinlik</h3>
        <form method="post" action="/Calendar/Create" id="frmCreate">
            @Html.AntiForgeryToken()
            <div class="field">
                <label class="lab" for="evTitle">Başlık</label>
                <input class="inp" type="text" id="evTitle" name="Title" required maxlength="200">
            </div>
            <div class="modal-form-grid">
                <div class="field">
                    <label class="lab" for="evDate">Tarih</label>
                    <input class="inp" type="date" id="evDate" name="EventDate" required>
                </div>
                <div class="field">
                    <label class="lab" for="evType">Tür</label>
                    <select class="inp" id="evType" name="EventType">
                        <option value="0">Ödeme</option>
                        <option value="1" selected>Son Tarih</option>
                        <option value="2">Yenileme</option>
                        <option value="3">Vergi</option>
                        <option value="4">Uyumluluk</option>
                        <option value="5">Operasyon</option>
                    </select>
                </div>
            </div>
            <div class="field mt-12">
                <label class="lab" for="evNotes">Not (opsiyonel)</label>
                <textarea class="inp" id="evNotes" name="Notes" rows="2" maxlength="500"></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn ghost" onclick="closeCreateModal()">İptal</button>
                <button type="submit" class="btn primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script>
    (function () {
        var calendar;
        var activeSources = new Set(['ContractEvent', 'Obligation', 'Holiday', 'ImportantDate']);

        // Alpine component — ADR-016 kaynak filtresi
        window.calSourceFilter = function () {
            return {
                isActive: function (src) { return activeSources.has(src); },
                toggle: function (src) {
                    if (activeSources.has(src)) { activeSources.delete(src); }
                    else { activeSources.add(src); }
                    if (calendar) calendar.refetchEvents();
                }
            };
        };

        function buildEventsUrl(info) {
            var params = 'year=' + info.start.getFullYear() + '&month=' + (info.start.getMonth() + 1);
            if (activeSources.size > 0 && activeSources.size < 4) {
                params += '&sources=' + Array.from(activeSources).join(',');
            }
            return '/Calendar/Events?' + params;
        }

        function sourceLabel(sourceType) {
            var map = { ContractEvent: 'Sözleşme Olayı', Obligation: 'Yükümlülük',
                        Holiday: 'Resmi Tatil', ImportantDate: 'Önemli Gün' };
            return map[sourceType] || sourceType;
        }

        function openEventModal(info) {
            var p = info.event.extendedProps;
            document.getElementById('modalTitle').textContent  = info.event.title;
            document.getElementById('modalDate').textContent   = info.event.startStr;
            document.getElementById('modalType').textContent   = sourceLabel(p.sourceType);
            document.getElementById('modalStatus').textContent = '';
            document.getElementById('modalEventId').value      = info.event.id;
            document.getElementById('modalEventId2').value     = info.event.id;

            // Sözleşme bağlantısı sadece ContractEvent için
            var contractRow = document.getElementById('modalContractRow');
            if (p.sourceType === 'ContractEvent' && p.contractTitle && p.contractId) {
                document.getElementById('modalContractLink').textContent = p.contractTitle;
                document.getElementById('modalContractLink').href = '/Contracts/Details/' + p.contractId;
                contractRow.classList.remove('is-hidden');
            } else {
                contractRow.classList.add('is-hidden');
            }

            var notesRow = document.getElementById('modalNotesRow');
            if (p.notes) {
                document.getElementById('modalNotes').textContent = p.notes;
                notesRow.classList.remove('is-hidden');
            } else {
                notesRow.classList.add('is-hidden');
            }

            // Sistem tatilleri ve yükümlülükler silinemez/tamamlanamaz
            var isSystemEvent = p.sourceType === 'Holiday';
            document.getElementById('frmComplete').style.display = isSystemEvent ? 'none' : '';
            document.getElementById('frmDelete').style.display   = isSystemEvent ? 'none' : '';

            var em = document.getElementById('eventModal');
            em.classList.add('is-open');
            em.setAttribute('aria-hidden', 'false');
            if (window.MosaikFocusTrap) window.MosaikFocusTrap.activate(em);
        }

        window.closeEventModal = function () {
            var em = document.getElementById('eventModal');
            em.classList.remove('is-open');
            em.setAttribute('aria-hidden', 'true');
            if (window.MosaikFocusTrap) window.MosaikFocusTrap.deactivate(em);
        };

        window.closeCreateModal = function () {
            var cm = document.getElementById('createModal');
            cm.classList.remove('is-open');
            cm.setAttribute('aria-hidden', 'true');
            if (window.MosaikFocusTrap) window.MosaikFocusTrap.deactivate(cm);
        };

        document.getElementById('btnNewEvent').addEventListener('click', function () {
            var today = new Date().toISOString().split('T')[0];
            document.getElementById('evDate').value = today;
            var cm = document.getElementById('createModal');
            cm.classList.add('is-open');
            cm.setAttribute('aria-hidden', 'false');
            if (window.MosaikFocusTrap) window.MosaikFocusTrap.activate(cm);
        });

        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            var em = document.getElementById('eventModal');
            var cm = document.getElementById('createModal');
            if (em && em.classList.contains('is-open')) { window.closeEventModal(); return; }
            if (cm && cm.classList.contains('is-open')) { window.closeCreateModal(); return; }
        });

        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('calendar');
            calendar = new FullCalendar.Calendar(el, {
                locale: 'tr',
                initialView: 'dayGridMonth',
                height: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listMonth'
                },
                buttonText: { today: 'Bugün', month: 'Ay', week: 'Hafta', list: 'Liste' },
                events: function (info, success, failure) {
                    fetch(buildEventsUrl(info))
                        .then(function (r) { return r.json(); })
                        .then(success)
                        .catch(failure);
                },
                eventClick: openEventModal,
                eventTimeFormat: { hour: '2-digit', minute: '2-digit', meridiem: false }
            });
            calendar.render();
        });
    })();
    </script>
}
