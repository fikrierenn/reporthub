@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Takvim";
    ViewData["PageTitle"] = "Takvim";
}

@section Head {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Ana Sayfa</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Takvim</span>
    </nav>
}

@section TopActions {
    <button type="button" class="btn primary" id="btnNewEvent">
        <i class="fas fa-plus text-[10px]"></i>
        Etkinlik Ekle
    </button>
    <a href="#" class="icon-btn" title="Yardım">
        <i class="fas fa-circle-question"></i>
    </a>
}

<div class="hero">
    <h1>Takvim</h1>
    <div class="sub">
        <span>Sözleşme tarihleri ve yükümlülük takviminiz</span>
    </div>
</div>

@* Renk açıklamaları *@
<div style="display:flex; gap:16px; flex-wrap:wrap; margin-bottom:16px; align-items:center;">
    <span class="pill"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#dc2626;margin-right:4px;"></span>Ödeme / Son Tarih</span>
    <span class="pill"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#d97706;margin-right:4px;"></span>Vergi / Uyumluluk</span>
    <span class="pill"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#92400e;margin-right:4px;"></span>Yenileme</span>
    <span class="pill"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#2563eb;margin-right:4px;"></span>Operasyon</span>
    <span class="pill"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#6b7280;margin-right:4px;"></span>Tamamlandı</span>
</div>

<div class="form-section-card" style="padding:20px;">
    <div id="calendar"></div>
</div>

@* Etkinlik Detay Modal *@
<div id="eventModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:9000; align-items:center; justify-content:center;">
    <div style="background:var(--paper); border-radius:12px; padding:28px; width:480px; max-width:95vw; box-shadow:0 20px 60px rgba(0,0,0,.2);">
        <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:16px;">
            <h3 id="modalTitle" style="font-size:15px; font-weight:600; color:var(--ink-1); margin:0; line-height:1.4;"></h3>
            <button type="button" class="icon-btn" onclick="closeEventModal()" title="Kapat" style="margin-left:12px; flex-shrink:0;">
                <i class="fas fa-xmark"></i>
            </button>
        </div>
        <div style="display:flex; flex-direction:column; gap:10px; font-size:13px; color:var(--ink-2);">
            <div style="display:flex; gap:8px; align-items:center;">
                <i class="fas fa-calendar-day" style="color:var(--ink-4); width:16px;"></i>
                <span id="modalDate"></span>
            </div>
            <div style="display:flex; gap:8px; align-items:center;">
                <i class="fas fa-tag" style="color:var(--ink-4); width:16px;"></i>
                <span id="modalType"></span>
                <span id="modalStatus" class="pill" style="margin-left:4px;"></span>
            </div>
            <div id="modalContractRow" style="display:none; gap:8px; align-items:center;">
                <i class="fas fa-file-contract" style="color:var(--ink-4); width:16px;"></i>
                <a id="modalContractLink" href="#" style="color:var(--accent); font-size:13px;"></a>
            </div>
            <div id="modalNotesRow" style="display:none; gap:8px; align-items:flex-start;">
                <i class="fas fa-note-sticky" style="color:var(--ink-4); width:16px; margin-top:2px;"></i>
                <span id="modalNotes" style="color:var(--ink-3);"></span>
            </div>
        </div>
        <div style="display:flex; gap:8px; margin-top:20px; justify-content:flex-end;">
            <form id="frmComplete" method="post" action="/Calendar/Complete" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalEventId">
                <button type="submit" class="btn sm ghost">Tamamlandı İşaretle</button>
            </form>
            <form id="frmDelete" method="post" action="/Calendar/Delete" style="margin:0;" onsubmit="return confirm('Etkinlik silinsin mi?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalEventId2">
                <button type="submit" class="btn sm danger">Sil</button>
            </form>
            <button type="button" class="btn sm primary" onclick="closeEventModal()">Kapat</button>
        </div>
    </div>
</div>

@* Etkinlik Oluşturma Modal *@
<div id="createModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:9000; align-items:center; justify-content:center;">
    <div style="background:var(--paper); border-radius:12px; padding:28px; width:480px; max-width:95vw; box-shadow:0 20px 60px rgba(0,0,0,.2);">
        <h3 style="font-size:15px; font-weight:600; margin:0 0 20px; color:var(--ink-1);">Yeni Etkinlik</h3>
        <form method="post" action="/Calendar/Create" id="frmCreate">
            @Html.AntiForgeryToken()
            <div class="field">
                <label class="lab" for="evTitle">Başlık</label>
                <input class="inp" type="text" id="evTitle" name="Title" required maxlength="200">
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
                <div class="field">
                    <label class="lab" for="evDate">Tarih</label>
                    <input class="inp" type="date" id="evDate" name="EventDate" required>
                </div>
                <div class="field">
                    <label class="lab" for="evType">Tür</label>
                    <select class="inp" id="evType" name="EventType">
                        <option value="0">Ödeme</option>
                        <option value="1" selected>Son Tarih</option>
                        <option value="2">Yenileme</option>
                        <option value="3">Vergi</option>
                        <option value="4">Uyumluluk</option>
                        <option value="5">Operasyon</option>
                    </select>
                </div>
            </div>
            <div class="field" style="margin-top:12px;">
                <label class="lab" for="evNotes">Not (opsiyonel)</label>
                <textarea class="inp" id="evNotes" name="Notes" rows="2" maxlength="500"></textarea>
            </div>
            <div style="display:flex; gap:8px; margin-top:20px; justify-content:flex-end;">
                <button type="button" class="btn ghost" onclick="closeCreateModal()">İptal</button>
                <button type="submit" class="btn primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script>
    (function () {
        var calendar;

        function openEventModal(info) {
            var p = info.event.extendedProps;
            document.getElementById('modalTitle').textContent   = info.event.title;
            document.getElementById('modalDate').textContent    = info.event.startStr;
            document.getElementById('modalType').textContent    = p.typeLabel;
            document.getElementById('modalStatus').textContent  = p.statusLabel;
            document.getElementById('modalEventId').value       = info.event.id;
            document.getElementById('modalEventId2').value      = info.event.id;

            var contractRow = document.getElementById('modalContractRow');
            if (p.contractTitle && p.contractId) {
                document.getElementById('modalContractLink').textContent = p.contractTitle;
                document.getElementById('modalContractLink').href = '/Contracts/Details/' + p.contractId;
                contractRow.style.display = 'flex';
            } else {
                contractRow.style.display = 'none';
            }

            var notesRow = document.getElementById('modalNotesRow');
            if (p.notes) {
                document.getElementById('modalNotes').textContent = p.notes;
                notesRow.style.display = 'flex';
            } else {
                notesRow.style.display = 'none';
            }

            document.getElementById('eventModal').style.display = 'flex';
        }

        window.closeEventModal = function () {
            document.getElementById('eventModal').style.display = 'none';
        };

        window.closeCreateModal = function () {
            document.getElementById('createModal').style.display = 'none';
        };

        document.getElementById('btnNewEvent').addEventListener('click', function () {
            var today = new Date().toISOString().split('T')[0];
            document.getElementById('evDate').value = today;
            document.getElementById('createModal').style.display = 'flex';
        });

        document.addEventListener('DOMContentLoaded', function () {
            var el = document.getElementById('calendar');
            calendar = new FullCalendar.Calendar(el, {
                locale: 'tr',
                initialView: 'dayGridMonth',
                height: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listMonth'
                },
                buttonText: {
                    today: 'Bugün',
                    month: 'Ay',
                    week: 'Hafta',
                    list: 'Liste'
                },
                events: function (info, success, failure) {
                    fetch('/Calendar/Events?year=' + info.start.getFullYear() + '&month=' + (info.start.getMonth() + 1))
                        .then(function (r) { return r.json(); })
                        .then(success)
                        .catch(failure);
                },
                eventClick: openEventModal,
                eventTimeFormat: { hour: '2-digit', minute: '2-digit', meridiem: false }
            });
            calendar.render();
        });
    })();
    </script>
}
