@using Mosaik.Core.Module.Capabilities
@using Mosaik.ViewModels.Ui
@using Mosaik.ViewModels.Search
@model SearchResultsViewModel

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Arama";
    ViewData["HideSearch"] = true; // topbar arama kutusu zaten q'yu taşıdı, sayfada tekrar gösterme.

    var hasQuery = !string.IsNullOrWhiteSpace(Model.Query) && Model.Query.Trim().Length >= 2;

    // Sonuçları kaynağa (ProviderKey) göre grupla — her grup kendi EntityLabel başlığını taşır.
    var groups = Model.Results
        .GroupBy(r => new { r.ProviderKey, r.EntityLabel })
        .OrderBy(g => g.Key.EntityLabel)
        .ToList();

    string ProviderIcon(string key) => key switch
    {
        "report" => "fa-chart-bar",
        "contract" => "fa-file-signature",
        "obligation" => "fa-calendar-check",
        "circular" => "fa-bullhorn",
        "sop" => "fa-book-open",
        _ => "fa-magnifying-glass"
    };
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/">Ana Sayfa</a>
        <span aria-current="page">Arama</span>
    </nav>
}

<div class="hero">
    <h1>Arama</h1>
    <div class="sub">
        @if (hasQuery)
        {
            <span class="pill">@Model.Query</span>
            <span class="mono">@Model.Results.Count sonuç</span>
        }
        else
        {
            <span class="text-muted">Aramak için bir terim girin.</span>
        }
    </div>
</div>

@if (!hasQuery)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
    {
        Icon = "fa-magnifying-glass",
        Title = "Arama yapın",
        Message = "Rapor, sözleşme, yükümlülük veya tamim aramak için en az 2 karakter girin."
    })
}
else if (Model.Results.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
    {
        Icon = "fa-folder-open",
        Title = "Sonuç bulunamadı",
        Message = $"\"{Model.Query}\" için erişiminiz dahilinde eşleşen kayıt yok."
    })
}
else
{
    foreach (var group in groups)
    {
        <section class="form-section-card">
            <header class="form-section-head">
                <span class="form-section-head__title">
                    <i class="fas @ProviderIcon(group.Key.ProviderKey) text-[12px]" aria-hidden="true"></i>
                    @group.Key.EntityLabel
                    <span class="mono">(@group.Count())</span>
                </span>
            </header>
            <div class="table-card">
                <table class="dt">
                    <thead>
                        <tr>
                            <th scope="col">Kaynak</th>
                            <th scope="col">Başlık</th>
                            <th scope="col">Açıklama</th>
                            <th scope="col">Tarih</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in group)
                        {
                            <tr>
                                <td><span class="pill">@item.EntityLabel</span></td>
                                <td class="fw-500"><a href="@item.Url" class="data-link">@item.Title</a></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Snippet))
                                    {
                                        <span class="text-muted">@item.Snippet</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Date.HasValue)
                                    {
                                        <span class="ago">@item.Date.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @await Html.PartialAsync("_FooterHint", (string?)$"{Model.Results.Count} sonuç")
}
