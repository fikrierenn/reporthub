@using Mosaik.Modules.Tamim.Models
@model Mosaik.Modules.Tamim.Models.Tamim
@{
    ViewData["Title"] = Model.Title;
    var (badgeBg, badgeFg, statusLabel) = Model.Status switch
    {
        TamimStatus.Draft => ("#f3f4f6", "#374151", "Taslak"),
        TamimStatus.Pending => ("#fef3c7", "#92400e", "Onay Bekliyor"),
        TamimStatus.Approved => ("#dbeafe", "#1e40af", "Onaylandı"),
        TamimStatus.Published => ("#dcfce7", "#166534", "Yayında"),
        TamimStatus.Rejected => ("#fee2e2", "#991b1b", "Reddedildi"),
        TamimStatus.Archived => ("#e5e7eb", "#4b5563", "Arşivlendi"),
        _ => ("#f3f4f6", "#374151", Model.Status.ToString())
    };
}

<div class="container" style="padding:24px;">
    <a href="@Url.Action("Index")" style="color:var(--muted, #6b7280); text-decoration:none; font-size:14px;">
        <i class="fas fa-arrow-left"></i> Tamim Listesi
    </a>

    <div style="background:var(--paper, #fff); border:1px solid var(--line, #e5e7eb); border-radius:8px; padding:24px; margin-top:14px;">
        <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:16px;">
            <h1 style="margin:0;">@Model.Title</h1>
            <span style="background:@badgeBg; color:@badgeFg; padding:5px 12px; border-radius:5px; font-size:13px; font-weight:500;">
                @statusLabel
            </span>
        </div>

        <div style="color:var(--muted, #6b7280); font-size:13px; margin-bottom:20px;">
            <span><i class="fas fa-calendar"></i> Oluşturma: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
            @if (Model.PublishDate.HasValue)
            {
                <span style="margin-left:16px;"><i class="fas fa-bullhorn"></i> Yayın: @Model.PublishDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
            }
            @if (Model.ExpiresAt.HasValue)
            {
                <span style="margin-left:16px;"><i class="fas fa-hourglass-end"></i> Geçerlilik: @Model.ExpiresAt.Value.ToString("dd.MM.yyyy")</span>
            }
        </div>

        <div style="border-top:1px solid var(--line, #e5e7eb); padding-top:16px; line-height:1.7; white-space:pre-wrap;">
            @Model.Body
        </div>

        <div style="margin-top:24px; padding-top:16px; border-top:1px solid var(--line, #e5e7eb); display:flex; gap:8px; flex-wrap:wrap;">
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn">
                <i class="fas fa-pen"></i> Düzenle
            </a>

            @if (Model.Status == TamimStatus.Draft)
            {
                <form method="post" action="@Url.Action("ChangeStatus")" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@((int)TamimStatus.Pending)" />
                    <button type="submit" class="btn primary"><i class="fas fa-paper-plane"></i> Onaya Gönder</button>
                </form>
            }
            @if (Model.Status == TamimStatus.Pending || Model.Status == TamimStatus.Approved)
            {
                <form method="post" action="@Url.Action("ChangeStatus")" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@((int)TamimStatus.Published)" />
                    <button type="submit" class="btn primary"><i class="fas fa-bullhorn"></i> Yayınla</button>
                </form>
            }
            @if (Model.Status == TamimStatus.Pending)
            {
                <form method="post" action="@Url.Action("ChangeStatus")" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@((int)TamimStatus.Rejected)" />
                    <button type="submit" class="btn ghost"><i class="fas fa-times"></i> Reddet</button>
                </form>
            }
            @if (Model.Status == TamimStatus.Published)
            {
                <form method="post" action="@Url.Action("ChangeStatus")" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@((int)TamimStatus.Archived)" />
                    <button type="submit" class="btn ghost"><i class="fas fa-archive"></i> Arşivle</button>
                </form>
            }
            @if (Model.Status != TamimStatus.Published)
            {
                <form method="post" action="@Url.Action("Delete")" style="display:inline; margin-left:auto;"
                      onsubmit="return confirm('Tamimi silmek istediğine emin misin?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn ghost" style="color:#991b1b;">
                        <i class="fas fa-trash"></i> Sil
                    </button>
                </form>
            }
        </div>
    </div>
</div>
