@model Mosaik.Modules.Tamim.ViewModels.TamimFormViewModel
@{
    ViewData["Title"] = "Yeni Tamim";
}

<div class="container" style="padding:24px; max-width:900px;">
    <a href="@Url.Action("Index")" style="color:var(--muted, #6b7280); text-decoration:none; font-size:14px;">
        <i class="fas fa-arrow-left"></i> Tamim Listesi
    </a>

    <h1 style="margin:14px 0 20px;"><i class="fas fa-plus"></i> Yeni Tamim</h1>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div style="padding:10px 14px; margin-bottom:14px; border-radius:6px;
                    background:@(Model.MessageType == "success" ? "#dcfce7" : "#fee2e2");
                    color:@(Model.MessageType == "success" ? "#166534" : "#991b1b");
                    border:1px solid @(Model.MessageType == "success" ? "#86efac" : "#fca5a5");">
            @Model.Message
        </div>
    }

    <form method="post" action="@Url.Action("Create")"
          style="background:var(--paper, #fff); border:1px solid var(--line, #e5e7eb); border-radius:8px; padding:24px;">
        @Html.AntiForgeryToken()

        <div class="field">
            <label class="lab" for="Title">Başlık <span style="color:var(--accent);">*</span></label>
            <input type="text" id="Title" name="Title" value="@Model.Title" class="inp" maxlength="200" required />
            <span asp-validation-for="Title" style="color:#991b1b; font-size:12px;"></span>
        </div>

        <div class="field">
            <label class="lab" for="Body">İçerik <span style="color:var(--accent);">*</span></label>
            <textarea id="Body" name="Body" class="inp" rows="12" required>@Model.Body</textarea>
            <span asp-validation-for="Body" style="color:#991b1b; font-size:12px;"></span>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div class="field">
                <label class="lab" for="PublishDate">Yayın Tarihi (opsiyonel)</label>
                <input type="datetime-local" id="PublishDate" name="PublishDate"
                       value="@(Model.PublishDate?.ToString("yyyy-MM-ddTHH:mm"))" class="inp" />
            </div>
            <div class="field">
                <label class="lab" for="ExpiresAt">Geçerlilik Sonu (opsiyonel)</label>
                <input type="datetime-local" id="ExpiresAt" name="ExpiresAt"
                       value="@(Model.ExpiresAt?.ToString("yyyy-MM-ddTHH:mm"))" class="inp" />
            </div>
        </div>

        <div style="margin-top:20px; display:flex; gap:8px;">
            <button type="submit" class="btn primary"><i class="fas fa-save"></i> Kaydet (Taslak)</button>
            <a href="@Url.Action("Index")" class="btn ghost">İptal</a>
        </div>
    </form>
</div>
