@using Mosaik.Modules.Tamim.Models
@model GunlukBlok
@{
    ViewData["Title"] = Model.Konu;
    var blokTuruMap = ViewBag.BlokTuruMap as Dictionary<int, string> ?? new();
    blokTuruMap.TryGetValue(Model.BlokTuruId, out var turLabel);
    var (badgeBg, badgeFg, statusLabel) = Model.TamimId.HasValue
        ? ("#dcfce7", "#166534", "Yayında")
        : ("#fef3c7", "#92400e", "Bekleyen");
}

<div class="container" style="padding:24px;">
    <a href="@Url.Action("Index")" style="color:var(--muted, #6b7280); text-decoration:none; font-size:14px;">
        <i class="fas fa-arrow-left"></i> Blok Listesi
    </a>

    <div style="background:var(--paper, #fff); border:1px solid var(--line, #e5e7eb); border-radius:8px; padding:24px; margin-top:14px;">
        <div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:16px; gap:16px;">
            <div>
                <div style="font-family:monospace; font-size:12px; color:var(--muted, #6b7280); margin-bottom:4px;">@Model.BlokNo</div>
                <h1 style="margin:0;">
                    @Model.Konu
                    @if (Model.Acil) { <span style="color:#dc2626; margin-left:8px;"><i class="fas fa-exclamation-triangle"></i> ACİL</span> }
                </h1>
            </div>
            <span style="background:@badgeBg; color:@badgeFg; padding:5px 12px; border-radius:5px; font-size:13px; font-weight:500; white-space:nowrap;">
                @statusLabel
            </span>
        </div>

        <div style="color:var(--muted, #6b7280); font-size:13px; margin-bottom:20px; display:flex; gap:20px; flex-wrap:wrap;">
            <span><i class="fas fa-tag"></i> Tür: @(turLabel ?? "—")</span>
            <span><i class="fas fa-building"></i> Departman: @Model.DepartmanAdi</span>
            <span><i class="fas fa-calendar"></i> Tarih: @Model.BlokTarihi.ToString("dd.MM.yyyy")</span>
        </div>

        <div style="border-top:1px solid var(--line, #e5e7eb); padding-top:16px; line-height:1.7; white-space:pre-wrap;">
            @Model.Aciklama
        </div>

        @if (!Model.TamimId.HasValue)
        {
            <div style="margin-top:24px; padding-top:16px; border-top:1px solid var(--line, #e5e7eb); display:flex; gap:8px;">
                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn">
                    <i class="fas fa-pen"></i> Düzenle
                </a>
                <form method="post" action="@Url.Action("Delete")" style="display:inline; margin-left:auto;"
                      onsubmit="return confirm('Bloku silmek istediğine emin misin?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn ghost" style="color:#991b1b;">
                        <i class="fas fa-trash"></i> Sil
                    </button>
                </form>
            </div>
        }
        else
        {
            <div style="margin-top:24px; padding-top:16px; border-top:1px solid var(--line, #e5e7eb); color:var(--muted, #6b7280); font-size:13px;">
                <i class="fas fa-info-circle"></i> Bu blok yayınlanmış bir tamime dahil edildi. Düzenleme/silme kapalı.
            </div>
        }
    </div>
</div>
