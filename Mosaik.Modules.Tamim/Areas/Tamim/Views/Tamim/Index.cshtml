@using Mosaik.Modules.Tamim.Models
@model List<Tamim>
@{
    ViewData["Title"] = "Günlük Tamimler";
}

<div class="container" style="padding:24px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h1 style="margin:0;"><i class="fas fa-bullhorn"></i> Günlük Tamimler</h1>
        <a href="@Url.Action("Index", "Blok")" class="btn ghost">
            <i class="fas fa-clipboard-list"></i> Bloklar
        </a>
    </div>

    @if (!Model.Any())
    {
        <div style="background:var(--paper, #fff); border:1px solid var(--line, #e5e7eb); border-radius:8px; padding:30px; text-align:center; color:var(--muted, #6b7280);">
            Son 30 günde yayınlanmış tamim yok.
            <p style="font-size:13px; margin-top:10px;">
                Sistem her gün <strong>17:00</strong>'de o güne ait blokları otomatik tamim olarak yayınlar.
            </p>
        </div>
    }

    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:16px;">
        @foreach (var t in Model)
        {
            <a href="@Url.Action("Details", new { id = t.Id })"
               style="background:var(--paper, #fff); border:1px solid var(--line, #e5e7eb); border-radius:8px; padding:20px; text-decoration:none; color:inherit; transition:border-color 0.2s;"
               onmouseover="this.style.borderColor='var(--accent, #f59e0b)'"
               onmouseout="this.style.borderColor='var(--line, #e5e7eb)'">
                <div style="font-family:monospace; font-size:11px; color:var(--muted, #6b7280); margin-bottom:6px;">@t.TamimNo</div>
                <h3 style="margin:0 0 8px; color:var(--accent, #f59e0b);">@t.Baslik</h3>
                <div style="color:var(--muted, #6b7280); font-size:13px;">
                    <i class="fas fa-calendar"></i> @t.TamimTarihi.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                </div>
                <div style="color:var(--muted, #6b7280); font-size:12px; margin-top:4px;">
                    <i class="fas fa-clock"></i> Yayın: @t.YayinTarihi.ToString("HH:mm")
                </div>
            </a>
        }
    </div>
</div>
