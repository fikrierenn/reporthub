@using Mosaik.Modules.Tamim.Models
@model Tamim
@{
    ViewData["Title"] = Model.Baslik;
    var bloklar = ViewBag.Bloklar as List<GunlukBlok> ?? new();
    var blokTuruMap = ViewBag.BlokTuruMap as Dictionary<int, string> ?? new();
}

<div class="container" style="padding:24px; max-width:900px;">
    <a href="@Url.Action("Index")" style="color:var(--muted, #6b7280); text-decoration:none; font-size:14px;">
        <i class="fas fa-arrow-left"></i> Tamim Listesi
    </a>

    <div style="background:var(--paper, #fff); border:1px solid var(--line, #e5e7eb); border-radius:8px; padding:24px; margin-top:14px;">
        <div style="font-family:monospace; font-size:12px; color:var(--muted, #6b7280); margin-bottom:6px;">@Model.TamimNo</div>
        <h1 style="margin:0 0 6px;">@Model.Baslik</h1>
        <div style="color:var(--muted, #6b7280); font-size:13px; margin-bottom:20px;">
            <i class="fas fa-clock"></i> Yayın: @Model.YayinTarihi.ToString("dd.MM.yyyy HH:mm")
            <span style="margin-left:14px;"><i class="fas fa-list"></i> @bloklar.Count blok</span>
        </div>

        @if (!bloklar.Any())
        {
            <div style="padding:20px; text-align:center; color:var(--muted, #6b7280); border-top:1px solid var(--line, #e5e7eb);">
                Bu tamim'e bağlı blok bulunamadı.
            </div>
        }
        else
        {
            <div style="border-top:1px solid var(--line, #e5e7eb); padding-top:14px;">
                @foreach (var b in bloklar)
                {
                    blokTuruMap.TryGetValue(b.BlokTuruId, out var turLabel);
                    <div style="border-bottom:1px solid #f3f4f6; padding:14px 0;">
                        <div style="display:flex; justify-content:space-between; align-items:start; gap:14px; margin-bottom:8px;">
                            <h3 style="margin:0; flex:1;">
                                @b.Konu
                                @if (b.Acil)
                                {
                                    <span style="background:#fee2e2; color:#991b1b; padding:2px 8px; border-radius:4px; font-size:11px; margin-left:8px; font-weight:500;">
                                        <i class="fas fa-exclamation-triangle"></i> ACİL
                                    </span>
                                }
                            </h3>
                            <span style="background:#dbeafe; color:#1e40af; padding:3px 10px; border-radius:4px; font-size:12px; font-weight:500; white-space:nowrap;">
                                @(turLabel ?? "—")
                            </span>
                        </div>
                        <div style="color:var(--muted, #6b7280); font-size:12px; margin-bottom:10px;">
                            <i class="fas fa-building"></i> @b.DepartmanAdi
                            <span style="margin-left:14px; font-family:monospace;">@b.BlokNo</span>
                        </div>
                        <div style="line-height:1.7; white-space:pre-wrap; color:#1f2937;">
                            @b.Aciklama
                        </div>
                    </div>
                }
            </div>
        }

        <div style="margin-top:20px; padding-top:14px; border-top:1px solid var(--line, #e5e7eb); color:var(--muted, #6b7280); font-size:12px;">
            <i class="fas fa-eye"></i> Tamim'i görüntülediğin için okuma logu kaydedildi.
        </div>
    </div>
</div>
