@inject Mosaik.Core.Html.IContentSanitizer Sanitizer
@model Mosaik.Modules.Circular.ViewModels.BlockFormViewModel
@{
    ViewData["Title"] = "Yeni Block";
    ViewData["PageTitle"] = "Yeni Block";
}

@section Head {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index", "Circular")">Tamim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index")">Bloklarım</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Yeni Blok</span>
    </nav>
}

@section TopActions {
    <a href="@Url.Action("Index")" class="btn">
        <i class="fas fa-xmark text-[10px]"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Yeni Blok</h1>
    <div class="sub">
        <span>Bugünün tamimine eklenecek karar/uyarı/duyuru</span>
        <span class="pill"><span class="dot err"></span>Bağlayıcı — kayıt yasal kanıt olur</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    @await Html.PartialAsync("_AlertMessage", (Model.MessageType == "success" ? "success" : "error", Model.Message))
}

<form method="post" action="@Url.Action("Create")" id="blok-form" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-pen-to-square icon-mr"></i>
                Blok Bilgileri
            </h2>
            <p class="form-section-head__sub">Gerekli alanları doldurun</p>
        </div>

        <div class="form-section-body">
            <div class="form-row-2col">
                <div class="field">
                    <label class="lab" for="BlockTypeId">Blok Türü <span class="req">*</span></label>
                    <select id="BlockTypeId" name="BlockTypeId" class="inp" required>
                        <option value="">— Seçin —</option>
                        @foreach (var opt in Model.BlockTypeOptions)
                        {
                            <option value="@opt.Id" selected="@(Model.BlockTypeId == opt.Id)">@opt.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label class="lab" for="Subject">Subject <span class="req">*</span></label>
                    <input type="text" id="Subject" name="Subject" value="@Model.Subject" class="inp" maxlength="200" required placeholder="örn: KVKK Eğitimi Hatırlatma" />
                </div>
            </div>

            <div class="field">
                <label class="lab" for="Department">Departman <span class="req">*</span></label>
                <input type="text" id="Department" name="Department" value="@Model.Department" class="inp" maxlength="100" required placeholder="örn: İnsan Kaynakları" />
            </div>

            <div class="field">
                <label class="lab" for="editor-container">Detaylı içerik <span class="req">*</span></label>
                <div class="tamim-quill">
                    @* Content QuillContentSanitizer ile save-time sanitize edildi (BlockService) *@
                    <div id="editor-container" class="tamim-quill__editor">@Html.Raw(Sanitizer.Sanitize(Model.Content))</div>
                </div>
                <textarea id="Content" name="Content" hidden>@Model.Content</textarea>
                <p class="help-text">
                    <i class="fas fa-circle-info" aria-hidden="true"></i>
                    Yapay zekâ bu içerikten tamim özetini akşam üretecek (Plan 17 Faz F)
                </p>
            </div>

            <div class="field mb-0">
                <div class="tamim-urgent-toggle">
                    <input type="checkbox" id="IsUrgent" name="IsUrgent" value="true" @(Model.IsUrgent ? "checked" : "")
                           class="checkbox" />
                    <label for="IsUrgent" class="lab">
                        <i class="fas fa-bolt" aria-hidden="true"></i>
                        IsUrgent — kırmızı vurgu, AI özette başa al
                    </label>
                </div>
            </div>
        </div>
    </div>

    @* Faz E — Dosya ekleme (blok kaydıyla birlikte) *@
    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-paperclip icon-mr" aria-hidden="true"></i>
                Ekli Dosyalar
                <span class="form-section-head__inline-note">(opsiyonel)</span>
            </h2>
            <p class="form-section-head__sub">PDF, DOCX, XLSX, JPG, PNG, TXT — max 10 MB her dosya</p>
        </div>
        <div class="form-section-body">
            <div class="upload-zone lg">
                <i class="fas fa-cloud-arrow-up upload-icon" aria-hidden="true"></i>
                <div class="upload-title">Dosyaları seç</div>
                <input type="file" name="files" multiple
                       accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png,.txt"
                       class="inp upload-input" />
                <p class="help-text upload-sub">Birden fazla dosya seçebilirsin (Ctrl/Cmd + tık).</p>
            </div>
        </div>
    </div>

    <div class="form-action-row wide">
        <a href="@Url.Action("Index")" class="btn ghost">
            <i class="fas fa-arrow-left text-[10px]"></i>
            Geri Dön
        </a>
        <button type="submit" class="btn primary">
            <i class="fas fa-check text-[10px]"></i>
            Bloğu Kaydet
        </button>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        (function () {
            const editorEl = document.getElementById('editor-container');
            const hiddenEl = document.getElementById('Content');
            if (!editorEl || !hiddenEl || typeof Quill === 'undefined') return;
            const quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                        ['link'],
                        ['clean']
                    ]
                },
                placeholder: 'Tamimin tam metnini buraya yaz...'
            });
            const form = document.getElementById('blok-form');
            if (form) {
                form.addEventListener('submit', function () {
                    hiddenEl.value = quill.root.innerHTML;
                });
            }
        })();
    </script>
}
