@using Mosaik.Modules.Circular.Models
@model Mosaik.Modules.Circular.ViewModels.BlockFormViewModel
@{
    ViewData["Title"] = "Block Düzenle";
    ViewData["PageTitle"] = "Block Düzenle";
    var files = ViewBag.Files as List<BlockFile> ?? new();

    string FormatBoyut(long b) =>
        b < 1024 ? $"{b} B"
        : b < 1024 * 1024 ? $"{b / 1024} KB"
        : $"{b / 1024.0 / 1024:0.#} MB";

    string ExtClass(string ext) => ext.ToLowerInvariant() switch
    {
        "pdf" => "pdf",
        "docx" or "doc" => "docx",
        "xlsx" or "xls" => "xlsx",
        "jpg" or "jpeg" or "png" => "img",
        _ => ""
    };
}

@section Head {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index", "Circular")">Tamim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index")">Bloklarım</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Details", new { id = Model.Id })">@Model.BlockNumber</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Düzenle</span>
    </nav>
}

@section TopActions {
    <a href="@Url.Action("Details", new { id = Model.Id })" class="btn">
        <i class="fas fa-xmark text-[10px]"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Blok Düzenle</h1>
    <div class="sub">
        <span class="mono">@Model.BlockNumber</span>
        <span class="pill"><span class="dot"></span>Henüz tamime girmemiş — düzenlenebilir</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div role="alert" style="margin-bottom:18px; padding:12px 16px; border-radius:10px; font-size:13px; max-width:880px;
                background: @(Model.MessageType == "success" ? "var(--success-bg-soft)" : "var(--danger-bg-soft)");
                border: 1px solid @(Model.MessageType == "success" ? "rgba(16,185,129,0.25)" : "rgba(220,38,38,0.25)");
                color: @(Model.MessageType == "success" ? "var(--success-ink-soft)" : "var(--accent-ink)");">
        <i class="fas @(Model.MessageType == "success" ? "fa-check-circle" : "fa-exclamation-circle")" style="margin-right:8px;"></i>
        @Model.Message
    </div>
}

<form method="post" action="@Url.Action("Edit", new { id = Model.Id })" id="blok-form" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; overflow:hidden; max-width:880px; margin-bottom:18px;">
        <div style="padding:14px 18px; border-bottom:1px solid var(--line);">
            <h2 style="font-size:13px; font-weight:600; color:var(--ink-1); margin:0;">
                <i class="fas fa-pen-to-square" style="margin-right:6px; color:var(--ink-3);"></i>
                Blok Bilgileri
            </h2>
        </div>

        <div style="padding:20px;">
            <div style="display:grid; grid-template-columns:160px 1fr; gap:14px; margin-bottom:14px;">
                <div class="field" style="margin-bottom:0;">
                    <label class="lab" for="BlockTypeId">Blok Türü <span style="color:var(--accent);">*</span></label>
                    <select id="BlockTypeId" name="BlockTypeId" class="inp" required>
                        <option value="">— Seçin —</option>
                        @foreach (var opt in Model.BlockTypeOptions)
                        {
                            <option value="@opt.Id" selected="@(Model.BlockTypeId == opt.Id)">@opt.Label</option>
                        }
                    </select>
                </div>
                <div class="field" style="margin-bottom:0;">
                    <label class="lab" for="Subject">Subject <span style="color:var(--accent);">*</span></label>
                    <input type="text" id="Subject" name="Subject" value="@Model.Subject" class="inp" maxlength="200" required />
                </div>
            </div>

            <div class="field">
                <label class="lab" for="Department">Departman <span style="color:var(--accent);">*</span></label>
                <input type="text" id="Department" name="Department" value="@Model.Department" class="inp" maxlength="100" required />
            </div>

            <div class="field">
                <label class="lab" for="editor-container">Detaylı içerik <span style="color:var(--accent);">*</span></label>
                <div style="border:1px solid var(--line); border-radius:8px; overflow:hidden;">
                    @* Content QuillContentSanitizer ile save-time sanitize edildi (BlockService) *@
                    <div id="editor-container" style="min-height:240px; background:var(--paper);">@Html.Raw(Model.Content)</div>
                </div>
                <textarea id="Content" name="Content" hidden>@Model.Content</textarea>
            </div>

            <div class="field" style="margin-bottom:0;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <input type="checkbox" id="IsUrgent" name="IsUrgent" value="true" @(Model.IsUrgent ? "checked" : "")
                           style="width:16px; height:16px; accent-color:var(--accent);" />
                    <label for="IsUrgent" class="lab" style="margin:0; display:inline-flex; align-items:center; gap:6px; text-transform:none; letter-spacing:0; font-weight:400;">
                        <i class="fas fa-bolt" style="color:var(--accent); font-size:11px;"></i>
                        IsUrgent — kırmızı vurgu, AI özette başa al
                    </label>
                </div>
            </div>
        </div>
    </div>

    @* Yeni dosya ekleme — kayıt ile birlikte upload *@
    <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; overflow:hidden; max-width:880px; margin-bottom:18px;">
        <div style="padding:14px 18px; border-bottom:1px solid var(--line);">
            <h2 style="font-size:13px; font-weight:600; color:var(--ink-1); margin:0;">
                <i class="fas fa-paperclip" style="margin-right:6px; color:var(--ink-3);"></i>
                Yeni Dosya Ekle
                <span style="font-size:11px; font-weight:400; color:var(--ink-3); margin-left:6px;">(opsiyonel — birden fazla seçebilirsin)</span>
            </h2>
            <div style="font-size:12px; color:var(--ink-3); margin-top:2px;">PDF, DOCX, XLSX, JPG, PNG, TXT — max 10 MB her dosya</div>
        </div>
        <div style="padding:20px;">
            <div style="border:2px dashed var(--line); border-radius:10px; padding:20px; text-align:center;">
                <i class="fas fa-cloud-arrow-up" style="font-size:28px; color:var(--ink-4); margin-bottom:6px;" aria-hidden="true"></i>
                <input type="file" name="files" multiple
                       accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png,.txt"
                       class="inp" style="max-width:420px; padding:6px;" />
            </div>
        </div>
    </div>

    <div style="display:flex; align-items:center; justify-content:space-between; max-width:880px; padding:14px 20px; background:var(--paper); border:1px solid var(--line); border-radius:10px;">
        <a href="@Url.Action("Details", new { id = Model.Id })" class="btn ghost">
            <i class="fas fa-arrow-left text-[10px]"></i>
            Geri Dön
        </a>
        <button type="submit" class="btn primary">
            <i class="fas fa-check text-[10px]"></i>
            Değişiklikleri Kaydet
        </button>
    </div>
</form>

@* Plan 17 Faz E — Dosya yükleme (ayrı form, multipart) *@
<div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; overflow:hidden; max-width:880px; margin-top:18px;">
    <div style="padding:14px 18px; border-bottom:1px solid var(--line);">
        <h2 style="font-size:13px; font-weight:600; color:var(--ink-1); margin:0;">
            <i class="fas fa-paperclip" style="margin-right:6px; color:var(--ink-3);"></i>
            Ekli Dosyalar
            <span class="mono" style="font-size:11px; color:var(--ink-3); margin-left:6px;">@files.Count dosya</span>
        </h2>
        <div style="font-size:12px; color:var(--ink-3); margin-top:2px;">PDF, DOCX, XLSX, JPG, PNG, TXT — max 10 MB</div>
    </div>

    <div style="padding:20px;">
        @if (files.Any())
        {
            <div style="display:flex; flex-direction:column; gap:6px; margin-bottom:14px;">
                @foreach (var d in files)
                {
                    var extCls = ExtClass(d.Extension);
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 12px; background:var(--canvas); border-radius:8px;">
                        <div style="display:flex; align-items:center; gap:10px; min-width:0;">
                            <span class="ext @extCls" style="font-size:10px; font-weight:700; padding:3px 6px; border-radius:3px; background:var(--accent); color:#fff; text-transform:uppercase;">@d.Extension</span>
                            <a href="@Url.Action("DownloadFile", new { id = d.Id })" style="font-size:13px; color:var(--ink-1); font-weight:500; text-decoration:none; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@d.FileName</a>
                            <span style="font-size:11px; color:var(--ink-3);">@FormatBoyut(d.FileSize)</span>
                        </div>
                        <form method="post" action="@Url.Action("DeleteFile", new { id = d.Id })" style="display:inline; margin:0;"
                              onsubmit="return confirm('Dosya silinsin mi?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn sm danger">
                                <i class="fas fa-trash text-[9px]"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }

        @if (!files.Any())
        {
            <div style="font-size:12.5px; color:var(--ink-3); padding:16px 0; text-align:center;">
                Henüz dosya yok. Üstteki "Yeni Dosya Ekle" alanından dosya seçip "Değişiklikleri Kaydet"e bas.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        (function () {
            const editorEl = document.getElementById('editor-container');
            const hiddenEl = document.getElementById('Content');
            if (!editorEl || !hiddenEl || typeof Quill === 'undefined') return;
            const quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                        ['link'],
                        ['clean']
                    ]
                },
                placeholder: 'Tamimin tam metnini buraya yaz...'
            });
            const form = document.getElementById('blok-form');
            if (form) {
                form.addEventListener('submit', function () {
                    hiddenEl.value = quill.root.innerHTML;
                });
            }
        })();
    </script>
}
