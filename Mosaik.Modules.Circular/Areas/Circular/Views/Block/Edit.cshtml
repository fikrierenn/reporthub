@using Mosaik.Modules.Circular.Models
@inject Mosaik.Core.Html.IContentSanitizer Sanitizer
@model Mosaik.Modules.Circular.ViewModels.BlockFormViewModel
@{
    ViewData["Title"] = "Block Düzenle";
    ViewData["PageTitle"] = "Block Düzenle";
    var files = ViewBag.Files as List<BlockFile> ?? new();

    string FormatBoyut(long b) =>
        b < 1024 ? $"{b} B"
        : b < 1024 * 1024 ? $"{b / 1024} KB"
        : $"{b / 1024.0 / 1024:0.#} MB";

    string ExtClass(string ext) => ext.ToLowerInvariant() switch
    {
        "pdf" => "pdf",
        "docx" or "doc" => "docx",
        "xlsx" or "xls" => "xlsx",
        "jpg" or "jpeg" or "png" => "img",
        _ => ""
    };
}

@section Head {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">Mosaik</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index", "Circular")">Tamim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index")">Bloklarım</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Details", new { id = Model.Id })">@Model.BlockNumber</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Düzenle</span>
    </nav>
}

@section TopActions {
    <a href="@Url.Action("Details", new { id = Model.Id })" class="btn">
        <i class="fas fa-xmark icon-xs" aria-hidden="true"></i>
        İptal
    </a>
}

<div class="hero">
    <h1>Blok Düzenle</h1>
    <div class="sub">
        <span class="mono">@Model.BlockNumber</span>
        <span class="pill"><span class="dot"></span>Henüz tamime girmemiş — düzenlenebilir</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    @await Html.PartialAsync("_AlertMessage", (Model.MessageType ?? "error", Model.Message))
}

<form method="post" action="@Url.Action("Edit", new { id = Model.Id })" id="blok-form" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-pen-to-square icon-mr" aria-hidden="true"></i>
                Blok Bilgileri
            </h2>
        </div>

        <div class="form-section-body">
            <div class="form-row-2col">
                <div class="field">
                    <label class="lab" for="BlockTypeId">Blok Türü <span class="text-danger">*</span></label>
                    <select id="BlockTypeId" name="BlockTypeId" class="inp" required>
                        <option value="">— Seçin —</option>
                        @foreach (var opt in Model.BlockTypeOptions)
                        {
                            <option value="@opt.Id" selected="@(Model.BlockTypeId == opt.Id)">@opt.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label class="lab" for="Subject">Subject <span class="text-danger">*</span></label>
                    <input type="text" id="Subject" name="Subject" value="@Model.Subject" class="inp" maxlength="200" required />
                </div>
            </div>

            <div class="field">
                <label class="lab" for="Department">Departman <span class="text-danger">*</span></label>
                <input type="text" id="Department" name="Department" value="@Model.Department" class="inp" maxlength="100" required />
            </div>

            <div class="field">
                <label class="lab" for="editor-container">Detaylı içerik <span class="text-danger">*</span></label>
                <div class="tamim-quill">
                    @* Content QuillContentSanitizer ile save-time sanitize edildi (BlockService) *@
                    <div id="editor-container" class="tamim-quill__editor">@Html.Raw(Sanitizer.Sanitize(Model.Content))</div>
                </div>
                <textarea id="Content" name="Content" hidden>@Model.Content</textarea>
            </div>

            <div class="field tamim-urgent-toggle">
                <input type="checkbox" id="IsUrgent" name="IsUrgent" value="true" @(Model.IsUrgent ? "checked" : "") class="checkbox checkbox-lg" />
                <label for="IsUrgent" class="lab">
                    <i class="fas fa-bolt" aria-hidden="true"></i>
                    IsUrgent — kırmızı vurgu, AI özette başa al
                </label>
            </div>
        </div>
    </div>

    @* Yeni dosya ekleme — kayıt ile birlikte upload *@
    <div class="form-section-card wide">
        <div class="form-section-head">
            <h2 class="form-section-head__title">
                <i class="fas fa-paperclip icon-mr" aria-hidden="true"></i>
                Yeni Dosya Ekle
                <span class="form-section-head__inline-note">(opsiyonel — birden fazla seçebilirsin)</span>
            </h2>
            <div class="form-section-head__sub-tight">PDF, DOCX, XLSX, JPG, PNG, TXT — max 10 MB her dosya</div>
        </div>
        <div class="form-section-body">
            <div class="upload-zone">
                <i class="fas fa-cloud-arrow-up upload-icon" aria-hidden="true"></i>
                <input type="file" name="files" multiple
                       accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png,.txt"
                       class="inp upload-input" />
            </div>
        </div>
    </div>

    <div class="action-row wide">
        <a href="@Url.Action("Details", new { id = Model.Id })" class="btn ghost">
            <i class="fas fa-arrow-left icon-xs" aria-hidden="true"></i>
            Geri Dön
        </a>
        <button type="submit" class="btn primary">
            <i class="fas fa-check icon-xs" aria-hidden="true"></i>
            Değişiklikleri Kaydet
        </button>
    </div>
</form>

@* Plan 17 Faz E — Mevcut dosyalar listesi *@
<div class="form-section-card wide">
    <div class="form-section-head">
        <h2 class="form-section-head__title">
            <i class="fas fa-paperclip icon-mr" aria-hidden="true"></i>
            Ekli Dosyalar
            <span class="mono form-section-head__inline-note">@files.Count dosya</span>
        </h2>
        <div class="form-section-head__sub-tight">PDF, DOCX, XLSX, JPG, PNG, TXT — max 10 MB</div>
    </div>

    <div class="form-section-body">
        @if (files.Any())
        {
            <div class="attached-file-list">
                @foreach (var d in files)
                {
                    var extCls = ExtClass(d.Extension);
                    <div class="attached-file">
                        <div class="attached-file__main">
                            <span class="attached-file__ext ext @extCls">@d.Extension</span>
                            <a href="@Url.Action("DownloadFile", new { id = d.Id })" class="attached-file__name">@d.FileName</a>
                            <span class="attached-file__size">@FormatBoyut(d.FileSize)</span>
                        </div>
                        <form method="post" action="@Url.Action("DeleteFile", new { id = d.Id })" class="inline-form"
                              onsubmit="return confirm('Dosya silinsin mi?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn sm danger">
                                <i class="fas fa-trash icon-xs" aria-hidden="true"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }

        @if (!files.Any())
        {
            <div class="attached-file-list-empty">
                Henüz dosya yok. Üstteki "Yeni Dosya Ekle" alanından dosya seçip "Değişiklikleri Kaydet"e bas.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        (function () {
            const editorEl = document.getElementById('editor-container');
            const hiddenEl = document.getElementById('Content');
            if (!editorEl || !hiddenEl || typeof Quill === 'undefined') return;
            const quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                        ['link'],
                        ['clean']
                    ]
                },
                placeholder: 'Tamimin tam metnini buraya yaz...'
            });
            const form = document.getElementById('blok-form');
            if (form) {
                form.addEventListener('submit', function () {
                    hiddenEl.value = quill.root.innerHTML;
                });
            }
        })();
    </script>
}
