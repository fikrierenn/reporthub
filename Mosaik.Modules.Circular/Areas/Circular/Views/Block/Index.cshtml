@using Mosaik.Modules.Circular.Models
@using System.Globalization
@model List<DailyBlock>
@{
    var isAdminView = (ViewBag.IsAdminView as bool?) ?? false;
    ViewData["Title"] = isAdminView ? "Tüm Bloklar" : "Bloklarım";
    ViewData["PageTitle"] = ViewData["Title"];
    var bekleyen = ViewBag.Bekleyen as bool?;
    var blockTypeMap = ViewBag.BlockTypeMap as Dictionary<int, string> ?? new();
    var tr = new CultureInfo("tr-TR");

    var pendingCount = Model.Count(b => !b.CircularId.HasValue);
    var publishedCount = Model.Count - pendingCount;

    string TipKey(string? label) => (label ?? "").ToLowerInvariant() switch
    {
        "karar" => "type-karar",
        "uyarı" or "uyari" => "type-uyari",
        "bilgi" => "type-bilgi",
        "duyuru" => "type-duyuru",
        _ => ""
    };

    string FilterClass(bool? mode) => bekleyen == mode ? "primary" : "ghost";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index", "Circular")">Tamim</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">@ViewData["Title"]</span>
    </nav>
}

@section TopActions {
    <a href="@Url.Action("Create")" class="btn primary">
        <i class="fas fa-plus text-[10px]"></i>
        Yeni Block
    </a>
    <a href="#" class="icon-btn" title="Yardım">
        <i class="fas fa-circle-question"></i>
    </a>
}

<div class="hero">
    <h1>@ViewData["Title"]</h1>
    <div class="sub">
        <span class="mono">@Model.Count blok</span>
        @if (isAdminView)
        {
            <span class="pill"><span class="dot"></span>Admin görünümü — tüm kullanıcılar</span>
        }
        else
        {
            <span class="pill"><span class="dot"></span>17:00'de bugünün blokları otomatik tamime alınır</span>
        }
    </div>
</div>

@await Html.PartialAsync("_CircularSubnav")

@if (TempData["Message"] != null)
{
    var t = TempData["MessageType"]?.ToString();
    var alertCls = t == "success" ? "alert success" : "alert error";
    var alertIcon = t == "success" ? "fa-check-circle" : "fa-exclamation-circle";
    <div class="@alertCls" role="alert">
        <i class="fas @alertIcon"></i>
        @TempData["Message"]
    </div>
}

<div x-data="{ q: '' }">

<div class="filter-bar with-toggle">
    <div class="fb-search-grow">
        <span class="fb-icon">
            <i class="fas fa-magnifying-glass"></i>
        </span>
        <input type="text" x-model="q"
               class="inp"
               placeholder="Blok no, konu, departman ara..." />
    </div>
    <div class="filter-bar__actions">
        <a href="@Url.Action("Index")" class="btn @FilterClass(null)">
            Tümü <span class="mono btn-count">@Model.Count</span>
        </a>
        <a href="@Url.Action("Index", new { bekleyen = true })" class="btn @FilterClass(true)">
            <i class="fas fa-hourglass-half text-[10px]"></i>
            Bekleyen <span class="mono btn-count">@pendingCount</span>
        </a>
        <a href="@Url.Action("Index", new { bekleyen = false })" class="btn @FilterClass(false)">
            <i class="fas fa-check text-[10px]"></i>
            Yayında <span class="mono btn-count">@publishedCount</span>
        </a>
        <button type="button" class="btn ghost" @@click="q = ''" x-show="q" x-cloak>
            <i class="fas fa-xmark text-[10px]"></i>
            Temizle
        </button>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-inbox empty-state__icon"></i>
        <h3>Henüz blok yok</h3>
        <p>İlk bloğu yazmak için <a href="@Url.Action("Create")" class="alert-link">yeni blok ekle</a>.</p>
    </div>
}
else
{
    <div class="table-card">
        <table class="dt">
            <thead>
                <tr>
                    <th>Blok No</th>
                    <th>Subject</th>
                    <th>Tür</th>
                    @if (isAdminView)
                    {
                        <th>Yazan</th>
                    }
                    <th>Departman</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th class="col-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    blockTypeMap.TryGetValue(b.BlockTypeId, out var turLabel);
                    var tipCls = TipKey(turLabel);
                    var statusOk = b.CircularId.HasValue;
                    var searchHay = $"{b.BlockNumber} {b.Subject} {b.Department} {turLabel}".ToLowerInvariant();
                    <tr data-search="@searchHay"
                        x-show="!q || $el.dataset.search.includes(q.toLowerCase())"
                        x-cloak>
                        <td><span class="mono">@b.BlockNumber</span></td>
                        <td>
                            <a href="@Url.Action("Details", new { id = b.Id })" class="subject-link">
                                @b.Subject
                            </a>
                            @if (b.IsUrgent)
                            {
                                <span class="urgent-icon" title="IsUrgent">
                                    <i class="fas fa-bolt text-[10px]"></i>
                                </span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(turLabel))
                            {
                                <span class="type-chip @tipCls">@turLabel</span>
                            }
                        </td>
                        @if (isAdminView)
                        {
                            <td class="cell-muted">#@b.CreatedById</td>
                        }
                        <td class="cell-muted">@b.Department</td>
                        <td><span class="ago">@b.BlockDate.ToString("dd.MM.yyyy")</span></td>
                        <td>
                            <span class="status @(statusOk ? "ok" : "warn")">
                                @(statusOk ? "Yayında" : "Bekleyen")
                            </span>
                        </td>
                        <td class="cell-right">
                            <div class="row-actions">
                                <a href="@Url.Action("Details", new { id = b.Id })" class="btn ghost sm">
                                    <i class="fas fa-eye text-[9px]"></i>
                                    Görüntüle
                                </a>
                                @if (!statusOk)
                                {
                                    <a href="@Url.Action("Edit", new { id = b.Id })" class="btn ghost sm">
                                        <i class="fas fa-pen text-[9px]"></i>
                                        Düzenle
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@{
    var footer = $"{Model.Count} blok · {pendingCount} bekleyen · {publishedCount} yayında";
}

</div>

@await Html.PartialAsync("_FooterHint", (string?)footer)
