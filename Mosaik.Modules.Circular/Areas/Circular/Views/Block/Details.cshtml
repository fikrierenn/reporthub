@using Mosaik.Modules.Circular.Models
@using System.Globalization
@model DailyBlock
@{
    ViewData["Title"] = Model.Subject;
    var blockTypeMap = ViewBag.BlockTypeMap as Dictionary<int, string> ?? new();
    blockTypeMap.TryGetValue(Model.BlockTypeId, out var turLabel);
    var tr = new CultureInfo("tr-TR");
    var statusOk = Model.CircularId.HasValue;
    var files = ViewBag.Files as List<BlockFile> ?? new();

    string FormatBoyut(long b) =>
        b < 1024 ? $"{b} B"
        : b < 1024 * 1024 ? $"{b / 1024} KB"
        : $"{b / 1024.0 / 1024:0.#} MB";

    string TipKey(string? label) => (label ?? "").ToLowerInvariant() switch
    {
        "karar" => "type-karar",
        "uyarı" or "uyari" => "type-uyari",
        "bilgi" => "type-bilgi",
        "duyuru" => "type-duyuru",
        _ => ""
    };
    var tipCls = TipKey(turLabel);
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index", "Circular")">Tamim</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index")">Bloklarım</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">@Model.BlockNumber</span>
    </nav>
}

@section TopActions {
    @if (!statusOk)
    {
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn">
            <i class="fas fa-pen" aria-hidden="true"></i> Düzenle
        </a>
        <form method="post" action="@Url.Action("Delete")" style="display:inline;"
              onsubmit="return confirm('Bloğu silmek istediğine emin misin?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn" style="color:var(--accent-ink);">
                <i class="fas fa-trash" aria-hidden="true"></i> Sil
            </button>
        </form>
    }
    <a href="@Url.Action("Index")" class="btn">
        <i class="fas fa-arrow-left" aria-hidden="true"></i> Liste
    </a>
}

<article class="tamim-envelope @(Model.IsUrgent ? "" : "")">
    <div class="te-no">
        @Model.BlockNumber
        @if (Model.IsUrgent)
        {
            <span style="margin-left:6px; color:var(--accent);">· ACİL</span>
        }
        @if (!string.IsNullOrEmpty(turLabel))
        {
            <span style="margin-left:6px; color:var(--ink-3);">· @turLabel.ToUpper(tr)</span>
        }
    </div>
    <h1>@Model.Subject</h1>
    <div class="te-meta">
        <span><i class="fas fa-calendar" aria-hidden="true"></i>@Model.BlockDate.ToString("dd MMMM yyyy", tr)</span>
        <span><i class="fas fa-building" aria-hidden="true"></i>@Model.Department</span>
        @if (statusOk)
        {
            <span class="status ok"><i class="fas fa-check" aria-hidden="true"></i> Yayında</span>
        }
        else
        {
            <span class="status warn"><i class="fas fa-clock" aria-hidden="true"></i> 17:00'de yayına alınacak</span>
        }
        @if (!string.IsNullOrEmpty(turLabel))
        {
            <span class="type-chip @tipCls">@turLabel</span>
        }
    </div>
</article>

<div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:24px 28px; margin-bottom:18px;">
    <div style="font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-3); margin-bottom:10px;">
        Detaylı içerik
    </div>
    @* Content QuillContentSanitizer ile save-time sanitize edildi (BlockService) *@
    <div style="font-size:14px; color:var(--ink-0); line-height:1.7;">
        @Html.Raw(Model.Content)
    </div>

    @if (files.Any())
    {
        <div style="margin-top:20px; padding-top:16px; border-top:1px solid var(--line);">
            <div style="font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-3); margin-bottom:10px;">
                Ekli Files (@files.Count)
            </div>
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
                @foreach (var d in files)
                {
                    <a href="@Url.Action("DownloadFile", new { id = d.Id })" class="file-pill"
                       style="display:inline-flex; align-items:center; gap:6px; padding:6px 10px; background:var(--canvas); border:1px solid var(--line); border-radius:7px; text-decoration:none; color:var(--ink-1); font-size:12.5px;">
                        <span style="font-size:10px; font-weight:700; padding:2px 5px; border-radius:3px; background:var(--accent); color:#fff; text-transform:uppercase;">@d.Extension</span>
                        <span>@d.FileName</span>
                        <span style="color:var(--ink-3); font-size:11px;">· @FormatBoyut(d.FileSize)</span>
                    </a>
                }
            </div>
        </div>
    }
</div>

@if (statusOk)
{
    <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:14px 18px; color:var(--ink-3); font-size:13px;">
        <i class="fas fa-info-circle" aria-hidden="true"></i>
        Bu blok yayınlanmış bir tamime dahil edildi. Düzenleme/silme kapalı.
    </div>
}
