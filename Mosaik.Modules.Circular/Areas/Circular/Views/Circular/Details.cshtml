@using Mosaik.Modules.Circular.Models
@using System.Globalization
@model Circular
@{
    ViewData["Title"] = Model.Title;
    var blocks = ViewBag.Blocks as List<DailyBlock> ?? new();
    var blockTypeMap = ViewBag.BlockTypeMap as Dictionary<int, string> ?? new();
    var fileMap = ViewBag.FileMap as Dictionary<int, List<BlockFile>> ?? new();
    var tr = new CultureInfo("tr-TR");
    var urgentCount = blocks.Count(b => b.IsUrgent);
    var totalFiles = fileMap.Values.Sum(l => l.Count);

    string TipKey(string? label) => (label ?? "").ToLowerInvariant() switch
    {
        "karar" => "type-karar",
        "uyarı" or "uyari" => "type-uyari",
        "bilgi" => "type-bilgi",
        "duyuru" => "type-duyuru",
        _ => ""
    };

    string FormatBoyut(long b) =>
        b < 1024 ? $"{b} B"
        : b < 1024 * 1024 ? $"{b / 1024} KB"
        : $"{b / 1024.0 / 1024:0.#} MB";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index")">Tamimler</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">@Model.CircularNumber</span>
    </nav>
}

@section TopActions {
    <a href="@Url.Action("Print", new { id = Model.Id })" class="btn" target="_blank" title="Yazdırma görünümü (browser ile PDF kaydet)">
        <i class="fas fa-print text-[10px]"></i>
        Yazdır / PDF
    </a>
    <a href="@Url.Action("ExportXlsx", new { id = Model.Id })" class="btn">
        <i class="fas fa-file-excel text-[10px]"></i>
        Excel
    </a>
    @if (User.IsInRole("admin"))
    {
        <a href="@Url.Action("ReadingReport", "Admin", new { id = Model.Id })" class="btn">
            <i class="fas fa-eye text-[10px]"></i>
            Okuma Raporu
        </a>
    }
    <a href="@Url.Action("Index")" class="btn">
        <i class="fas fa-arrow-left" aria-hidden="true"></i> Liste
    </a>
}

@if (TempData["Message"] != null)
{
    @await Html.PartialAsync("_AlertMessage", (TempData["MessageType"]?.ToString() ?? "info", TempData["Message"]?.ToString() ?? ""))
}

@* Plan 36 — bu tamim üzerindeki onay akışları *@
@await Html.PartialAsync("_EntityWorkflowList", (IReadOnlyList<Mosaik.Core.Workflow.EntityWorkflowSummary>)(ViewBag.Workflows ?? new List<Mosaik.Core.Workflow.EntityWorkflowSummary>()))

<article class="tamim-envelope">
    <div class="te-no">@Model.CircularNumber · GÜNLÜK TAMİM</div>
    <h1>@Model.Title</h1>
    <div class="te-meta">
        <span><i class="fas fa-calendar" aria-hidden="true"></i>Circular tarihi: @Model.CircularDate.ToString("dd MMMM yyyy dddd", tr)</span>
        <span><i class="fas fa-paper-plane" aria-hidden="true"></i>Yayın: @Model.PublishedAt.ToString("dd MMM HH:mm", tr)</span>
        <span><i class="fas fa-layer-group" aria-hidden="true"></i>@blocks.Count blok</span>
        @if (totalFiles > 0)
        {
            <span><i class="fas fa-paperclip" aria-hidden="true"></i>@totalFiles dosya</span>
        }
        @if (urgentCount > 0)
        {
            <span class="te-acil"><i class="fas fa-bolt" aria-hidden="true"></i>@urgentCount acil</span>
        }
    </div>
</article>

@* AI özet — Plan 17 Faz F. Üretilmişse JSON'dan parse edip listele, yoksa placeholder. *@
@{
    List<string>? summaryItems = null;
    List<string>? topicItems = null;
    if (!string.IsNullOrWhiteSpace(Model.AiSummaryJson))
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(Model.AiSummaryJson);
            var root = doc.RootElement;
            if (root.TryGetProperty("summary", out var sArr) && sArr.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                summaryItems = sArr.EnumerateArray().Select(e => e.GetString() ?? "").Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
            }
            if (root.TryGetProperty("topics", out var tArr) && tArr.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                topicItems = tArr.EnumerateArray().Select(e => e.GetString() ?? "").Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
            }
        }
        catch { /* Bozuk JSON ise placeholder göster */ }
    }
    var hasSummary = summaryItems != null && summaryItems.Any();
}

<div class="ai-summary-card" aria-label="Yapay zeka özet alanı">
    <div class="ai-head">
        <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
        <span>Yapay zekâ özeti</span>
        @if (hasSummary)
        {
            <span class="ai-badge ready">Hazır</span>
            @if (Model.AiSummaryAt.HasValue)
            {
                <span class="ai-time">@Model.AiSummaryAt.Value.ToLocalTime().ToString("dd MMM HH:mm", tr)</span>
            }
        }
        else
        {
            <span class="ai-badge">Beklemede</span>
        }

        @if (User.IsInRole("admin"))
        {
            <form method="post" action="@Url.Action("RegenerateSummary", "Admin", new { id = Model.Id })" class="ai-regen-form"
                  onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerHTML='<i class=\'fas fa-spinner fa-spin text-[9px]\'></i> Üretiliyor...';">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn ghost sm" title="AI özetini yeniden üret">
                    <i class="fas fa-rotate text-[9px]"></i>
                    Yeniden Üret
                </button>
            </form>
        }
    </div>

    @if (hasSummary)
    {
        <ul class="ai-summary-list">
            @foreach (var item in summaryItems!)
            {
                <li>@item</li>
            }
        </ul>
        @if (topicItems != null && topicItems.Any())
        {
            <div class="ai-topics-row">
                <span class="ai-topics-label">Konular:</span>
                @foreach (var topic in topicItems)
                {
                    <span class="type-chip ai-topic-chip">@topic</span>
                }
            </div>
        }
    }
    else
    {
        <p class="ai-empty-text">
            AI özet henüz üretilmedi.
            @if (User.IsInRole("admin"))
            {
                <text>Üstteki "Yeniden Üret" butonu ile manuel tetikleyebilirsin (Yapay Zeka ayarları aktif olmalı).</text>
            }
        </p>
    }
</div>

<div class="section-title">
    <h2>İçerik blokları</h2>
    <span class="st-count">@blocks.Count blok</span>
</div>

@if (!blocks.Any())
{
    <div class="empty-state">
        <p>Bu tamim'e bağlı blok bulunamadı.</p>
    </div>
}
else
{
    <div class="list-stack">
        @foreach (var b in blocks.OrderByDescending(x => x.IsUrgent).ThenBy(x => x.Id))
        {
            blockTypeMap.TryGetValue(b.BlockTypeId, out var turLabel);
            var tipCls = TipKey(turLabel);
            <article class="list-item @(b.IsUrgent ? "urgent" : "")">
                <div class="list-item__head">
                    <span class="list-item__no">@b.BlockNumber</span>
                    <div class="list-item__tip-row">
                        @if (b.IsUrgent)
                        {
                            <span class="pill urgent"><i class="fas fa-bolt" aria-hidden="true"></i> IsUrgent</span>
                        }
                        @if (!string.IsNullOrEmpty(turLabel))
                        {
                            <span class="type-chip @tipCls">@turLabel</span>
                        }
                    </div>
                </div>
                <h4>@b.Subject</h4>
                @* Content QuillContentSanitizer ile save-time sanitize edildi (BlockService) *@
                <div class="list-item__body">@Html.Raw(b.Content)</div>
                @if (fileMap.TryGetValue(b.Id, out var blockFiles) && blockFiles.Any())
                {
                    <div class="list-item__files">
                        @foreach (var d in blockFiles)
                        {
                            <a href="@Url.Action("DownloadFile", "Block", new { id = d.Id })" class="file-chip">
                                <span class="file-chip__ext">@d.Extension</span>
                                <span>@d.FileName</span>
                                <span class="file-chip__size">· @FormatBoyut(d.FileSize)</span>
                            </a>
                        }
                    </div>
                }
                <div class="list-item__meta">
                    <span><i class="fas fa-building" aria-hidden="true"></i>@b.Department</span>
                    <span><i class="fas fa-calendar" aria-hidden="true"></i>@b.BlockDate.ToString("dd MMM", tr)</span>
                </div>
            </article>
        }
    </div>
}

<div class="read-receipt">
    <div class="rr-head">
        <h3><i class="fas fa-eye" aria-hidden="true"></i>Okuma kaydı</h3>
    </div>
    <div class="rr-body">
        <div class="rr-info">
            Bu tamim sayfasını ziyaret ettiniz, okuma loguna otomatik kaydedildi.
        </div>
        <span class="ack-status" aria-label="Okuma kaydedildi">
            <i class="fas fa-check-circle" aria-hidden="true"></i> Kayıt alındı
        </span>
    </div>
</div>
