@using Mosaik.Modules.Circular.Models
@using System.Globalization
@model List<Circular>
@{
    ViewData["Title"] = "Tamimler";
    ViewData["PageTitle"] = "Tamimler";
    var tr = new CultureInfo("tr-TR");
    var totalCount = Model.Count;
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Tamimler</span>
    </nav>
}

@section TopActions {
    @if (User.IsInRole("admin"))
    {
        <form method="post" action="@Url.Action("CompileNow", "Admin")" class="inline-form"
              onsubmit="return confirm('Bugünün pending bloklarını şimdi derleyip tamim olarak yayınla?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn primary" title="Cron'u beklemeden manuel derleme">
                <i class="fas fa-bolt text-[10px]" aria-hidden="true"></i>
                Şimdi Derle
            </button>
        </form>
    }
    <a href="#" class="icon-btn" title="Yardım">
        <i class="fas fa-circle-question" aria-hidden="true"></i>
    </a>
}

<div class="hero">
    <h1>Tamimler</h1>
    <div class="sub">
        <span class="mono">@totalCount tamim · son 30 gün</span>
        <span class="pill"><span class="dot"></span>Bugünkü tamim 17:00'de yayınlanır</span>
    </div>
</div>

@await Html.PartialAsync("_CircularSubnav")

<div x-data="{ q: '' }">

<form method="get" class="filter-bar with-toggle">
    <div class="fb-search-grow">
        <span class="fb-icon">
            <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
        </span>
        <input type="text" id="tamimSearch" name="q" x-model="q"
               class="inp"
               placeholder="Tamim no, başlık veya tarih..." />
    </div>
    <div class="filter-bar__actions">
        <button type="submit" class="btn primary" title="URL'ye yansıt (paylaşılabilir link)">
            <i class="fas fa-filter text-[10px]" aria-hidden="true"></i>
            Filtrele
        </button>
        <button type="button" class="btn ghost" @@click="q = ''" x-show="q" x-cloak>
            <i class="fas fa-xmark text-[10px]" aria-hidden="true"></i>
            Temizle
        </button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="empty-state paper-dashed">
        <i class="fas fa-folder-open empty-state__icon" aria-hidden="true"></i>
        <h3>Son 30 günde yayınlanmış tamim yok</h3>
        <p>Sistem her gün <strong>17:00</strong>'de o güne ait blokları otomatik tamim olarak yayınlar.</p>
    </div>
}
else
{
    <div class="quick-grid">
        @foreach (var t in Model)
        {
            var dateStr = t.CircularDate.ToString("dd MMM yyyy", tr);
            var hour = t.PublishedAt.ToString("HH:mm");
            var searchHay = $"{t.CircularNumber} {t.Title} {dateStr}".ToLowerInvariant();
            <div class="qcard has-overlay"
                 data-search="@searchHay"
                 x-show="!q || $el.dataset.search.includes(q.toLowerCase())"
                 x-cloak>
                <div class="row1">
                    <span class="type-chip type-dash">Tamim</span>
                    <span class="qcard__num">@t.CircularNumber</span>
                </div>
                <a href="@Url.Action("Details", new { id = t.Id })" class="qcard__link">
                    <h3>@t.Title</h3>
                    <div class="sub">
                        <i class="fas fa-calendar qcard__date-icon" aria-hidden="true"></i>
                        @dateStr
                    </div>
                    <div class="meta">
                        <span class="ago qcard__ago-mono">
                            <i class="fas fa-clock qcard__time-icon" aria-hidden="true"></i>
                            @hour
                        </span>
                        <span class="run">Aç <i class="fas fa-arrow-right text-[10px]" aria-hidden="true"></i></span>
                    </div>
                </a>
            </div>
        }
    </div>
}

</div>

@{
    var footer = $"{totalCount} tamim · son 30 gün";
}
@await Html.PartialAsync("_FooterHint", (string?)footer)
