@using Mosaik.Modules.Circular.Areas.Circular.Controllers
@using System.Globalization
@model CircularDashboardViewModel
@{
    var tr = new CultureInfo("tr-TR");
    ViewData["Title"] = "Tamim Dashboard";
    ViewData["PageTitle"] = "Tamim Dashboard";
    var maxBlock = Model.DepartmentParticipation.Any() ? Model.DepartmentParticipation.Max(d => d.BlockCount) : 1;
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index", "Circular")">Tamim</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Dashboard</span>
    </nav>
}

@section TopActions {
    <a href="@Url.Action("Index", "Circular")" class="btn">
        <i class="fas fa-arrow-left text-[10px]" aria-hidden="true"></i>
        Liste
    </a>
}

<div class="hero">
    <h1>Tamim Dashboard</h1>
    <div class="sub">
        <span>Son 30 gün — okuma oranları, departman katılımı, eksik giriş</span>
    </div>
</div>

<div class="kpi-grid mb-18">
    <div class="kpi-card k-green">
        <div class="head">
            <span class="label">SeenRate (30g)</span>
            <div class="ico"><i class="fas fa-eye" aria-hidden="true"></i></div>
        </div>
        <div class="value">%@Model.SeenRate</div>
        <div class="delta muted">@Model.DistinctReaderCount / @Model.ActiveUserCount kullanıcı</div>
    </div>
    <div class="kpi-card k-ink">
        <div class="head">
            <span class="label">Yayınlanan</span>
            <div class="ico"><i class="fas fa-paper-plane" aria-hidden="true"></i></div>
        </div>
        <div class="value">@Model.PublishedCircularCount</div>
        <div class="delta muted">Son 30 gün</div>
    </div>
    <div class="kpi-card k-warn">
        <div class="head">
            <span class="label">Eksik Departman</span>
            <div class="ico"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></div>
        </div>
        <div class="value">@Model.MissingDepartmentsToday.Count</div>
        <div class="delta @(Model.MissingDepartmentsToday.Any() ? "down" : "")">
            @(Model.MissingDepartmentsToday.Any() ? "Bugün giriş yapmadı" : "Tüm aktif departmanlar girdi")
        </div>
    </div>
    <div class="kpi-card k-red">
        <div class="head">
            <span class="label">Aktif Kullanıcı</span>
            <div class="ico"><i class="fas fa-users" aria-hidden="true"></i></div>
        </div>
        <div class="value">@Model.ActiveUserCount</div>
    </div>
</div>

<div class="section-title">
    <h2>Departman Katılımı (son 30 gün)</h2>
    <span class="count-suffix">@Model.DepartmentParticipation.Count departman</span>
</div>

@if (!Model.DepartmentParticipation.Any())
{
    <div class="dashed-card">
        <i class="fas fa-chart-bar dc-icon" aria-hidden="true"></i>
        <h3>Son 30 günde blok girişi yok</h3>
    </div>
}
else
{
    <div class="paper-card">
        <table class="dt">
            <thead>
                <tr>
                    <th scope="col">Departman</th>
                    <th scope="col" class="w-100">Blok Sayısı</th>
                    <th scope="col" class="w-100">Aktif Gün</th>
                    <th scope="col" class="w-40p">Trend</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.DepartmentParticipation)
                {
                    var pct = (d.BlockCount * 100 / maxBlock);
                    <tr>
                        <td><span class="row-name">@d.Department</span></td>
                        <td><span class="mono">@d.BlockCount</span></td>
                        <td><span class="mono">@d.DayCount / 30</span></td>
                        <td>
                            <div class="trend-bar"><i style="--w: @pct%"></i></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.MissingDepartmentsToday.Any())
{
    <div class="section-title">
        <h2>Bugün Giriş Yapmamış Departmanlar</h2>
    </div>
    <div class="paper-card with-padding">
        <div class="chip-row">
            @foreach (var dept in Model.MissingDepartmentsToday)
            {
                <span class="type-chip type-warn">
                    <i class="fas fa-clock text-[9px] chip-icon" aria-hidden="true"></i>
                    @dept
                </span>
            }
        </div>
        <div class="hint-row">
            <i class="fas fa-info-circle" aria-hidden="true"></i>
            Son 7 günde girişi olan ama bugün hiç blok yazmamış departmanlar.
        </div>
    </div>
}

@if (Model.Trend.Any())
{
    <div class="section-title">
        <h2>Günlük Blok Trendi (son 30 gün)</h2>
    </div>
    <div class="mini-chart paper-wrap">
        <canvas id="trendChart" height="80"></canvas>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                const ctx = document.getElementById('trendChart');
                if (!ctx) return;
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.Date.ToString("dd MMM", tr)))),
                        datasets: [{
                            label: 'Blok',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.BlockCount))),
                            borderColor: '#dc2626',
                            backgroundColor: 'rgba(220,38,38,.10)',
                            tension: 0.25,
                            fill: true,
                            pointRadius: 3,
                            pointBackgroundColor: '#dc2626'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } },
                            x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 10 } }
                        }
                    }
                });
            })();
        </script>
    }
}
