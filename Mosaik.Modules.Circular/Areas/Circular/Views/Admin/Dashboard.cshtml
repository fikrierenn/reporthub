@using Mosaik.Modules.Circular.Areas.Circular.Controllers
@using System.Globalization
@model CircularDashboardViewModel
@{
    var tr = new CultureInfo("tr-TR");
    ViewData["Title"] = "Tamim Dashboard";
    ViewData["PageTitle"] = "Tamim Dashboard";
    var maxBlock = Model.DepartmentParticipation.Any() ? Model.DepartmentParticipation.Max(d => d.BlockCount) : 1;
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index", "Circular")">Tamim</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Dashboard</span>
    </nav>
}

@section TopActions {
    <a href="@Url.Action("Index", "Circular")" class="btn">
        <i class="fas fa-arrow-left text-[10px]"></i>
        Liste
    </a>
}

<div class="hero">
    <h1>Tamim Dashboard</h1>
    <div class="sub">
        <span>Son 30 gün — okuma oranları, departman katılımı, eksik giriş</span>
    </div>
</div>

<div class="kpi-grid" style="margin-bottom:18px;">
    <div class="kpi-card k-green">
        <div class="head">
            <span class="label">SeenRate (30g)</span>
            <div class="ico"><i class="fas fa-eye"></i></div>
        </div>
        <div class="value">%@Model.SeenRate</div>
        <div class="delta" style="color:var(--ink-3);">@Model.DistinctReaderCount / @Model.ActiveUserCount kullanıcı</div>
    </div>
    <div class="kpi-card k-ink">
        <div class="head">
            <span class="label">Yayınlanan</span>
            <div class="ico"><i class="fas fa-paper-plane"></i></div>
        </div>
        <div class="value">@Model.PublishedCircularCount</div>
        <div class="delta" style="color:var(--ink-3);">Son 30 gün</div>
    </div>
    <div class="kpi-card k-warn">
        <div class="head">
            <span class="label">Eksik Departman</span>
            <div class="ico"><i class="fas fa-triangle-exclamation"></i></div>
        </div>
        <div class="value">@Model.MissingDepartmentsToday.Count</div>
        <div class="delta @(Model.MissingDepartmentsToday.Any() ? "down" : "")">
            @(Model.MissingDepartmentsToday.Any() ? "Bugün giriş yapmadı" : "Tüm aktif departmanlar girdi")
        </div>
    </div>
    <div class="kpi-card k-red">
        <div class="head">
            <span class="label">Aktif Kullanıcı</span>
            <div class="ico"><i class="fas fa-users"></i></div>
        </div>
        <div class="value">@Model.ActiveUserCount</div>
    </div>
</div>

<div class="section-title">
    <h2>Departman Katılımı (son 30 gün)</h2>
    <span style="font-size:12px; color:var(--ink-3);">@Model.DepartmentParticipation.Count departman</span>
</div>

@if (!Model.DepartmentParticipation.Any())
{
    <div style="background:var(--paper); border:1px dashed var(--line); border-radius:10px; padding:48px 24px; text-align:center; color:var(--ink-3);">
        <i class="fas fa-chart-bar" style="font-size:48px; opacity:.4; margin-bottom:12px;"></i>
        <h3 style="font-size:14px; font-weight:600; color:var(--ink-1); margin:0 0 4px;">Son 30 günde blok girişi yok</h3>
    </div>
}
else
{
    <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; overflow:hidden; margin-bottom:18px;">
        <table class="dt">
            <thead>
                <tr>
                    <th>Departman</th>
                    <th style="width:100px;">Blok Sayısı</th>
                    <th style="width:100px;">Aktif Gün</th>
                    <th style="width:40%;">Trend</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.DepartmentParticipation)
                {
                    var pct = (d.BlockCount * 100 / maxBlock);
                    <tr>
                        <td><span style="font-weight:500;">@d.Department</span></td>
                        <td><span class="mono">@d.BlockCount</span></td>
                        <td><span class="mono">@d.DayCount / 30</span></td>
                        <td>
                            <div style="background:var(--canvas); height:8px; border-radius:4px; overflow:hidden;">
                                <div style="width:@(pct)%; height:100%; background:var(--accent);"></div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.MissingDepartmentsToday.Any())
{
    <div class="section-title">
        <h2>Bugün Giriş Yapmamış Departmanlar</h2>
    </div>
    <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:14px 18px; margin-bottom:18px;">
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
            @foreach (var dept in Model.MissingDepartmentsToday)
            {
                <span class="type-chip" style="background:rgba(245,158,11,.15); color:var(--warn-ink-soft); padding:4px 10px;">
                    <i class="fas fa-clock text-[9px]" style="margin-right:4px;"></i>
                    @dept
                </span>
            }
        </div>
        <div style="font-size:11.5px; color:var(--ink-3); margin-top:10px;">
            <i class="fas fa-info-circle"></i>
            Son 7 günde girişi olan ama bugün hiç blok yazmamış departmanlar.
        </div>
    </div>
}

@if (Model.Trend.Any())
{
    <div class="section-title">
        <h2>Günlük Blok Trendi (son 30 gün)</h2>
    </div>
    <div class="mini-chart" style="background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:14px 18px;">
        <canvas id="trendChart" height="80"></canvas>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                const ctx = document.getElementById('trendChart');
                if (!ctx) return;
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.Date.ToString("dd MMM", tr)))),
                        datasets: [{
                            label: 'Blok',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.BlockCount))),
                            borderColor: '#dc2626',
                            backgroundColor: 'rgba(220,38,38,.10)',
                            tension: 0.25,
                            fill: true,
                            pointRadius: 3,
                            pointBackgroundColor: '#dc2626'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } },
                            x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 10 } }
                        }
                    }
                });
            })();
        </script>
    }
}
