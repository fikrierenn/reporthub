@using Mosaik.Modules.Circular.Models
@using Mosaik.Modules.Circular.Areas.Circular.Controllers
@using System.Globalization
@model List<ReadingReportRow>
@{
    var circular = ViewBag.Circular as Circular;
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var readCount = (int)(ViewBag.ReadCount ?? 0);
    var unreadCount = totalCount - readCount;
    var seenRate = totalCount > 0 ? (readCount * 100 / totalCount) : 0;
    var tr = new CultureInfo("tr-TR");
    ViewData["Title"] = "Okuma Raporu";
    ViewData["PageTitle"] = "Okuma Raporu";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index", "Circular")">Tamimler</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Details", "Circular", new { id = circular?.Id })">@circular?.CircularNumber</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Okuma Raporu</span>
    </nav>
}

@section TopActions {
    <a href="@Url.Action("ReadingReportXlsx", "Admin", new { id = circular?.Id })" class="btn">
        <i class="fas fa-file-excel text-[10px]" aria-hidden="true"></i>
        Excel İndir
    </a>
    <a href="@Url.Action("Details", "Circular", new { id = circular?.Id })" class="btn">
        <i class="fas fa-arrow-left text-[10px]" aria-hidden="true"></i>
        Tamim Detay
    </a>
}

<div class="hero">
    <h1>Okuma Raporu</h1>
    <div class="sub">
        <span class="mono">@circular?.CircularNumber · @circular?.Title</span>
        <span class="pill"><span class="dot"></span>@totalCount aktif kullanıcı</span>
    </div>
</div>

<div class="kpi-grid mb-18">
    <div class="kpi-card k-ink">
        <div class="head">
            <span class="label">Toplam Aktif</span>
            <div class="ico"><i class="fas fa-users" aria-hidden="true"></i></div>
        </div>
        <div class="value">@totalCount</div>
    </div>
    <div class="kpi-card k-green">
        <div class="head">
            <span class="label">Okuyan</span>
            <div class="ico"><i class="fas fa-eye" aria-hidden="true"></i></div>
        </div>
        <div class="value">@readCount</div>
        <div class="delta up">%@seenRate</div>
    </div>
    <div class="kpi-card k-red">
        <div class="head">
            <span class="label">Okumayan</span>
            <div class="ico"><i class="fas fa-eye-slash" aria-hidden="true"></i></div>
        </div>
        <div class="value">@unreadCount</div>
        <div class="delta down">%@(100 - seenRate)</div>
    </div>
    <div class="kpi-card k-warn">
        <div class="head">
            <span class="label">Yayın Tarihi</span>
            <div class="ico"><i class="fas fa-paper-plane" aria-hidden="true"></i></div>
        </div>
        <div class="value value-sm">@circular?.PublishedAt.ToString("dd MMM HH:mm", tr)</div>
    </div>
</div>

<div x-data="{ q: '', f: 'all' }">

<div class="filter-bar with-toggle">
    <div class="fb-search-grow">
        <i class="fas fa-magnifying-glass fb-icon" aria-hidden="true"></i>
        <input type="text" x-model="q" class="inp" placeholder="Kullanıcı veya ad ara..." />
    </div>
    <div class="fb-toggle-group">
        <button type="button" class="btn" :class="{ 'primary': f === 'all', 'ghost': f !== 'all' }" @@click="f = 'all'">
            Tümü <span class="mono">@totalCount</span>
        </button>
        <button type="button" class="btn" :class="{ 'primary': f === 'read', 'ghost': f !== 'read' }" @@click="f = 'read'">
            <i class="fas fa-check text-[10px]" aria-hidden="true"></i>
            Okuyan <span class="mono">@readCount</span>
        </button>
        <button type="button" class="btn" :class="{ 'primary': f === 'unread', 'ghost': f !== 'unread' }" @@click="f = 'unread'">
            <i class="fas fa-clock text-[10px]" aria-hidden="true"></i>
            Okumayan <span class="mono">@unreadCount</span>
        </button>
    </div>
</div>

@if (!Model.Any())
{
    <div class="dashed-card">
        <i class="fas fa-users dc-icon" aria-hidden="true"></i>
        <h3>Aktif kullanıcı yok</h3>
    </div>
}
else
{
    <div class="paper-card">
        <table class="dt">
            <thead>
                <tr>
                    <th scope="col">Kullanıcı</th>
                    <th scope="col">Ad Soyad</th>
                    <th scope="col">E-posta</th>
                    <th scope="col">Durum</th>
                    <th scope="col">İlk Okuma</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var hay = $"{row.Username} {row.FullName} {row.Email}".ToLowerInvariant();
                    <tr data-search="@hay" data-status="@(row.HasRead ? "read" : "unread")"
                        x-show="(!q || $el.dataset.search.includes(q.toLowerCase())) &&
                                (f === 'all' || $el.dataset.status === f)" x-cloak>
                        <td><span class="mono">@row.Username</span></td>
                        <td>@row.FullName</td>
                        <td><span class="cell-muted">@(row.Email ?? "-")</span></td>
                        <td>
                            @if (row.HasRead)
                            {
                                <span class="status ok"><i class="fas fa-check" aria-hidden="true"></i> Okundu</span>
                            }
                            else
                            {
                                <span class="status err"><i class="fas fa-clock" aria-hidden="true"></i> Okunmadı</span>
                            }
                        </td>
                        <td><span class="ago">@(row.FirstReadAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

</div>

@{
    var footer = $"{readCount} / {totalCount} okudu (%{seenRate}) · {unreadCount} okumayan";
}
@await Html.PartialAsync("_FooterHint", (string?)footer)
