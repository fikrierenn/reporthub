@using Mosaik.Modules.Circular.Models
@using Mosaik.Modules.Circular.Areas.Circular.Controllers
@using System.Globalization
@model List<ReadingReportRow>
@{
    var circular = ViewBag.Circular as Circular;
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var readCount = (int)(ViewBag.ReadCount ?? 0);
    var unreadCount = totalCount - readCount;
    var seenRate = totalCount > 0 ? (readCount * 100 / totalCount) : 0;
    var tr = new CultureInfo("tr-TR");
    ViewData["Title"] = "Okuma Raporu";
    ViewData["PageTitle"] = "Okuma Raporu";
}

@section Breadcrumb {
    <nav class="crumbs" aria-label="Sayfa konumu">
        <a href="/Dashboard">BKM Kitap</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Index", "Circular")">Tamimler</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="@Url.Action("Details", "Circular", new { id = circular?.Id })">@circular?.CircularNumber</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="current" aria-current="page">Okuma Raporu</span>
    </nav>
}

@section TopActions {
    <a href="@Url.Action("ReadingReportXlsx", "Admin", new { id = circular?.Id })" class="btn">
        <i class="fas fa-file-excel text-[10px]"></i>
        Excel İndir
    </a>
    <a href="@Url.Action("Details", "Circular", new { id = circular?.Id })" class="btn">
        <i class="fas fa-arrow-left text-[10px]"></i>
        Tamim Detay
    </a>
}

<div class="hero">
    <h1>Okuma Raporu</h1>
    <div class="sub">
        <span class="mono">@circular?.CircularNumber · @circular?.Title</span>
        <span class="pill"><span class="dot"></span>@totalCount aktif kullanıcı</span>
    </div>
</div>

<div class="kpi-grid" style="margin-bottom:18px;">
    <div class="kpi-card k-ink">
        <div class="head">
            <span class="label">Toplam Aktif</span>
            <div class="ico"><i class="fas fa-users"></i></div>
        </div>
        <div class="value">@totalCount</div>
    </div>
    <div class="kpi-card k-green">
        <div class="head">
            <span class="label">Okuyan</span>
            <div class="ico"><i class="fas fa-eye"></i></div>
        </div>
        <div class="value">@readCount</div>
        <div class="delta up">%@seenRate</div>
    </div>
    <div class="kpi-card k-red">
        <div class="head">
            <span class="label">Okumayan</span>
            <div class="ico"><i class="fas fa-eye-slash"></i></div>
        </div>
        <div class="value">@unreadCount</div>
        <div class="delta down">%@(100 - seenRate)</div>
    </div>
    <div class="kpi-card k-warn">
        <div class="head">
            <span class="label">Yayın Tarihi</span>
            <div class="ico"><i class="fas fa-paper-plane"></i></div>
        </div>
        <div class="value" style="font-size:18px;">@circular?.PublishedAt.ToString("dd MMM HH:mm", tr)</div>
    </div>
</div>

<div x-data="{ q: '', f: 'all' }">

<div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:14px; display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
    <div style="flex:1; min-width:220px; position:relative;">
        <span style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:var(--ink-4); pointer-events:none;">
            <i class="fas fa-magnifying-glass" style="font-size:12px;"></i>
        </span>
        <input type="text" x-model="q" class="inp" style="padding-left:32px;" placeholder="Kullanıcı veya ad ara..." />
    </div>
    <div style="display:flex; gap:6px;">
        <button type="button" class="btn" :class="{ 'primary': f === 'all', 'ghost': f !== 'all' }" @@click="f = 'all'">
            Tümü <span class="mono" style="opacity:.65; margin-left:4px;">@totalCount</span>
        </button>
        <button type="button" class="btn" :class="{ 'primary': f === 'read', 'ghost': f !== 'read' }" @@click="f = 'read'">
            <i class="fas fa-check text-[10px]"></i>
            Okuyan <span class="mono" style="opacity:.65; margin-left:4px;">@readCount</span>
        </button>
        <button type="button" class="btn" :class="{ 'primary': f === 'unread', 'ghost': f !== 'unread' }" @@click="f = 'unread'">
            <i class="fas fa-clock text-[10px]"></i>
            Okumayan <span class="mono" style="opacity:.65; margin-left:4px;">@unreadCount</span>
        </button>
    </div>
</div>

@if (!Model.Any())
{
    <div style="background:var(--paper); border:1px dashed var(--line); border-radius:10px; padding:48px 24px; text-align:center; color:var(--ink-3);">
        <i class="fas fa-users" style="font-size:48px; opacity:.4; margin-bottom:12px;"></i>
        <h3 style="font-size:14px; font-weight:600; color:var(--ink-1); margin:0 0 4px;">Aktif kullanıcı yok</h3>
    </div>
}
else
{
    <div style="background:var(--paper); border:1px solid var(--line); border-radius:10px; overflow:hidden;">
        <table class="dt">
            <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>Ad Soyad</th>
                    <th>E-posta</th>
                    <th>Durum</th>
                    <th>İlk Okuma</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var hay = $"{row.Username} {row.FullName} {row.Email}".ToLowerInvariant();
                    <tr data-search="@hay" data-status="@(row.HasRead ? "read" : "unread")"
                        x-show="(!q || $el.dataset.search.includes(q.toLowerCase())) &&
                                (f === 'all' || $el.dataset.status === f)" x-cloak>
                        <td><span class="mono">@row.Username</span></td>
                        <td>@row.FullName</td>
                        <td style="font-size:12px; color:var(--ink-3);">@(row.Email ?? "-")</td>
                        <td>
                            @if (row.HasRead)
                            {
                                <span class="status ok"><i class="fas fa-check" aria-hidden="true"></i> Okundu</span>
                            }
                            else
                            {
                                <span class="status err"><i class="fas fa-clock" aria-hidden="true"></i> Okunmadı</span>
                            }
                        </td>
                        <td><span class="ago">@(row.FirstReadAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

</div>

@{
    var footer = $"{readCount} / {totalCount} okudu (%{seenRate}) · {unreadCount} okumayan";
}
@await Html.PartialAsync("_FooterHint", (string?)footer)
